---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LogoStrip from '../components/home/LogoStrip.astro';
import Services from '../components/home/Services.astro';
import FeaturedCaseStudies from '../components/home/FeaturedCaseStudies.astro';
import Stats from '../components/home/Stats.astro';
import Process from '../components/home/Process.astro';
import Testimonials from '../components/home/Testimonials.astro';
import InsightsPreview from '../components/home/InsightsPreview.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
---

<BaseLayout
  title="WitLabs — Digital Growth Agency for Indian Businesses"
  description="WitLabs helps Indian businesses build websites that rank on Google, run digital marketing that generates leads, and create automation systems that save time."
  canonical="https://witlabs.in"
  keywords={['digital agency India', 'website design India', 'SEO agency India', 'digital marketing India']}
  transparentHeader={true}
>
  <Hero />
  <LogoStrip />
  <Services />
  <FeaturedCaseStudies />
  <Stats />
  <Process />
  <Testimonials />
  <InsightsPreview />
  <HomeCTA />
</BaseLayout>
