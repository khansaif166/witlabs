---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSEO } from '../lib/seo';
import Hero from '../components/home/Hero.astro';
import LogoStrip from '../components/home/LogoStrip.astro';
import Services from '../components/home/Services.astro';
import PricingPreview from '../components/home/PricingPreview.astro';
import AudienceSegments from '../components/home/AudienceSegments.astro';
import ProjectOrbitShowcase from '../components/home/ProjectOrbitShowcase.astro';
import Testimonials from '../components/home/Testimonials.astro';
import InsightsPreview from '../components/home/InsightsPreview.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
---

<BaseLayout
  title={pageSEO.home.title}
  description={pageSEO.home.description}
  canonical="https://witlabs.in/"
  keywords={pageSEO.home.keywords}
  transparentHeader={true}
>
  <Hero />
  <LogoStrip />
  <Services />
  <AudienceSegments />
  <ProjectOrbitShowcase />
  <PricingPreview />
  <Testimonials />
  <InsightsPreview />
  <HomeCTA />
</BaseLayout>
