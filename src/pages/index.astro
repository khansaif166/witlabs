---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LogoStrip from '../components/home/LogoStrip.astro';
import Services from '../components/home/Services.astro';
import PricingPreview from '../components/home/PricingPreview.astro';
import AudienceSegments from '../components/home/AudienceSegments.astro';
import ProjectOrbitShowcase from '../components/home/ProjectOrbitShowcase.astro';
import Testimonials from '../components/home/Testimonials.astro';
import InsightsPreview from '../components/home/InsightsPreview.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
---

<BaseLayout
  title="WitLabs — Be Found. Be Chosen. Digital Growth Agency"
  description="Be Found. Be Chosen. WitLabs helps Indian businesses build websites that rank on Google, generate qualified inquiries, and turn online visitors into customers."
  canonical="https://witlabs.in/"
  keywords={['digital agency India', 'website design India', 'SEO agency India', 'digital marketing India']}
  transparentHeader={true}
>
  <Hero />
  <LogoStrip />
  <Services />
  <AudienceSegments />
  <ProjectOrbitShowcase />
  <PricingPreview />
  <Testimonials />
  <InsightsPreview />
  <HomeCTA />
</BaseLayout>
