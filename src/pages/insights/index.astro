---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageSEO } from '../../lib/seo';

const posts = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
---

<BaseLayout
  title={pageSEO.insights.title}
  description={pageSEO.insights.description}
  canonical="https://witlabs.in/insights/"
  keywords={pageSEO.insights.keywords}
  noindex={false}
>
  <section class="insights-hero px-4 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-[1240px] gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div class="insights-hero__copy reveal">
        <p class="section-kicker text-green-bright">Journal</p>
        <h1>Practical notes for building a stronger digital presence.</h1>
        <p>
          Clear, useful writing from WitLabs on websites, SEO, conversion, and digital growth for Indian businesses.
        </p>
        <a class="premium-button premium-button-light mt-7" href="/contact/">Ask for a Strategy Call</a>
      </div>

      <div class="insights-board reveal reveal-delay-2" aria-label="Featured insight">
        <div class="insights-board__top">
          <span>{featuredPost ? 'Featured Article' : 'Insights'}</span>
          <span>WitLabs Notes</span>
        </div>
        {featuredPost ? (
          <a class="insights-board__feature" href={`/insights/${featuredPost.slug}/`}>
            <span>{featuredPost.data.category}</span>
            <strong>{featuredPost.data.title}</strong>
            <p>{featuredPost.data.description}</p>
            <em>
              {featuredPost.data.publishDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
              {' · '}
              {featuredPost.data.readTime} min read
            </em>
          </a>
        ) : (
          <div class="insights-board__empty">
            <strong>Publishing Soon</strong>
            <p>Fresh insights will appear here once new articles are added.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="insights-content px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-[1240px]">
      {posts.length > 0 ? (
        <div class="insights-list">
          {posts.map((post, index) => (
            <article class:list={['insight-post-card reveal', index > 0 && `reveal-delay-${Math.min(index + 1, 3)}`]}>
              <a class="insight-post-card__media" href={`/insights/${post.slug}/`} aria-label={`Read ${post.data.title}`}>
                {post.data.ogImage ? (
                  <img src={post.data.ogImage} alt={post.data.title} loading="lazy" />
                ) : (
                  <div class="insight-post-card__placeholder" aria-hidden="true"></div>
                )}
                <span>{post.data.category}</span>
              </a>

              <div class="insight-post-card__body">
                <div class="insight-post-card__meta">
                  <span>{post.data.publishDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                  <span>{post.data.readTime} min read</span>
                </div>

                <h2>
                  <a href={`/insights/${post.slug}/`}>{post.data.title}</a>
                </h2>
                <p>{post.data.description}</p>
                <a class="arrow-link text-green" href={`/insights/${post.slug}/`}>Read article <span class="arrow">→</span></a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="insights-note reveal">
          <p class="section-kicker text-green">Publishing Soon</p>
          <h2>Useful, direct, and made for business owners.</h2>
          <p>
            Until the first articles go live, you can talk to us directly about your website, SEO, or marketing plan and we will point you toward the highest-impact next step.
          </p>
          <a class="arrow-link text-green" href="/contact/">Talk to WitLabs <span class="arrow">→</span></a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .insights-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-bottom: clamp(64px, 8vw, 96px);
    padding-top: calc(var(--nav-height) + clamp(42px, 7vw, 86px));
    background: #050505;
    color: #FFFFFF;
  }

  .insights-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 76% 18%, rgba(74, 222, 128, 0.18), transparent 30%),
      radial-gradient(circle at 14% 22%, rgba(154, 86, 15, 0.14), transparent 26%),
      linear-gradient(180deg, #050505, #10100f 62%, #F8F4EC 100%);
  }

  .insights-hero__copy h1 {
    margin-top: 16px;
    max-width: 760px;
    font-size: clamp(2.55rem, 4.2vw, 4.55rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.04;
    text-wrap: balance;
  }

  .insights-hero__copy p {
    margin-top: 22px;
    max-width: 620px;
    color: rgba(255, 255, 255, 0.64);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.75;
  }

  .insights-board {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background:
      radial-gradient(circle at 24% 18%, rgba(74, 222, 128, 0.2), transparent 32%),
      linear-gradient(135deg, rgba(45, 106, 79, 0.58), #070707 62%);
    box-shadow: 0 36px 96px rgba(0, 0, 0, 0.52);
  }

  .insights-board__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 16px 18px;
    color: rgba(255, 255, 255, 0.58);
    font-family: "DM Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .insights-board__feature,
  .insights-board__empty {
    display: block;
    padding: 28px 24px 30px;
    color: inherit;
    text-decoration: none;
    min-height: 100%;
  }

  .insights-board__feature {
    background: rgba(5, 5, 5, 0.72);
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .insights-board__feature:hover {
    background: rgba(5, 5, 5, 0.82);
    transform: translateY(-2px);
  }

  .insights-board__feature span {
    color: #4ADE80;
    font-family: "DM Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .insights-board__feature strong,
  .insights-board__empty strong {
    margin-top: 14px;
    display: block;
    color: #FFFFFF;
    font-size: clamp(1.5rem, 2.2vw, 2.15rem);
    line-height: 1.12;
  }

  .insights-board__feature p,
  .insights-board__empty p {
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 1rem;
    line-height: 1.75;
  }

  .insights-board__feature em {
    display: block;
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.72);
    font-family: "DM Mono", monospace;
    font-size: 11px;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .insights-content {
    background: #F8F4EC;
  }

  .insights-list {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .insight-post-card {
    overflow: hidden;
    border: 1px solid rgba(28, 25, 23, 0.08);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 20px 54px rgba(28, 25, 23, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .insight-post-card:hover {
    transform: translateY(-5px);
    border-color: rgba(45, 106, 79, 0.16);
    box-shadow: 0 30px 74px rgba(28, 25, 23, 0.12);
  }

  .insight-post-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 18% 18%, rgba(74, 222, 128, 0.24), transparent 28%),
      linear-gradient(135deg, #0f100f 0%, #1f4c39 58%, #d8d2c5 100%);
  }

  .insight-post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .insight-post-card__placeholder {
    width: 100%;
    height: 100%;
  }

  .insight-post-card__media span {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    background: rgba(5, 5, 5, 0.72);
    color: #fff;
    font-family: "DM Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .insight-post-card__body {
    padding: 20px 20px 22px;
  }

  .insight-post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    color: #78716C;
    font-family: "DM Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .insight-post-card__body h2 {
    margin-top: 14px;
    color: #1C1917;
    font-size: clamp(1.35rem, 1.8vw, 1.8rem);
    line-height: 1.12;
    text-wrap: balance;
  }

  .insight-post-card__body h2 a {
    color: #1C1917;
    text-decoration: none;
  }

  .insight-post-card__body p {
    margin-top: 12px;
    color: #57534E;
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .insight-post-card__body .arrow-link {
    display: inline-flex;
    margin-top: 18px;
  }

  .insights-note {
    border: 1px solid rgba(45, 106, 79, 0.22);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
    padding: clamp(28px, 5vw, 48px);
    box-shadow: 0 24px 80px rgba(28, 25, 23, 0.04);
  }

  .insights-note h2 {
    margin-top: 14px;
    max-width: 680px;
    color: #1C1917;
    font-size: clamp(1.95rem, 3.2vw, 3.25rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .insights-note p:not(.section-kicker) {
    margin-top: 18px;
    max-width: 720px;
    color: #57534E;
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.75;
  }

  .insights-note a {
    margin-top: 24px;
  }

  @media (max-width: 959px) {
    .insights-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .insights-list {
      grid-template-columns: 1fr;
    }
  }
</style>
