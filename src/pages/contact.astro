---
import BaseLayout from '../layouts/BaseLayout.astro';

const web3FormsKey = import.meta.env.WEB3FORMS_KEY;
const isFormConfigured = Boolean(web3FormsKey);
const formAction = isFormConfigured ? 'https://api.web3forms.com/submit' : 'mailto:connect@witlabs.in';
const formMethod = isFormConfigured ? 'POST' : 'POST';
const formEncoding = isFormConfigured ? undefined : 'text/plain';
const whatsappHref = 'https://wa.me/917984301015?text=Hi%20WitLabs%2C%20I%20visited%20your%20website%20and%20I%27d%20like%20to%20discuss%20a%20project.';
const fieldClass = 'w-full border border-border rounded-lg px-4 py-3 text-body-sm bg-white focus:outline-none focus:border-green focus:ring-1 focus:ring-green transition-colors';
const services = [
  'Make Your Business Completely Online Package',
  'Website Design',
  'SEO & Growth',
  'Digital Marketing',
  'App Development',
  'Automation',
  'AI Chatbot',
  "Not sure yet — let's discuss",
];
const budgets = ['Under ₹15,000', '₹15,000–₹30,000', '₹30,000–₹60,000', '₹60,000+', "Let's discuss"];

const contactMethods = [
  {
    label: 'Call or WhatsApp',
    value: '+91 7984301015',
    note: 'Mon-Sat, 9am-7pm IST',
    href: 'tel:+917984301015',
    icon: 'phone',
  },
  {
    label: 'Email Us',
    value: 'connect@witlabs.in',
    note: 'Replies within 2 working hours',
    href: 'mailto:connect@witlabs.in',
    icon: 'mail',
  },
];

const responseSteps = [
  'We review your business and current digital presence',
  'We schedule a focused 20-minute call',
  'We share honest recommendations without pressure',
  'If it fits, you receive a clear proposal within 24 hours',
];

const contactHighlights = [
  { value: '20m', label: 'strategy call' },
  { value: '2hr', label: 'working day reply' },
  { value: '24hr', label: 'proposal path' },
];

const selectedPlan = Astro.url.searchParams.get('plan') ?? '';
const requestedService = Astro.url.searchParams.get('service_interested_in') ?? '';
const requestedBudget = Astro.url.searchParams.get('budget_range') ?? '';
const selectedService = services.includes(requestedService) ? requestedService : '';
const selectedBudget = budgets.includes(requestedBudget) ? requestedBudget : '';
const prefilledMessage =
  Astro.url.searchParams.get('message') ??
  (selectedPlan ? `I am interested in the ${selectedPlan} plan from the WitLabs pricing page. Please share the next steps.` : '');

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': 'https://witlabs.in/contact/#contactpage',
  url: 'https://witlabs.in/contact/',
  name: 'Contact WitLabs',
  description: 'Book a free digital strategy call with WitLabs.',
  mainEntity: { '@id': 'https://witlabs.in/#business' },
};
---

<BaseLayout
  title="Contact WitLabs — Book a Free Digital Strategy Call"
  description="Contact WitLabs for a free 20-minute strategy call. Get website, SEO, marketing, app, or automation guidance for your business."
  canonical="https://witlabs.in/contact/"
  keywords={['contact WitLabs', 'book digital strategy call', 'digital agency India contact']}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(contactPageSchema)} />

  <section class="contact-hero px-4 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-[1240px] gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div class="contact-hero__copy reveal">
        <p class="section-kicker text-green-bright">Start The Conversation</p>
        <h1>Tell us what you want to build next.</h1>
        <p>
          Book a free 20-minute strategy call with WitLabs. We will understand your business, review your current digital presence, and suggest the clearest next move.
        </p>
        <div class="contact-hero__actions">
          <a class="premium-button premium-button-light" href={whatsappHref} target="_blank" rel="noreferrer">Chat on WhatsApp</a>
          <a class="contact-hero__link" href="#contact-form">Send project details <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="contact-board reveal reveal-delay-2" aria-label="WitLabs contact response standards">
        <div class="contact-board__top">
          <span>WitLabs Response Desk</span>
          <span>India</span>
        </div>
        <div class="contact-board__grid">
          {contactHighlights.map((item) => (
            <div>
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))}
        </div>
        <a class="contact-board__whatsapp" href={whatsappHref} target="_blank" rel="noreferrer">
          <span>Fastest route</span>
          <strong>Chat on WhatsApp now</strong>
        </a>
      </div>
    </div>
  </section>

  <section class="contact-main px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
    <div class="mx-auto grid max-w-[1240px] gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <aside class="contact-side reveal">
        <p class="section-kicker text-green">Contact Details</p>
        <h2>Simple, direct, and easy to follow up.</h2>

        <div class="contact-card-list">
          {contactMethods.map((method) => (
            <a class="contact-card" href={method.href}>
              <span class="contact-card__icon" aria-hidden="true">
                {method.icon === 'phone' ? (
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="M6.5 3.5l2 3-1.6 1.7c.7 1.4 1.7 2.4 3.1 3.1l1.7-1.6 3 2v3.1c0 .9-.7 1.6-1.6 1.6C7.8 16.4 3.6 12.2 3.6 6.9c0-.9.7-1.6 1.6-1.6h1.3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="M3 5h14v10H3V5zm1 1l6 5 6-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </span>
              <span>
                <span>{method.label}</span>
                <strong>{method.value}</strong>
                <small>{method.note}</small>
              </span>
            </a>
          ))}
        </div>

        <div class="contact-steps">
          <h3>What happens next?</h3>
          <ol>
            {responseSteps.map((item, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{item}</p>
              </li>
            ))}
          </ol>
        </div>
      </aside>

      <div id="contact-form" class="contact-form-panel reveal reveal-delay-2">
        <div class="contact-form-panel__head">
          <p class="section-kicker text-green">Project Inquiry</p>
          <h2>Send us a message</h2>
          <p>Share a few details and we will reply with the best next step.</p>
        </div>

          <form class="mt-6" action={formAction} method={formMethod} enctype={formEncoding}>
            {isFormConfigured && <input type="hidden" name="access_key" value={web3FormsKey} />}
            <input type="hidden" name="subject" value="New Project Inquiry — WitLabs Website" />
            <input type="hidden" name="from_name" value="WitLabs Contact Form" />
            {isFormConfigured && <input type="hidden" name="redirect" value="https://witlabs.in/thank-you/" />}
            <input id="selected_plan" type="hidden" name="selected_plan" value={selectedPlan} />
            <input class="hidden" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />

            <div class="grid gap-5 md:grid-cols-2">
              <div class="form-group">
                <label class="mb-2 block text-body-sm font-medium text-ink" for="name">Full Name</label>
                <input id="name" class={fieldClass} type="text" name="name" autocomplete="name" required />
              </div>
              <div class="form-group">
                <label class="mb-2 block text-body-sm font-medium text-ink" for="business_name">Business Name</label>
                <input id="business_name" class={fieldClass} type="text" name="business_name" required />
              </div>
              <div class="form-group">
                <label class="mb-2 block text-body-sm font-medium text-ink" for="phone">Phone Number</label>
                <input id="phone" class={fieldClass} type="tel" name="phone" autocomplete="tel" required />
              </div>
              <div class="form-group">
                <label class="mb-2 block text-body-sm font-medium text-ink" for="email">Email Address</label>
                <input id="email" class={fieldClass} type="email" name="email" autocomplete="email" />
              </div>
            </div>

            <div class="form-group mt-5">
              <label class="mb-2 block text-body-sm font-medium text-ink" for="service_interested_in">Service Interested In</label>
              <select id="service_interested_in" class={fieldClass} name="service_interested_in" required>
                <option value="" disabled selected={!selectedService}>Select a service</option>
                {services.map((service) => <option value={service} selected={service === selectedService}>{service}</option>)}
              </select>
            </div>

            <div class="form-group mt-5">
              <label class="mb-2 block text-body-sm font-medium text-ink" for="message">Tell us about your project</label>
              <textarea
                id="message"
                class={fieldClass}
                name="message"
                rows="4"
                placeholder="Tell us about your business, what you need, and any specific goals or timeline you have in mind..."
              >{prefilledMessage}</textarea>
            </div>

            <div class="form-group mt-5">
              <label class="mb-2 block text-body-sm font-medium text-ink" for="budget_range">Budget Range</label>
              <select id="budget_range" class={fieldClass} name="budget_range">
                <option value="" disabled selected={!selectedBudget}>Select a budget range</option>
                {budgets.map((budget) => <option value={budget} selected={budget === selectedBudget}>{budget}</option>)}
              </select>
            </div>

            <button class="premium-button premium-button-primary mt-6 w-full py-4 text-[13px]" type="submit">
              Send Message →
            </button>
          </form>

          <p class="mt-4 text-center text-caption text-muted">
            Your information is private and will never be shared with third parties.
          </p>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const selectedPlan = params.get('plan') || '';
      const selectedService = params.get('service_interested_in') || '';
      const selectedBudget = params.get('budget_range') || '';
      const message =
        params.get('message') ||
        (selectedPlan ? `I am interested in the ${selectedPlan} plan from the WitLabs pricing page. Please share the next steps.` : '');

      const planInput = document.getElementById('selected_plan');
      const serviceSelect = document.getElementById('service_interested_in');
      const budgetSelect = document.getElementById('budget_range');
      const messageField = document.getElementById('message');

      if (planInput instanceof HTMLInputElement) planInput.value = selectedPlan;
      if (serviceSelect instanceof HTMLSelectElement && selectedService) serviceSelect.value = selectedService;
      if (budgetSelect instanceof HTMLSelectElement && selectedBudget) budgetSelect.value = selectedBudget;
      if (messageField instanceof HTMLTextAreaElement && message) messageField.value = message;
    })();
  </script>
</BaseLayout>

<style>
  .contact-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-bottom: clamp(64px, 8vw, 96px);
    padding-top: calc(var(--nav-height) + clamp(42px, 7vw, 86px));
    background: #050505;
    color: #FFFFFF;
  }

  .contact-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 76% 18%, rgba(74, 222, 128, 0.18), transparent 30%),
      radial-gradient(circle at 14% 22%, rgba(154, 86, 15, 0.14), transparent 26%),
      linear-gradient(180deg, #050505, #10100f 62%, #F8F4EC 100%);
  }

  .contact-hero__copy h1 {
    margin-top: 16px;
    max-width: 760px;
    font-size: clamp(2.55rem, 4.2vw, 4.55rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.04;
    text-wrap: balance;
  }

  .contact-hero__copy p:last-of-type {
    margin-top: 22px;
    max-width: 640px;
    color: rgba(255, 255, 255, 0.64);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.75;
  }

  .contact-hero__actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .contact-hero__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    font-weight: 800;
  }

  .contact-hero__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    height: 2px;
    width: 100%;
    background: #4ADE80;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s var(--ease-standard);
  }

  .contact-hero__link:hover::after,
  .contact-hero__link:focus-visible::after {
    transform: scaleX(1);
  }

  .contact-board {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background:
      radial-gradient(circle at 24% 18%, rgba(74, 222, 128, 0.2), transparent 32%),
      linear-gradient(135deg, rgba(45, 106, 79, 0.58), #070707 62%);
    box-shadow: 0 36px 96px rgba(0, 0, 0, 0.52);
  }

  .contact-board__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 16px 18px;
    color: rgba(255, 255, 255, 0.58);
    font-family: "DM Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-board__grid {
    display: grid;
    gap: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .contact-board__grid div {
    min-height: 150px;
    background: rgba(5, 5, 5, 0.76);
    padding: 24px;
  }

  .contact-board__grid strong {
    display: block;
    color: #4ADE80;
    font-size: clamp(2.25rem, 4vw, 4rem);
    line-height: 1;
  }

  .contact-board__grid span,
  .contact-board__whatsapp span,
  .contact-card span span,
  .contact-steps li span {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-board__grid span {
    margin-top: 10px;
    display: block;
    color: rgba(255, 255, 255, 0.58);
  }

  .contact-board__whatsapp {
    display: grid;
    gap: 8px;
    padding: 24px;
    color: #FFFFFF;
    transition: background 0.3s var(--ease-standard);
  }

  .contact-board__whatsapp:hover,
  .contact-board__whatsapp:focus-visible {
    background: rgba(74, 222, 128, 0.1);
    outline: none;
  }

  .contact-board__whatsapp span {
    color: #4ADE80;
  }

  .contact-board__whatsapp strong {
    font-size: clamp(1.3rem, 2.2vw, 2.1rem);
    line-height: 1.1;
  }

  .contact-main {
    background: #F8F4EC;
  }

  .contact-side {
    align-self: start;
  }

  .contact-side h2,
  .contact-form-panel__head h2 {
    margin-top: 16px;
    color: #1C1917;
    font-size: clamp(1.8rem, 2.9vw, 3rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
    text-wrap: balance;
  }

  .contact-card-list {
    margin-top: 32px;
    display: grid;
    gap: 14px;
  }

  .contact-card,
  .contact-steps,
  .contact-form-panel {
    border: 1px solid rgba(45, 106, 79, 0.18);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.74);
    box-shadow: 0 24px 80px rgba(28, 25, 23, 0.04);
    backdrop-filter: blur(14px);
  }

  .contact-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    color: #1C1917;
    transition: transform 0.35s var(--ease-premium), border-color 0.35s var(--ease-standard), box-shadow 0.35s var(--ease-premium);
  }

  .contact-card:hover,
  .contact-card:focus-visible {
    border-color: rgba(45, 106, 79, 0.58);
    box-shadow: 0 34px 92px rgba(28, 25, 23, 0.1);
    outline: none;
    transform: translateY(-4px);
  }

  .contact-card__icon {
    display: flex;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(45, 106, 79, 0.1);
    color: #2D6A4F;
  }

  .contact-card__icon svg {
    width: 20px;
    height: 20px;
  }

  .contact-card span span {
    display: block;
    color: #78716C;
  }

  .contact-card strong {
    margin-top: 4px;
    display: block;
    color: #1C1917;
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .contact-card small {
    margin-top: 5px;
    display: block;
    color: #57534E;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .contact-steps {
    margin-top: 28px;
    padding: 24px;
  }

  .contact-steps h3 {
    color: #1C1917;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .contact-steps ol {
    margin-top: 20px;
    display: grid;
    gap: 16px;
  }

  .contact-steps li {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    align-items: start;
  }

  .contact-steps li span {
    color: #2D6A4F;
    line-height: 1.7;
  }

  .contact-steps p {
    color: #57534E;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .contact-form-panel {
    padding: clamp(24px, 4vw, 40px);
  }

  .contact-form-panel__head p:last-child {
    margin-top: 14px;
    max-width: 560px;
    color: #57534E;
    font-size: 1rem;
    line-height: 1.7;
  }

  .contact-form-panel label {
    color: #1C1917;
    font-weight: 700;
  }

  .contact-form-panel input,
  .contact-form-panel select,
  .contact-form-panel textarea {
    min-height: 50px;
  }

  .contact-form-panel textarea {
    min-height: 128px;
    resize: vertical;
  }

  @media (min-width: 720px) {
    .contact-board__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .contact-board__top {
      flex-direction: column;
      gap: 6px;
    }

    .contact-board__grid div {
      min-height: 120px;
    }

    .contact-card {
      padding: 18px;
    }
  }
</style>
