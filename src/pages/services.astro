---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageSEO } from '../lib/seo';

const services = [
  {
    id: 'website-systems',
    label: 'Website Systems',
    number: '01',
    summary: 'Conversion-first websites and landing pages for service businesses, local brands, and founder-led teams that need a clearer buyer journey.',
    includes: ['Offer positioning and page strategy before design', 'Mobile-first UI built around trust and action', 'Fast Astro builds with SEO-ready foundations', 'Contact forms, WhatsApp, analytics, and clear CTA architecture'],
  },
  {
    id: 'seo',
    label: 'SEO & Content Growth',
    number: '02',
    summary: 'Search foundations, local visibility, and sector-specific content built around how your buyers actually search.',
    includes: ['Technical audit with priority fixes', 'Keyword research around service and comparison intent', 'Optimized titles, service pages, and internal links', 'Google Business Profile, local SEO, and insight content planning'],
  },
  {
    id: 'lead-systems',
    label: 'Lead Capture & Follow-up Systems',
    number: '03',
    summary: 'The layer between traffic and sales: enquiry capture, routing, WhatsApp flow, and a better handoff after the click.',
    includes: ['Shorter forms and cleaner enquiry paths', 'WhatsApp, callbacks, and follow-up journey planning', 'Landing page structure aligned with intent', 'Lead routing logic and practical response system suggestions'],
  },
  {
    id: 'automation',
    label: 'Automation & Internal Tools',
    number: '04',
    summary: 'Lean internal systems for reporting, operations, dashboards, and repetitive workflows that do not need enterprise bloat.',
    includes: ['Workflow mapping to find manual bottlenecks', 'CRM, forms, sheets, and tool integrations', 'Dashboards for tracking tasks, leads, and reporting', 'Automation support for sales, service, and internal operations'],
  },
];

const serviceListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://witlabs.in/services/#services',
  name: 'WitLabs Digital Services',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      '@id': `https://witlabs.in/services/#${service.id}`,
      name: service.label,
      description: service.summary,
      provider: { '@id': 'https://witlabs.in/#business' },
      areaServed: { '@type': 'Country', name: 'India' },
      url: `https://witlabs.in/services/#${service.id}`,
    },
  })),
};
---

<BaseLayout
  title={pageSEO.services.title}
  description={pageSEO.services.description}
  canonical="https://witlabs.in/services/"
  keywords={pageSEO.services.keywords}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceListSchema)} />

  <section class="services-hero px-4 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-[1240px] gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div class="services-hero__copy reveal">
        <p class="section-kicker text-green-bright">What We Build</p>
        <h1>Websites, visibility, and lead systems with a clearer center of gravity.</h1>
        <p>
          WitLabs is strongest when the website, search visibility, and enquiry flow need to work together. That is the core. Automation and internal tools support it when they genuinely help the business run better.
        </p>
        <div class="services-hero__actions">
          <a class="premium-button premium-button-light" href="/contact/">Start a Project</a>
          <a class="services-hero__link" href="#website-systems">Explore services <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="services-hero__stage reveal reveal-delay-2" aria-label="WitLabs service areas">
        {services.map((service, index) => (
          <a class:list={['services-hero-card', index === 0 && 'services-hero-card--main']} href={`#${service.id}`}>
            <span>{service.number}</span>
            <strong>{service.label}</strong>
            <small>{service.summary}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="services-nav-section px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-[1240px] flex-wrap justify-center gap-2">
      {services.map((service) => (
        <a class="services-chip" href={`#${service.id}`}>{service.label}</a>
      ))}
    </div>
  </section>

  <section class="services-list px-4 pb-20 sm:px-6 lg:px-8 lg:pb-24">
    <div class="mx-auto grid max-w-[1240px] gap-5 md:grid-cols-2">
      {services.map((service, index) => (
        <article id={service.id} class:list={['service-detail-card reveal', `reveal-delay-${(index % 3) + 1}`]}>
          <span class="service-detail-card__shine" aria-hidden="true"></span>
          <p>{service.number}</p>
          <h2>{service.label}</h2>
          <span>{service.summary}</span>
          <ul>
            {service.includes.map((item) => (
              <li>
                <i aria-hidden="true">✓</i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="services-cta px-4 py-16 text-white sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="section-kicker text-white/62">Not sure where to start?</p>
        <h2>We will map the fastest next move.</h2>
      </div>
      <a class="premium-button premium-button-light shrink-0" href="/contact/">Book a Strategy Call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .services-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-bottom: clamp(64px, 8vw, 96px);
    padding-top: calc(var(--nav-height) + clamp(42px, 7vw, 86px));
    background: #050505;
    color: #FFFFFF;
  }

  .services-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 76% 18%, rgba(74, 222, 128, 0.18), transparent 30%),
      radial-gradient(circle at 14% 22%, rgba(154, 86, 15, 0.14), transparent 26%),
      linear-gradient(180deg, #050505, #10100f 62%, #F8F4EC 100%);
  }

  .services-hero__copy h1 {
    margin-top: 16px;
    max-width: 760px;
    font-size: clamp(2.55rem, 4.2vw, 4.55rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.04;
    text-wrap: balance;
  }

  .services-hero__copy p:last-of-type {
    margin-top: 22px;
    max-width: 620px;
    color: rgba(255, 255, 255, 0.64);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.75;
  }

  .services-hero__actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .services-hero__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    font-weight: 800;
  }

  .services-hero__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    height: 2px;
    width: 100%;
    background: #4ADE80;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s var(--ease-standard);
  }

  .services-hero__link:hover::after,
  .services-hero__link:focus-visible::after {
    transform: scaleX(1);
  }

  .services-hero__stage {
    display: grid;
    gap: 14px;
  }

  .services-hero-card {
    position: relative;
    display: grid;
    min-height: 150px;
    overflow: hidden;
    align-content: end;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03)), #070707;
    padding: 22px;
    color: #FFFFFF;
    box-shadow: 0 28px 84px rgba(0, 0, 0, 0.32);
    transition: transform 0.55s var(--ease-premium), border-color 0.35s var(--ease-standard), box-shadow 0.55s var(--ease-premium);
  }

  .services-hero-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 82% 18%, rgba(74, 222, 128, 0.18), transparent 25%);
    pointer-events: none;
  }

  .services-hero-card:hover,
  .services-hero-card:focus-visible {
    border-color: rgba(74, 222, 128, 0.58);
    box-shadow: 0 36px 96px rgba(0, 0, 0, 0.52), 0 0 0 1px rgba(74, 222, 128, 0.16);
    outline: none;
    transform: translateY(-5px);
  }

  .services-hero-card span,
  .services-hero-card strong,
  .services-hero-card small {
    position: relative;
    z-index: 1;
  }

  .services-hero-card span,
  .services-chip,
  .service-detail-card > p {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .services-hero-card span {
    color: #4ADE80;
  }

  .services-hero-card strong {
    margin-top: 8px;
    font-size: clamp(1.35rem, 2vw, 2rem);
    line-height: 1.1;
  }

  .services-hero-card small {
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 12px;
    line-height: 1.45;
  }

  .services-hero-card--main {
    min-height: 216px;
    background:
      radial-gradient(circle at 22% 18%, rgba(74, 222, 128, 0.24), transparent 30%),
      linear-gradient(135deg, rgba(45, 106, 79, 0.72), #070707 64%);
  }

  .services-nav-section,
  .services-list {
    background: #F8F4EC;
  }

  .services-chip {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(45, 106, 79, 0.18);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.68);
    padding: 11px 15px;
    color: #2D6A4F;
    box-shadow: 0 10px 26px rgba(28, 25, 23, 0);
    transition: background 0.25s var(--ease-standard), border-color 0.25s var(--ease-standard), box-shadow 0.25s var(--ease-standard), color 0.25s var(--ease-standard), transform 0.25s var(--ease-standard);
  }

  .services-chip:hover,
  .services-chip:focus-visible {
    border-color: #2D6A4F;
    background: #2D6A4F;
    color: #FFFFFF;
    box-shadow: 0 16px 34px rgba(45, 106, 79, 0.18);
    transform: translateY(-2px);
  }

  .service-detail-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(45, 106, 79, 0.22);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.72));
    padding: 28px;
    box-shadow: 0 24px 80px rgba(28, 25, 23, 0.04);
    scroll-margin-top: calc(var(--nav-height) + 24px);
    transition: transform 0.55s var(--ease-premium), box-shadow 0.55s var(--ease-premium), border-color 0.35s var(--ease-standard);
  }

  .service-detail-card:hover {
    border-color: rgba(45, 106, 79, 0.58);
    box-shadow: 0 44px 120px rgba(28, 25, 23, 0.12);
    transform: translateY(-6px);
  }

  .service-detail-card > p {
    color: #2D6A4F;
  }

  .service-detail-card h2 {
    margin-top: 12px;
    color: #1C1917;
    font-size: clamp(1.55rem, 2.2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .service-detail-card > span {
    margin-top: 14px;
    display: block;
    color: #78716C;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .service-detail-card ul {
    margin-top: 24px;
    display: grid;
    gap: 12px;
  }

  .service-detail-card li {
    display: flex;
    gap: 12px;
    color: #44403C;
    font-size: 14px;
    line-height: 1.45;
  }

  .service-detail-card i {
    display: grid;
    width: 21px;
    height: 21px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: #2D6A4F;
    font-size: 12px;
    font-style: normal;
    line-height: 1;
  }

  .services-cta {
    background: #2D6A4F;
  }

  .services-cta h2 {
    margin-top: 12px;
    font-size: clamp(1.55rem, 2.2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.1;
  }

  @media (min-width: 720px) {
    .services-hero__stage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .services-hero-card--main {
      grid-row: span 2;
    }
  }
</style>
