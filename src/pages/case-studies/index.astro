---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/shared/StructuredData.astro';
import { pageSEO } from '../../lib/seo';

const caseStudies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const industries = ['All', 'Business Consulting', 'Manufacturing', 'Education'];
const industryBadgeClass: Record<string, string> = {
  'Business Consulting': 'bg-green-light text-green',
  Manufacturing: 'bg-warm-light text-warm',
  Education: 'bg-blue-100 text-blue-700',
};
---

<BaseLayout
  title={pageSEO.caseStudies.title}
  description={pageSEO.caseStudies.description}
  canonical="https://witlabs.in/case-studies/"
  keywords={pageSEO.caseStudies.keywords}
>
  <StructuredData
    type="breadcrumb"
    items={[
      { name: 'Home', url: 'https://witlabs.in/' },
      { name: 'Case Studies', url: 'https://witlabs.in/case-studies/' },
    ]}
  />

  <section class="bg-white pt-28">
    <div class="container py-20">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-caption text-muted">
          <li><a class="hover:text-green" href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="text-ink">Case Studies</li>
        </ol>
      </nav>

      <div class="mt-10 max-w-4xl">
        <p class="eyebrow">CASE STUDIES</p>
        <h1 class="mt-4 text-display-md text-balance">
          Case Studies — Indian Businesses. Real challenges. Smart solutions. Measurable results.
        </h1>
        <p class="mt-6 max-w-3xl text-body-lg text-muted">
          We let the results do the talking. Here's how we've helped Indian businesses in consulting, manufacturing and education grow their digital presence and generate more leads.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cream pb-section">
    <div class="container">
      <div class="-mt-7 flex justify-center">
        <div class="inline-flex flex-wrap justify-center gap-1 rounded-full bg-cream-dark p-1" role="tablist" aria-label="Filter case studies by industry">
          {industries.map((industry) => (
            <button
              class="case-filter rounded-full px-5 py-2.5 text-body-sm font-medium text-ink-light transition-colors hover:text-ink data-[active=true]:bg-ink data-[active=true]:text-cream"
              type="button"
              data-filter={industry}
              data-active={industry === 'All' ? 'true' : 'false'}
              aria-pressed={industry === 'All' ? 'true' : 'false'}
            >
              {industry}
            </button>
          ))}
        </div>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {caseStudies.map((study) => (
          <article class="case-card card-base overflow-hidden" data-industry={study.data.industry}>
            <a class="block h-full" href={`/case-studies/${study.slug}/`} aria-label={`View full ${study.data.client} case study`}>
              <img class="aspect-video w-full rounded-t-2xl object-cover" src={study.data.heroImage} alt={study.data.heroImageAlt} loading="lazy" />
              <div class="p-6">
                <span class:list={['inline-flex rounded-full px-3 py-1 text-caption font-semibold', industryBadgeClass[study.data.industry] ?? 'bg-cream text-ink']}>
                  {study.data.industry}
                </span>
                <h2 class="mt-4 text-heading-md font-semibold text-ink">{study.data.client}</h2>
                <div class="mt-4 flex flex-wrap gap-2">
                  {study.data.services.map((service) => (
                    <span class="rounded-full border border-border bg-cream px-3 py-1 text-caption text-muted">{service}</span>
                  ))}
                </div>
                <p class="mt-5 line-clamp-2 text-body-sm text-muted">{study.data.challenge}</p>

                <div class="mt-6 grid grid-cols-3 gap-3 border-t border-border pt-5">
                  {study.data.results.slice(0, 3).map((result) => (
                    <div>
                      <p class="text-xl font-bold text-green">{result.value}</p>
                      <p class="mt-1 text-caption text-muted">{result.metric}</p>
                    </div>
                  ))}
                </div>

                <p class="mt-6 text-green font-medium text-body-sm">View Full Case Study →</p>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-16 rounded-3xl bg-white p-8 text-center shadow-sm md:p-10">
        <h2 class="text-heading-lg font-semibold text-ink">Don't see your industry?</h2>
        <p class="mx-auto mt-3 max-w-2xl text-body-md text-muted">
          We work with all types of Indian businesses. Tell us about yours.
        </p>
        <a class="mt-8 inline-flex rounded-full bg-ink px-6 py-3.5 text-body-sm font-medium text-cream hover:bg-ink-light" href="/contact/">
          Book a Free Strategy Call
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const filterButtons = document.querySelectorAll('.case-filter');
  const caseCards = document.querySelectorAll('.case-card');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;

      filterButtons.forEach((item) => {
        const active = item === button;
        item.dataset.active = String(active);
        item.setAttribute('aria-pressed', String(active));
      });

      caseCards.forEach((card) => {
        const shouldShow = filter === 'All' || card.dataset.industry === filter;
        card.classList.toggle('hidden', !shouldShow);
      });
    });
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
