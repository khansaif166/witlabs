---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/shared/StructuredData.astro';

export async function getStaticPaths() {
  const caseStudies = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
  );

  return caseStudies.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      nextCaseStudy: caseStudies[(index + 1) % caseStudies.length],
    },
  }));
}

const { entry, nextCaseStudy } = Astro.props;
const { Content } = await entry.render();
const canonicalUrl = `https://witlabs.in/case-studies/${entry.slug}/`;
const whatsappHref = 'https://wa.me/917984301015?text=Hi%20WitLabs%2C%20I%20visited%20your%20website%20and%20I%27d%20like%20to%20discuss%20a%20project.';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': canonicalUrl,
  headline: entry.data.seoTitle,
  description: entry.data.seoDescription,
  image: `https://witlabs.in${entry.data.heroImage}`,
  datePublished: entry.data.publishDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'WitLabs',
    '@id': 'https://witlabs.in/#organization',
  },
  publisher: {
    '@type': 'Organization',
    name: 'WitLabs',
    logo: { '@type': 'ImageObject', url: 'https://witlabs.in/images/logo.png' },
  },
  about: {
    '@type': 'Organization',
    name: entry.data.client,
    industry: entry.data.industry,
  },
  mainEntityOfPage: canonicalUrl,
};
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  canonical={canonicalUrl}
  ogImage={entry.data.heroImage}
  ogType="article"
  publishDate={entry.data.publishDate.toISOString()}
  keywords={entry.data.keywords}
>
  <StructuredData type="article" data={articleSchema} />
  <StructuredData
    type="breadcrumb"
    items={[
      { name: 'Home', url: 'https://witlabs.in/' },
      { name: 'Case Studies', url: 'https://witlabs.in/case-studies/' },
      { name: entry.data.client, url: canonicalUrl },
    ]}
  />

  <div class="bg-white pt-28">
    <div class="container py-5">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-caption text-muted">
          <li><a class="hover:text-green" href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a class="hover:text-green" href="/case-studies/">Case Studies</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="text-ink">{entry.data.client}</li>
        </ol>
      </nav>
    </div>
  </div>

  <section class="relative max-h-96 min-h-80 overflow-hidden bg-ink">
    <img class="h-full max-h-96 min-h-80 w-full object-cover opacity-70" src={entry.data.heroImage} alt={entry.data.heroImageAlt} loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/45 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0">
      <div class="container pb-10">
        <span class="inline-flex rounded-full bg-white/15 px-3 py-1 text-caption font-semibold text-white backdrop-blur">
          {entry.data.industry}
        </span>
        <h1 class="mt-4 max-w-4xl text-display-md text-white text-balance">{entry.data.client}</h1>
      </div>
    </div>
  </section>

  <article class="bg-white">
    <div class="container grid gap-10 py-16 lg:grid-cols-[minmax(0,0.65fr)_minmax(320px,0.35fr)] lg:items-start">
      <div class="space-y-10">
        <section>
          <p class="eyebrow">THE CHALLENGE</p>
          <h2 class="mt-3 text-heading-xl font-semibold text-ink">What needed to change</h2>
          <p class="mt-5 text-body-lg text-muted">{entry.data.challenge}</p>
        </section>

        <section>
          <p class="eyebrow">OUR APPROACH</p>
          <h2 class="mt-3 text-heading-xl font-semibold text-ink">How WitLabs solved it</h2>
          <p class="mt-5 text-body-lg text-muted">{entry.data.approach}</p>
        </section>

        <section class="case-study-prose border-t border-border pt-10">
          <Content />
        </section>
      </div>

      <aside class="space-y-5 lg:sticky lg:top-24">
        <div class="rounded-2xl border border-border bg-cream p-6">
          <h3 class="font-semibold text-heading-md text-ink">Services Provided</h3>
          <div class="mt-5 flex flex-wrap gap-2">
            {entry.data.services.map((service) => (
              <span class="rounded-full border border-border bg-white px-3 py-1.5 text-caption text-ink-light">{service}</span>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-border bg-white p-6">
          <h3 class="font-semibold text-heading-md text-ink">Client Info</h3>
          <dl class="mt-5 grid gap-4 text-body-sm">
            <div>
              <dt class="text-muted">Industry</dt>
              <dd class="mt-1 font-medium text-ink">{entry.data.industry}</dd>
            </div>
            <div>
              <dt class="text-muted">Location</dt>
              <dd class="mt-1 font-medium text-ink">{entry.data.location}</dd>
            </div>
          </dl>
        </div>

        <div class="rounded-2xl bg-green p-6 text-white">
          <h3 class="text-heading-md font-semibold">Want results like this?</h3>
          <p class="mt-3 text-body-sm text-white/75">Book a free strategy call and we’ll map the fastest digital growth opportunities for your business.</p>
          <div class="mt-6 grid gap-3">
            <a class="rounded-full bg-white px-5 py-3 text-center text-body-sm font-medium text-green hover:bg-cream" href="/contact/">
              Book a free strategy call
            </a>
            <a class="rounded-full border border-white/40 px-5 py-3 text-center text-body-sm font-medium text-white hover:bg-white/10" href={whatsappHref} target="_blank" rel="noreferrer">
              WhatsApp Us
            </a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <section class="bg-cream py-16">
    <div class="container">
      <h2 class="text-display-md text-ink">The Results</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {entry.data.results.slice(0, 3).map((result) => (
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="text-display-md font-bold text-green">{result.value}</p>
            <h3 class="mt-4 text-heading-md font-semibold text-ink">{result.metric}</h3>
            <p class="mt-2 text-body-sm text-muted">{result.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {entry.data.testimonial && (
    <section class="bg-ink py-16 text-cream">
      <div class="container">
        <div class="relative mx-auto max-w-4xl text-center">
          <span class="absolute -top-10 left-1/2 -translate-x-1/2 text-9xl leading-none text-white/10 font-serif" aria-hidden="true">"</span>
          <blockquote class="relative font-serif text-heading-xl italic leading-tight text-cream">
            {entry.data.testimonial.quote}
          </blockquote>
          <p class="mt-8 font-semibold text-cream">{entry.data.testimonial.name}</p>
          <p class="mt-1 text-body-sm text-cream/55">{entry.data.testimonial.role}</p>
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-border bg-white py-12">
    <div class="container">
      <a class="group flex flex-col gap-3 rounded-2xl border border-border p-6 transition hover:border-green hover:bg-cream md:flex-row md:items-center md:justify-between" href={`/case-studies/${nextCaseStudy.slug}/`}>
        <div>
          <p class="text-body-sm font-medium text-green">Read next case study →</p>
          <h2 class="mt-2 text-heading-lg font-semibold text-ink">{nextCaseStudy.data.client}</h2>
          <p class="mt-1 text-body-sm text-muted">{nextCaseStudy.data.industry}</p>
        </div>
        <span class="text-3xl text-green transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="bg-green py-16 text-white">
    <div class="container text-center">
      <h2 class="text-display-md text-white text-balance">Ready to be our next success story?</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a class="rounded-full bg-white px-7 py-4 text-body-sm font-medium text-green hover:bg-cream" href="/contact/">
          Book a Free Strategy Call
        </a>
        <a class="rounded-full border-2 border-white/30 px-7 py-4 text-body-sm font-medium text-white hover:bg-white/10" href={whatsappHref} target="_blank" rel="noreferrer">
          WhatsApp Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-study-prose :global(h2) {
    margin-top: 2rem;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1.15;
    font-weight: 600;
    color: #1a1814;
  }

  .case-study-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .case-study-prose :global(p) {
    margin-top: 1rem;
    color: #6b6760;
    font-size: 1rem;
    line-height: 1.8;
  }
</style>
