---
const pathname = Astro.url.pathname;
const normalizedPath = pathname.endsWith('/') ? pathname : `${pathname}/`;
const isContactPage = normalizedPath === '/contact/';
const whatsappHref = 'https://wa.me/919157241575?text=Hi%20WitLabs%2C%20I%20visited%20your%20website%20and%20I%27d%20like%20to%20discuss%20a%20project.';
---

{!isContactPage && (
  <a
    class="group fixed bottom-5 right-5 md:right-8 md:bottom-8 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-2xl shadow-[#25D366]/25 transition-transform duration-200 hover:scale-105 focus-visible:scale-105"
    href={whatsappHref}
    target="_blank"
    rel="noreferrer"
    aria-label="Chat with WitLabs on WhatsApp"
  >
    <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-30 animate-ping [animation-duration:2s]" aria-hidden="true"></span>
    <span class="pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-full bg-ink px-3 py-2 text-caption font-medium text-cream opacity-0 shadow-lg transition-all duration-200 translate-x-2 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100">
      Chat with us
    </span>
    <svg class="relative h-7 w-7" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
      <path d="M16.02 3.2A12.66 12.66 0 005.04 22.16L3.2 28.8l6.8-1.78A12.66 12.66 0 1016.02 3.2zm0 22.98c-2.1 0-4.04-.63-5.67-1.72l-.4-.26-4.03 1.06 1.08-3.9-.27-.41a10.3 10.3 0 1119.6-4.43 10.31 10.31 0 01-10.31 9.66zm5.65-7.72c-.31-.16-1.84-.91-2.13-1.01-.28-.11-.49-.16-.7.16-.2.31-.8 1-.98 1.2-.18.22-.36.24-.67.08-.31-.16-1.31-.48-2.5-1.54a9.32 9.32 0 01-1.72-2.14c-.18-.31-.02-.48.14-.64.14-.14.31-.36.47-.54.16-.18.2-.31.31-.52.1-.2.05-.39-.03-.54-.08-.16-.7-1.69-.96-2.31-.25-.6-.51-.52-.7-.53h-.59c-.2 0-.54.08-.83.39-.28.31-1.08 1.06-1.08 2.58 0 1.52 1.11 2.99 1.27 3.2.16.2 2.18 3.32 5.28 4.66.74.32 1.31.51 1.76.65.74.23 1.41.2 1.94.12.59-.09 1.84-.75 2.1-1.48.26-.72.26-1.34.18-1.48-.08-.13-.28-.2-.59-.36z" />
    </svg>
  </a>
)}
