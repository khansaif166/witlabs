---
interface Props {
  type: 'organization' | 'localBusiness' | 'article' | 'breadcrumb';
  data?: Record<string, unknown>;
  items?: Array<{ name: string; url: string }>;
}

const { type, data = {}, items = [] } = Astro.props;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://witlabs.in/#organization',
  name: 'WitLabs',
  url: 'https://witlabs.in',
  logo: {
    '@type': 'ImageObject',
    url: 'https://witlabs.in/images/logo.png',
    width: 958,
    height: 411,
  },
  description: 'Be Found. Be Chosen. WitLabs is a digital growth agency helping Indian businesses build websites, rank on Google and grow with digital marketing and automation.',
  foundingDate: '2024',
  founder: {
    '@type': 'Person',
    name: 'Saif Ali Khan',
    jobTitle: 'Founder & Digital Strategist',
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'IN',
    addressRegion: 'India',
  },
  contactPoint: [{
    '@type': 'ContactPoint',
    telephone: '+91-7984301015',
    contactType: 'sales',
    availableLanguage: ['English', 'Hindi'],
  }],
  sameAs: [
    'https://www.instagram.com/witlabs',
    'https://www.linkedin.com/company/117754070',
    'https://twitter.com/witlabs',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Digital Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website Design and Development' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Search Engine Optimization' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Digital Marketing' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Mobile App Development' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Chatbot Development' } },
    ],
  },
};

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://witlabs.in/#business',
  name: 'WitLabs',
  image: 'https://witlabs.in/og/default.jpg',
  logo: 'https://witlabs.in/images/logo.png',
  url: 'https://witlabs.in',
  telephone: '+91-7984301015',
  email: 'connect@witlabs.in',
  priceRange: '₹₹',
  currenciesAccepted: 'INR',
  paymentAccepted: 'Cash, Bank Transfer, UPI',
  sameAs: organization.sameAs,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'IN',
    addressRegion: 'India',
  },
  areaServed: {
    '@type': 'Country',
    name: 'India',
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '19:00',
  }],
};

const schemas = {
  organization,
  localBusiness,
  article: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    ...data,
  },
  breadcrumb: {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  },
};

const schema = schemas[type];
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
