---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
}

const { href = '#', variant = 'primary' } = Astro.props;
const classes =
  variant === 'primary'
    ? 'premium-button premium-button-primary'
    : 'premium-button premium-button-outline';
---

<a class={classes} href={href}>
  <slot />
</a>
