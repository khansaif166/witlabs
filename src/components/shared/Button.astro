---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
}

const { href = '#', variant = 'primary' } = Astro.props;
const classes =
  variant === 'primary'
    ? 'bg-green text-white hover:bg-ink'
    : 'border border-border text-ink hover:border-green hover:text-green';
---

<a class={`inline-flex items-center rounded-full px-5 py-3 text-sm font-semibold ${classes}`} href={href}>
  <slot />
</a>
