---
const steps = [
  {
    title: 'Discover',
    description: 'We spend time understanding your business, competitors and goals before writing a single line of code.',
  },
  {
    title: 'Strategize',
    description: 'We create a clear digital plan — what to build, what to prioritise and what will get results fastest.',
  },
  {
    title: 'Design & Build',
    description: 'We design and develop your solution with performance and conversion as the top priorities.',
  },
  {
    title: 'Launch',
    description: 'We test everything thoroughly, then launch with zero drama. You approve before anything goes live.',
  },
  {
    title: 'Optimise',
    description: "We track performance, share reports and keep improving — we don't disappear after launch.",
  },
];

const whatsappHref = 'https://wa.me/917984301015?text=Hi%20WitLabs%2C%20I%20visited%20your%20website%20and%20I%27d%20like%20to%20discuss%20a%20project.';
---

<section class="py-section bg-white">
  <div class="container">
    <div class="max-w-3xl">
      <p class="eyebrow reveal">HOW WE WORK</p>
      <h2 class="reveal reveal-delay-1 mt-3 text-display-md text-balance">A proven process. Predictable results.</h2>
      <p class="reveal reveal-delay-2 mt-5 text-body-lg text-muted">
        No surprises, no ghosting, no vague timelines. Here is exactly what happens when you work with WitLabs.
      </p>
    </div>

    <div class="relative mt-14 grid gap-8 md:grid-cols-5 md:gap-5">
      <div class="absolute left-8 right-8 top-6 hidden border-t-2 border-dashed border-green/20 md:block" aria-hidden="true"></div>
      {steps.map((step, index) => (
        <article class:list={['relative reveal', index > 0 && `reveal-delay-${Math.min(index, 4)}`]}>
          <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full border-2 border-green bg-white text-green font-mono font-bold">
            {index + 1}
          </div>
          <h3 class="mt-4 font-semibold text-heading-md text-ink">{step.title}</h3>
          <p class="mt-3 text-body-sm text-muted">{step.description}</p>
        </article>
      ))}
    </div>

    <div class="reveal mt-16 bg-cream-dark rounded-3xl p-8 flex items-center justify-between flex-wrap gap-6">
      <p class="text-heading-md font-semibold text-ink">Have a project in mind? We reply within 2 hours.</p>
      <div class="flex flex-wrap gap-3">
        <a class="inline-flex rounded-full bg-green px-5 py-3 text-body-sm font-medium text-white hover:bg-green-dark" href={whatsappHref} target="_blank" rel="noreferrer">
          WhatsApp Now
        </a>
        <a class="inline-flex rounded-full border border-border px-5 py-3 text-body-sm font-medium text-ink hover:bg-white" href="/contact/">
          Book a Call
        </a>
      </div>
    </div>
  </div>
</section>
