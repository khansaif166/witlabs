---
const steps = [
  ['Discover', 'Understand the business.'],
  ['Strategize', 'Choose the smartest move.'],
  ['Build', 'Design, write, and ship.'],
  ['Launch', 'Test every key flow.'],
  ['Optimize', 'Improve what matters.'],
];
---

<section id="process" class="section-shell bg-[#F7F7F3] text-ink">
  <div class="mx-auto grid max-w-[1440px] gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="section-kicker reveal text-green">How It Works</p>
      <h2 class="reveal reveal-delay-1 mt-4 display-tight text-[clamp(2.2rem,4.5vw,4.25rem)] font-semibold">
        Simple. Clear. Done.
      </h2>
      <p class="reveal reveal-delay-2 mt-5 max-w-sm text-base leading-7 text-ink-light">
        You always know what is next.
      </p>
    </div>

    <div class="process-list reveal reveal-delay-3">
      {steps.map(([title, description], index) => (
        <button
          class:list={['process-step', index === 0 && 'is-open']}
          type="button"
          aria-expanded={index === 0 ? 'true' : 'false'}
        >
          <span class="process-step__head">
            <span class="process-step__num">{String(index + 1).padStart(2, '0')}</span>
            <span class="process-step__title">{title}</span>
            <span class="process-step__icon" aria-hidden="true">+</span>
          </span>
          <span class="process-step__body">
            <span>{description}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const steps = [...document.querySelectorAll('.process-step')];
    steps.forEach((step) => {
      step.addEventListener('click', () => {
        const willOpen = !step.classList.contains('is-open');
        steps.forEach((item) => {
          item.classList.remove('is-open');
          item.setAttribute('aria-expanded', 'false');
        });
        if (willOpen) {
          step.classList.add('is-open');
          step.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

<style>
  .process-list {
    border-top: 1px solid rgba(28, 25, 23, 0.12);
  }

  .process-step {
    display: block;
    width: 100%;
    border-bottom: 1px solid rgba(28, 25, 23, 0.12);
    background: transparent;
    text-align: left;
  }

  .process-step__head {
    display: grid;
    min-height: 92px;
    grid-template-columns: 54px 1fr 40px;
    align-items: center;
    gap: 16px;
  }

  .process-step__num {
    color: #78716C;
    font-family: "DM Mono", monospace;
    font-size: 12px;
    transition: color 0.3s var(--ease-standard);
  }

  .process-step__title {
    font-size: clamp(1.55rem, 3.4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.98;
    transition: color 0.3s var(--ease-standard);
  }

  .process-step__icon {
    justify-self: end;
    color: #78716C;
    font-size: 32px;
    line-height: 1;
    transition: color 0.3s var(--ease-standard), transform 0.5s var(--ease-premium);
  }

  .process-step__body {
    display: grid;
    grid-template-rows: 0fr;
    color: #44403C;
    font-size: 15px;
    line-height: 1.75;
    padding-left: 70px;
    padding-right: 52px;
    transition: grid-template-rows 0.6s var(--ease-premium), padding-bottom 0.6s var(--ease-premium);
  }

  .process-step__body > span {
    overflow: hidden;
  }

  .process-step:hover .process-step__title,
  .process-step.is-open .process-step__title,
  .process-step.is-open .process-step__num,
  .process-step.is-open .process-step__icon {
    color: #2D6A4F;
  }

  .process-step.is-open .process-step__icon {
    transform: rotate(45deg);
  }

  .process-step.is-open .process-step__body {
    grid-template-rows: 1fr;
    padding-bottom: 32px;
  }

  @media (max-width: 640px) {
    .process-step__head {
      grid-template-columns: 36px 1fr 28px;
      min-height: 78px;
    }

    .process-step__body {
      padding-left: 52px;
      padding-right: 0;
      font-size: 15px;
    }
  }
</style>
