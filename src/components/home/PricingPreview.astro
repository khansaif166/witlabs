---
const homepagePlans = [
  {
    service: 'Website Launch',
    name: 'Professional website',
    price: '₹11,999',
    suffix: 'one-time',
    cta: 'Start website package',
    note: '5 pages, mobile responsive, WhatsApp button, contact form, basic SEO, domain + hosting for year one.',
    visual: 'website',
    video: '/videos/Sleek black digital workspace with floating website mockups, browser windows, and mobile responsive previews with subtle green accent lights. Modern website homepage assembles itself layer by layer_ navigation appears, hero section slides i.mp4',
  },
  {
    service: 'Digital Marketing',
    name: 'Starter growth system',
    price: '₹17,999',
    suffix: '/month',
    cta: 'Start marketing package',
    note: 'Campaign setup, audience research, ad copywriting, weekly optimization, reports, and WhatsApp leads.',
    visual: 'marketing',
    video: '/videos/Black dashboard-like environment with floating ad campaign cards, audience targeting panels, social media post previews, keyword bubbles, lead notifications, and upward growth chart. Campaign elements activate one by one_ audience segments .mp4',
  },
];

function getHomepagePlanContactHref(plan: (typeof homepagePlans)[number]) {
  const params = new URLSearchParams();
  const priceLabel = `${plan.price} ${plan.suffix}`;
  const service = plan.service === 'Website Launch' ? 'Website Design' : 'Digital Marketing';
  const budget = plan.service === 'Website Launch' ? 'Under ₹15,000' : '₹15,000–₹30,000';

  params.set('plan', plan.name);
  params.set('service_interested_in', service);
  params.set('budget_range', budget);
  params.set('message', `I am interested in the ${plan.name} package (${priceLabel}) from the WitLabs home page. ${plan.note} Please share the next steps.`);

  return `/contact/?${params.toString()}`;
}
---

<section id="pricing-preview" class="pricing-preview bg-black px-4 pb-14 pt-6 text-white sm:px-6 lg:px-8 lg:pb-20 lg:pt-10">
  <div class="relative z-10 mx-auto max-w-[1080px]">
    <div class="pricing-preview__head reveal">
      <p class="section-kicker text-green-bright">Starter Pricing</p>
      <h2>Clear starter packages.</h2>
      <p>Two practical entry points for launching online or starting lead generation.</p>
    </div>

    <div class="pricing-stage reveal reveal-delay-2" data-pricing-stage>
      {homepagePlans.map((plan, index) => (
        <a
          class:list={['pricing-choice-card', index === 0 && 'is-active']}
          href={getHomepagePlanContactHref(plan)}
          data-pricing-card={index}
          style="--tilt-x:0deg; --tilt-y:0deg;"
          aria-label={`Contact WitLabs about the ${plan.name} package`}
        >
          <span class="pricing-choice-card__shine" aria-hidden="true"></span>

          <div class:list={['pricing-choice-card__visual', `pricing-choice-card__visual--${plan.visual}`]} aria-hidden="true">
            <video
              class="pricing-choice-card__video"
              src={plan.video}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
            {plan.visual === 'website' && <span class="site-badge">3 Day Launch</span>}
          </div>

          <div class="pricing-choice-card__body">
            <p>{plan.service}</p>
            <h3>{plan.name}</h3>
            <div class="pricing-choice-card__price">
              <strong>{plan.price}</strong>
              <span>{plan.suffix}</span>
            </div>
            <span class="pricing-choice-card__note">{plan.note}</span>
            <span class="pricing-choice-card__cta">{plan.cta} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>

    <div class="pricing-preview__footer reveal reveal-delay-3">
      <span>Transparent scope</span>
      <span>Fast launch path</span>
      <span>No hidden charges</span>
    </div>

    <div class="pricing-preview__actions reveal reveal-delay-3">
      <a class="pricing-preview__button" href="/pricing/">
        View other packages <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const cards = [...document.querySelectorAll('[data-pricing-card]')];
    if (!cards.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeIndex = 0;
    let autoplay;

    const setActive = (index) => {
      activeIndex = index;
      cards.forEach((card, cardIndex) => {
        card.classList.toggle('is-active', cardIndex === index);
      });
    };

    const start = () => {
      if (reducedMotion) return;
      window.clearInterval(autoplay);
      autoplay = window.setInterval(() => {
        setActive((activeIndex + 1) % cards.length);
      }, 3600);
    };

    cards.forEach((card, index) => {
      card.addEventListener('pointerenter', () => {
        window.clearInterval(autoplay);
        setActive(index);
      });

      card.addEventListener('pointermove', (event) => {
        if (reducedMotion || !(card instanceof HTMLElement)) return;
        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.setProperty('--tilt-x', `${y * -6}deg`);
        card.style.setProperty('--tilt-y', `${x * 8}deg`);
      });

      card.addEventListener('pointerleave', () => {
        if (card instanceof HTMLElement) {
          card.style.setProperty('--tilt-x', '0deg');
          card.style.setProperty('--tilt-y', '0deg');
        }
        start();
      });

      card.addEventListener('focus', () => {
        window.clearInterval(autoplay);
        setActive(index);
      });

      card.addEventListener('blur', start);
    });

    start();
  })();
</script>

<style>
  .pricing-preview {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .pricing-preview::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 0%, rgba(74, 222, 128, 0.14), transparent 28%),
      linear-gradient(180deg, rgba(0, 0, 0, 0), #000000 18%, #000000);
  }

  .pricing-preview__head {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .pricing-preview__head h2 {
    margin-top: 14px;
    max-width: 620px;
    font-size: clamp(1.85rem, 3vw, 2.85rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.04;
  }

  .pricing-preview__head p:last-child {
    margin-top: 14px;
    max-width: 520px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .pricing-stage {
    margin-top: clamp(28px, 4vw, 46px);
    display: grid;
    gap: clamp(16px, 2vw, 24px);
    perspective: 1600px;
  }

  .pricing-choice-card {
    position: relative;
    display: grid;
    min-height: clamp(340px, 30vw, 410px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: #050505;
    color: #FFFFFF;
    box-shadow: 0 28px 84px rgba(0, 0, 0, 0.46);
    transform:
      rotateX(var(--tilt-x))
      rotateY(var(--tilt-y))
      scale(var(--card-scale, 1));
    transform-style: preserve-3d;
    transition:
      transform 0.65s var(--ease-premium),
      border-color 0.35s var(--ease-standard),
      box-shadow 0.65s var(--ease-premium);
  }

  .pricing-choice-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 34%, rgba(0, 0, 0, 0.42) 54%, #000000 82%),
      linear-gradient(90deg, transparent, rgba(74, 222, 128, 0.12), transparent);
    opacity: 0.88;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-standard);
  }

  .pricing-choice-card:hover,
  .pricing-choice-card:focus-visible,
  .pricing-choice-card.is-active {
    --card-scale: 1.018;
    border-color: rgba(74, 222, 128, 0.58);
    box-shadow: 0 36px 96px rgba(0, 0, 0, 0.64), 0 0 0 1px rgba(74, 222, 128, 0.18);
    outline: none;
  }

  .pricing-choice-card:hover::after,
  .pricing-choice-card:focus-visible::after,
  .pricing-choice-card.is-active::after {
    opacity: 0.72;
  }

  .pricing-choice-card__shine {
    position: absolute;
    top: 0;
    left: -70%;
    z-index: 4;
    width: 42%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.14), transparent);
    transform: skewX(-18deg);
    pointer-events: none;
  }

  .pricing-choice-card:hover .pricing-choice-card__shine,
  .pricing-choice-card:focus-visible .pricing-choice-card__shine,
  .pricing-choice-card.is-active .pricing-choice-card__shine {
    animation: cardShine 1.15s var(--ease-premium);
  }

  .pricing-choice-card__visual {
    position: relative;
    min-height: 170px;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 70%),
      #050505;
  }

  .pricing-choice-card__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.58)),
      linear-gradient(90deg, rgba(0, 0, 0, 0.18), transparent 45%, rgba(0, 0, 0, 0.2));
    pointer-events: none;
  }

  .pricing-choice-card__video {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    opacity: 0.82;
    filter: saturate(0.98) brightness(0.78);
