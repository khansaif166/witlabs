    transition: transform 0.75s var(--ease-premium), filter 0.45s var(--ease-standard), opacity 0.45s var(--ease-standard);
  }

  .pricing-choice-card:hover .pricing-choice-card__video,
  .pricing-choice-card:focus-visible .pricing-choice-card__video,
