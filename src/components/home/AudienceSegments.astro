---
const segments = [
  {
    audience: 'Interior Designers & Construction Companies',
    keyMessage: 'Show your projects better. Get more serious enquiries.',
    problem: 'Strong project work can still lose high-value leads when the online portfolio, local visibility, and enquiry handling feel weak.',
    solution: 'Portfolio-focused websites, Google visibility, Meta and Google campaigns, WhatsApp lead routing, and lead tracking systems.',
    tools: ['Portfolio website', 'Local SEO', 'Ads', 'WhatsApp routing', 'Lead tracking'],
    image: '/images/case-studies/al-khair-hero.jpg',
  },
  {
    audience: 'Clinics & Healthcare Providers',
    keyMessage: 'Help patients find, trust, and contact your clinic faster.',
    problem: 'Patients search before visiting, and weak websites, Google profiles, reviews, or appointment flows can reduce trust.',
    solution: 'Clinic websites, local SEO, Google Business Profile support, appointment forms, WhatsApp enquiry flows, and treatment campaigns.',
    tools: ['Clinic website', 'Google profile', 'Local SEO', 'Appointments', 'Treatment campaigns'],
    image: '/images/mockup.png',
  },
  {
    audience: 'Real Estate Agents & Developers',
    keyMessage: 'Turn property interest into faster site visit enquiries.',
    problem: 'Property leads go cold quickly when buyers do not get clear project details, fast WhatsApp response, or proper follow-up.',
    solution: 'Project landing pages, Google and Meta ads, WhatsApp lead routing, enquiry tracking, and follow-up systems.',
    tools: ['Landing pages', 'Meta ads', 'Google ads', 'WhatsApp routing', 'Follow-up'],
    image: '/images/case-studies/impact-packaging-hero.jpg',
  },
  {
    audience: 'Manufacturers & B2B Suppliers',
    keyMessage: 'Make your manufacturing business easier for buyers to trust.',
    problem: 'Serious B2B buyers may not enquire if products, capabilities, trust signals, and enquiry options are unclear.',
    solution: 'Professional product and service websites, SEO-ready pages, catalogue sections, enquiry forms, and B2B lead systems.',
    tools: ['Product pages', 'Catalogues', 'SEO pages', 'Enquiry forms', 'B2B leads'],
    image: '/images/case-studies/impact-packaging.jpg',
  },
  {
    audience: 'Coaching Institutes & Training Centers',
    keyMessage: 'Get more admission enquiries with a stronger digital presence.',
    problem: 'Parents and students compare institutes online, so unclear course information and poor follow-up can reduce admissions.',
    solution: 'Admission-focused websites, landing pages, Google and Meta campaigns, WhatsApp follow-up, enquiry forms, and student-friendly systems.',
    tools: ['Admission pages', 'Course clarity', 'Campaigns', 'WhatsApp follow-up', 'Enquiry forms'],
    image: '/images/case-studies/kota-experts-hero.jpg',
  },
];

const cardPositions = [-700, -350, 0, 350, 700];
const tabletPositions = [-520, -260, 0, 260, 520];
const closedPositions = [0, -18, 18, -32, 32];
const rotations = [0, -3, 2, -4, 4];
const spreadDelays = [0, 70, 140, 210, 280];
---

<section id="audience-systems" class="audience-section bg-white text-ink" data-audience-section>
  <div class="audience-shell mx-auto max-w-[1440px] px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="audience-intro">
      <p class="section-kicker reveal text-green">Built For High-Intent Leads</p>
      <h2 class="reveal reveal-delay-1 mt-4 font-semibold text-ink">
        Industries We Grow
      </h2>
      <p class="reveal reveal-delay-2 mx-auto mt-5 max-w-2xl text-base leading-7 text-ink-light sm:text-lg">
        Websites, visibility, campaigns, and follow-up systems for businesses where every enquiry matters.
      </p>
    </div>

    <div class="audience-deck-wrap reveal reveal-delay-3 mt-10 lg:mt-12">
      <div class="audience-deck" data-audience-deck>
        {segments.map((segment, index) => (
          <article
            class="audience-card"
            data-audience-card
            data-card-label={`${String(index + 1).padStart(2, '0')} / ${segment.audience}`}
            style={`--open-x:${cardPositions[index]}px; --tablet-x:${tabletPositions[index]}px; --closed-x:${closedPositions[index]}px; --card-rotate:${rotations[index]}deg; --card-z:${segments.length - index}; --spread-delay:${spreadDelays[index]}ms; --mobile-index:${index};`}
            tabindex="0"
          >
            <img src={segment.image} alt="" loading={index < 2 ? 'eager' : 'lazy'} />
            <div class="audience-card__shade"></div>

            <div class="audience-card__content">
              <div class="audience-card__top">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{segment.audience}</p>
              </div>

              <h3>{segment.keyMessage}</h3>
              <p class="audience-card__problem">{segment.problem}</p>
              <p class="audience-card__solution">{segment.solution}</p>

              <div class="audience-card__tools" aria-label={`Systems for ${segment.audience}`}>
                {segment.tools.map((tool) => <span>{tool}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="audience-deck-status">
        <span class="audience-dot" aria-hidden="true"></span>
        <span id="audience-card-status">01 / Interior Designers & Construction Companies</span>
      </div>
    </div>

    <div class="audience-cta reveal mt-10">
      <p>Move across the gallery to explore the industries. Pick your market, and we will map the website, traffic, and follow-up system around how your customers decide.</p>
      <a class="premium-button premium-button-primary" href="/contact/">Plan My Lead System</a>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-audience-section]');
    const deck = document.querySelector('[data-audience-deck]');
    const cards = [...document.querySelectorAll('[data-audience-card]')];
    const status = document.getElementById('audience-card-status');
    if (!section || !deck || cards.length === 0) return;
    let currentDrift = 0;
    let targetDrift = 0;
    let driftFrame = 0;

    const setDrift = (value) => {
      targetDrift = value;
      if (driftFrame) return;

      const tick = () => {
        currentDrift += (targetDrift - currentDrift) * 0.14;
        if (Math.abs(targetDrift - currentDrift) < 0.4) currentDrift = targetDrift;
        deck.style.setProperty('--deck-drift', `${currentDrift.toFixed(2)}px`);

        if (currentDrift === targetDrift) {
          driftFrame = 0;
          return;
        }

        driftFrame = window.requestAnimationFrame(tick);
      };

      driftFrame = window.requestAnimationFrame(tick);
    };

    const setActive = (card) => {
      cards.forEach((item) => item.classList.toggle('is-active', item === card));
      if (status && card.dataset.cardLabel) status.textContent = card.dataset.cardLabel;
    };

    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => setActive(card));
      card.addEventListener('focus', () => setActive(card));
    });

    deck.addEventListener('pointermove', (event) => {
      if (!section.classList.contains('is-spread') || window.innerWidth < 900) return;
      const progress = (event.clientX / window.innerWidth - 0.5) * 2;
      const deadZone = Math.abs(progress) < 0.12 ? 0 : progress;
      setDrift(deadZone * -300);
    });

    deck.addEventListener('pointerleave', () => {
      setDrift(0);
    });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      section.classList.add('is-spread');
      section.classList.add('has-settled');
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          window.setTimeout(() => {
            section.classList.add('is-spread');
            window.setTimeout(() => section.classList.add('has-settled'), 1450);
          }, 420);
          observer.disconnect();
        }
      },
      { threshold: 0.48, rootMargin: '0px 0px -8% 0px' }
    );

    observer.observe(deck);
  })();
</script>

<style>
  .audience-section {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(28, 25, 23, 0.08);
  }

  .audience-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(rgba(45, 106, 79, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(45, 106, 79, 0.08) 1px, transparent 1px);
    background-size: 25vw 220px;
    mask-image: linear-gradient(180deg, transparent, #000 12%, #000 82%, transparent);
  }

  .audience-section::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 230px;
    width: min(1280px, 120vw);
    aspect-ratio: 1;
    border: 1px solid rgba(45, 106, 79, 0.12);
    border-radius: 50%;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .audience-shell {
    position: relative;
    z-index: 1;
  }

  .audience-intro {
    margin: 0 auto;
    max-width: 780px;
    text-align: center;
  }

  .audience-intro .section-kicker {
    justify-content: center;
  }

  .audience-intro h2 {
    font-size: clamp(3rem, 7vw, 7.25rem);
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .audience-deck-wrap {
    position: relative;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
  }

  .audience-deck {
    --deck-drift: 0px;
    position: relative;
    min-height: 640px;
    overflow: visible;
    background: transparent;
    isolation: isolate;
  }

  .audience-card {
    position: absolute;
    top: 54px;
    left: 50%;
    z-index: var(--card-z);
    display: block;
    height: 480px;
    width: clamp(260px, 23vw, 330px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    background: #101010;
    color: #FFFFFF;
    box-shadow: 0 78px 47px rgba(0, 0, 0, 0.05), 0 35px 35px rgba(0, 0, 0, 0.09), 0 9px 19px rgba(0, 0, 0, 0.1);
    transform: translate3d(calc(-50% + var(--closed-x)), 24px, 0) rotate(var(--card-rotate)) scale(0.94);
    transition: transform 1s var(--ease-premium), box-shadow 0.45s var(--ease-premium), z-index 0s linear 0.25s;
    will-change: transform;
    backface-visibility: hidden;
  }

  .audience-section.is-spread .audience-card {
    transform: translate3d(calc(-50% + var(--open-x) + var(--deck-drift)), 0, 0) rotate(0deg) scale(1);
    transition-delay: var(--spread-delay);
  }

  .audience-section.has-settled .audience-card {
    transition-duration: 0.42s;
    transition-timing-function: var(--ease-out);
    transition-delay: 0ms;
  }

  .audience-section.is-spread .audience-card:hover,
  .audience-section.is-spread .audience-card:focus-visible,
  .audience-section.is-spread .audience-card.is-active {
    z-index: 30;
    box-shadow: var(--shadow-lift);
    transform: translate3d(calc(-50% + var(--open-x) + var(--deck-drift)), -18px, 0) rotate(0deg) scale(1.035);
  }

  .audience-card img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04);
    transform: scale(1.05);
    transition: transform 0.8s var(--ease-out), filter 0.4s var(--ease-standard);
  }

  .audience-section.is-spread .audience-card:hover img,
  .audience-section.is-spread .audience-card:focus-visible img,
  .audience-section.is-spread .audience-card.is-active img {
    filter: saturate(1.04) contrast(1.06);
    transform: scale(1.1);
  }

  .audience-card__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.16), rgba(0, 0, 0, 0.12) 34%, rgba(0, 0, 0, 0.9)),
      linear-gradient(90deg, rgba(0, 0, 0, 0.54), transparent 58%);
  }

  .audience-card__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 22px;
  }

  .audience-card__top {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 20px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .audience-card__top span {
    color: #4ADE80;
    font-family: "DM Mono", monospace;
    font-size: 12px;
  }

  .audience-card__top p {
    max-width: 210px;
    color: rgba(255, 255, 255, 0.74);
    font-family: "DM Mono", monospace;
    font-size: 10px;
    line-height: 1.45;
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .audience-card h3 {
    font-size: clamp(1.8rem, 2.45vw, 2.85rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .audience-card__problem,
  .audience-card__solution {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.55s var(--ease-premium), opacity 0.35s var(--ease-standard), margin-top 0.35s var(--ease-standard);
  }

  .audience-section.is-spread .audience-card:hover .audience-card__problem,
  .audience-section.is-spread .audience-card:focus-visible .audience-card__problem,
  .audience-section.is-spread .audience-card.is-active .audience-card__problem {
    max-height: 130px;
    margin-top: 16px;
    opacity: 1;
  }

  .audience-section.is-spread .audience-card:hover .audience-card__solution,
  .audience-section.is-spread .audience-card:focus-visible .audience-card__solution {
    max-height: 140px;
    margin-top: 10px;
    opacity: 1;
  }

  .audience-card__problem {
    color: rgba(255, 255, 255, 0.78);
    font-size: 14px;
    line-height: 1.55;
  }

  .audience-card__solution {
    color: rgba(255, 255, 255, 0.58);
    font-size: 13px;
    line-height: 1.55;
  }

  .audience-card__tools {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .audience-card__tools span {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    padding: 7px 9px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 11px;
    font-weight: 600;
    backdrop-filter: blur(14px);
  }

  .audience-deck-status {
    position: absolute;
    bottom: 24px;
    left: 50%;
    z-index: 24;
    display: inline-flex;
    max-width: calc(100% - 32px);
    align-items: center;
    gap: 12px;
    border-radius: 999px;
    background: #101010;
    padding: 12px 16px;
    color: rgba(255, 255, 255, 0.78);
    font-family: "DM Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .audience-dot {
    height: 7px;
    width: 7px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: #4ADE80;
    box-shadow: 0 0 0 6px rgba(74, 222, 128, 0.16);
  }

  .audience-cta {
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-top: 1px solid rgba(28, 25, 23, 0.1);
    padding-top: 28px;
  }

  .audience-cta p {
    max-width: 760px;
    color: #44403C;
    font-size: 17px;
    line-height: 1.7;
  }

  .audience-cta .premium-button {
    align-self: flex-start;
  }

  @media (min-width: 900px) {
    .audience-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (max-width: 1120px) and (min-width: 900px) {
    .audience-deck {
      min-height: 600px;
    }

    .audience-card {
      width: clamp(238px, 24vw, 280px);
    }

    .audience-section.is-spread .audience-card {
      transform: translate3d(calc(-50% + var(--tablet-x) + var(--deck-drift)), 0, 0) rotate(0deg) scale(0.96);
    }

    .audience-section.is-spread .audience-card:hover,
    .audience-section.is-spread .audience-card:focus-visible,
    .audience-section.is-spread .audience-card.is-active {
      transform: translate3d(calc(-50% + var(--tablet-x) + var(--deck-drift)), -12px, 0) rotate(0deg) scale(1);
    }
  }

  @media (max-width: 899px) {
    .audience-section::before,
    .audience-section::after,
    .audience-deck-status {
      display: none;
    }

    .audience-deck {
      display: grid;
      min-height: 0;
      gap: 14px;
      overflow: visible;
      background: transparent;
    }

    .audience-deck-wrap {
      left: auto;
      width: auto;
      margin-left: 0;
    }

    .audience-card,
    .audience-section.is-spread .audience-card,
    .audience-card:hover,
    .audience-card:focus-visible,
    .audience-card.is-active {
      position: relative;
      top: auto;
      left: auto;
      height: min(540px, 120vw);
      width: 100%;
      transform: none;
    }

    .audience-card__problem,
    .audience-card__solution,
    .audience-card:hover .audience-card__problem,
    .audience-card:focus-visible .audience-card__problem,
    .audience-card.is-active .audience-card__problem,
    .audience-card:hover .audience-card__solution,
    .audience-card:focus-visible .audience-card__solution {
      max-height: none;
      opacity: 1;
    }

    .audience-card__problem {
      margin-top: 16px;
    }

    .audience-card__solution {
      margin-top: 10px;
    }
  }

  @media (max-width: 520px) {
    .audience-card__top {
      display: grid;
      justify-content: start;
    }

    .audience-card__top p {
      max-width: none;
      text-align: left;
    }

    .audience-card__content {
      padding: 18px;
    }

    .audience-card h3 {
      font-size: clamp(2rem, 10vw, 3rem);
    }
  }
</style>
