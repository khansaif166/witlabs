---
const segments = [
  {
    audience: 'Interior',
    keyMessage: 'Win Projects',
    image: '/images/card1.png',
  },
  {
    audience: 'Clinics',
    keyMessage: 'Build Trust',
    image: '/images/card2.png',
  },
  {
    audience: 'Property',
    keyMessage: 'Move Leads',
    image: '/images/card3.png',
  },
  {
    audience: 'B2B',
    keyMessage: 'Earn Buyers',
    image: '/images/card4.png',
  },
  {
    audience: 'Education',
    keyMessage: 'More Admissions',
    image: '/images/card5.png',
  },
];

const cardPositions = [-760, -380, 0, 380, 760];
const tabletPositions = [-560, -280, 0, 280, 560];
const closedPositions = [0, -18, 18, -32, 32];
const rotations = [0, -3, 2, -4, 4];
const spreadDelays = [0, 70, 140, 210, 280];
---

<section id="audience-systems" class="audience-section bg-white text-ink" data-audience-section>
  <div class="audience-shell mx-auto max-w-[1440px] px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="audience-intro">
      <p class="section-kicker reveal text-green">Built For Leads</p>
      <h2 class="reveal reveal-delay-1 mt-4 font-semibold text-ink">
        Built for your market.
      </h2>
      <p class="reveal reveal-delay-2 mx-auto mt-4 max-w-xl text-sm leading-6 text-ink-light sm:text-base">
        Clear systems for enquiry-driven businesses.
      </p>
    </div>

    <div class="audience-deck-wrap reveal reveal-delay-3 mt-10 lg:mt-12">
      <div class="audience-deck" data-audience-deck>
        {segments.map((segment, index) => (
          <article
            class="audience-card"
            data-audience-card
            data-card-label={`${String(index + 1).padStart(2, '0')} / ${segment.audience}`}
            style={`--open-x:${cardPositions[index]}px; --tablet-x:${tabletPositions[index]}px; --closed-x:${closedPositions[index]}px; --card-rotate:${rotations[index]}deg; --card-z:${segments.length - index}; --spread-delay:${spreadDelays[index]}ms; --mobile-index:${index};`}
            tabindex="0"
          >
            <img src={segment.image} alt="" loading={index < 2 ? 'eager' : 'lazy'} />
            <div class="audience-card__shade"></div>

            <div class="audience-card__content">
              <span>{segment.keyMessage}</span>
            </div>
          </article>
        ))}
      </div>

      <div class="audience-deck-status">
        <span class="audience-dot" aria-hidden="true"></span>
        <span id="audience-card-status">01 / Interior</span>
      </div>
    </div>

    <div class="audience-cta reveal mt-10">
      <p>Pick your market. We map the path to better enquiries.</p>
      <a class="premium-button premium-button-primary" href="/contact/">Plan My Lead System</a>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-audience-section]');
    const deck = document.querySelector('[data-audience-deck]');
    const cards = [...document.querySelectorAll('[data-audience-card]')];
    const status = document.getElementById('audience-card-status');
    if (!section || !deck || cards.length === 0) return;
    let currentDrift = 0;
    let targetDrift = 0;
    let driftFrame = 0;

    const setDrift = (value) => {
      targetDrift = value;
      if (driftFrame) return;

      const tick = () => {
        currentDrift += (targetDrift - currentDrift) * 0.14;
        if (Math.abs(targetDrift - currentDrift) < 0.4) currentDrift = targetDrift;
        deck.style.setProperty('--deck-drift', `${currentDrift.toFixed(2)}px`);

        if (currentDrift === targetDrift) {
          driftFrame = 0;
          return;
        }

        driftFrame = window.requestAnimationFrame(tick);
      };

      driftFrame = window.requestAnimationFrame(tick);
    };

    const canInteract = () => section.classList.contains('has-settled') || window.innerWidth < 900;

    const setActive = (card) => {
      if (!canInteract()) return;
      cards.forEach((item) => item.classList.toggle('is-active', item === card));
      if (status && card.dataset.cardLabel) status.textContent = card.dataset.cardLabel;
    };

    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => setActive(card));
      card.addEventListener('focus', () => setActive(card));
    });

    deck.addEventListener('pointermove', (event) => {
      if (!section.classList.contains('has-settled') || window.innerWidth < 900) return;
      const progress = (event.clientX / window.innerWidth - 0.5) * 2;
      const deadZone = Math.abs(progress) < 0.12 ? 0 : progress;
      setDrift(deadZone * -300);
    });

    deck.addEventListener('pointerleave', () => {
      setDrift(0);
    });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      section.classList.add('is-spread');
      section.classList.add('has-settled');
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          window.setTimeout(() => {
            section.classList.add('is-spread');
            window.setTimeout(() => section.classList.add('has-settled'), 1450);
          }, 420);
          observer.disconnect();
        }
      },
      { threshold: 0.48, rootMargin: '0px 0px -8% 0px' }
    );

    observer.observe(deck);
  })();
</script>

<style>
  .audience-section {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(28, 25, 23, 0.08);
  }

  .audience-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(rgba(45, 106, 79, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(45, 106, 79, 0.08) 1px, transparent 1px);
    background-size: 25vw 220px;
    mask-image: linear-gradient(180deg, transparent, #000 12%, #000 82%, transparent);
  }

  .audience-section::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 230px;
    width: min(1280px, 120vw);
    aspect-ratio: 1;
    border: 1px solid rgba(45, 106, 79, 0.12);
    border-radius: 50%;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .audience-shell {
    position: relative;
    z-index: 1;
  }

  .audience-intro {
    margin: 0 auto;
    max-width: 780px;
    text-align: center;
  }

  .audience-intro .section-kicker {
    justify-content: center;
  }

  .audience-intro h2 {
    font-size: clamp(2.15rem, 4.4vw, 4.3rem);
    letter-spacing: -0.045em;
    line-height: 0.96;
  }

  .audience-deck-wrap {
    position: relative;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
  }

  .audience-deck {
    --deck-drift: 0px;
    position: relative;
    min-height: 640px;
    overflow: visible;
    background: transparent;
    isolation: isolate;
  }

  .audience-card {
    position: absolute;
    top: 54px;
    left: 50%;
    z-index: var(--card-z);
    display: block;
    aspect-ratio: 1086 / 1448;
    width: clamp(285px, 22vw, 360px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    background: #101010;
    color: #FFFFFF;
    box-shadow: 0 78px 47px rgba(0, 0, 0, 0.05), 0 35px 35px rgba(0, 0, 0, 0.09), 0 9px 19px rgba(0, 0, 0, 0.1);
    transform: translate3d(calc(-50% + var(--closed-x)), 24px, 0) rotate(var(--card-rotate)) scale(0.94);
    transition: transform 1s var(--ease-premium), box-shadow 0.45s var(--ease-premium), z-index 0s linear 0.25s;
    will-change: transform;
    backface-visibility: hidden;
  }

  .audience-section.is-spread .audience-card {
    transform: translate3d(calc(-50% + var(--open-x) + var(--deck-drift)), 0, 0) rotate(0deg) scale(1);
    transition-delay: var(--spread-delay);
  }

  .audience-section.has-settled .audience-card {
    transition-duration: 0.42s;
    transition-timing-function: var(--ease-out);
    transition-delay: 0ms;
  }

  .audience-section.is-spread:not(.has-settled) .audience-card {
    pointer-events: none;
  }

  .audience-section.has-settled .audience-card:hover,
  .audience-section.has-settled .audience-card:focus-visible,
  .audience-section.has-settled .audience-card.is-active {
    z-index: 30;
    box-shadow: var(--shadow-lift);
    transform: translate3d(calc(-50% + var(--open-x) + var(--deck-drift)), -18px, 0) rotate(0deg) scale(1.035);
  }

  .audience-card img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.92) contrast(1.04);
    transform: scale(1);
    transition: transform 0.8s var(--ease-out), filter 0.4s var(--ease-standard);
  }

  .audience-section.has-settled .audience-card:hover img,
  .audience-section.has-settled .audience-card:focus-visible img,
  .audience-section.has-settled .audience-card.is-active img {
    filter: saturate(1.04) contrast(1.06);
    transform: scale(1.015);
  }

  .audience-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 58%, rgba(0, 0, 0, 0.32));
  }

  .audience-card__content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 24px;
  }

  .audience-card__content span {
    max-width: 7ch;
    color: #ffffff;
    font-size: clamp(1.65rem, 2.4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-shadow: 0 12px 34px rgba(0, 0, 0, 0.42);
  }

  .audience-deck-status {
    position: absolute;
    bottom: 24px;
    left: 50%;
    z-index: 24;
    display: inline-flex;
    max-width: calc(100% - 32px);
    align-items: center;
    gap: 12px;
    border-radius: 999px;
    background: #101010;
    padding: 12px 16px;
    color: rgba(255, 255, 255, 0.78);
    font-family: "DM Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .audience-dot {
    height: 7px;
    width: 7px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: #4ADE80;
    box-shadow: 0 0 0 6px rgba(74, 222, 128, 0.16);
  }

  .audience-cta {
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-top: 1px solid rgba(28, 25, 23, 0.1);
    padding-top: 28px;
  }

  .audience-cta p {
    max-width: 760px;
    color: #44403C;
    font-size: 15px;
    line-height: 1.7;
  }

  .audience-cta .premium-button {
    align-self: flex-start;
  }

  @media (min-width: 900px) {
    .audience-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (max-width: 1120px) and (min-width: 900px) {
    .audience-deck {
      min-height: 600px;
    }

    .audience-card {
      width: clamp(238px, 24vw, 280px);
    }

    .audience-section.is-spread .audience-card {
      transform: translate3d(calc(-50% + var(--tablet-x) + var(--deck-drift)), 0, 0) rotate(0deg) scale(0.96);
    }

    .audience-section.has-settled .audience-card:hover,
    .audience-section.has-settled .audience-card:focus-visible,
    .audience-section.has-settled .audience-card.is-active {
      transform: translate3d(calc(-50% + var(--tablet-x) + var(--deck-drift)), -12px, 0) rotate(0deg) scale(1);
    }
  }

  @media (max-width: 899px) {
    .audience-section::before,
    .audience-section::after,
    .audience-deck-status {
      display: none;
    }

    .audience-deck {
      display: grid;
      min-height: 0;
      gap: 14px;
      overflow: visible;
      background: transparent;
    }

    .audience-deck-wrap {
      left: auto;
      width: auto;
      margin-left: 0;
    }

    .audience-card,
    .audience-section.is-spread .audience-card,
    .audience-card:hover,
    .audience-card:focus-visible,
    .audience-card.is-active {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      transform: none;
    }

  }

  @media (max-width: 520px) {
    .audience-card__content {
      padding: 18px;
    }

    .audience-card__content span {
      font-size: clamp(1.65rem, 8vw, 2.45rem);
    }
  }
</style>
