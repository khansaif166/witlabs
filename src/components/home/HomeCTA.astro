---
const whatsappHref = 'https://wa.me/917984301015?text=Hi%20WitLabs%2C%20I%20visited%20your%20website%20and%20I%27d%20like%20to%20discuss%20a%20project.';
---

<section class="py-section bg-green text-white">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <p class="reveal text-label text-white/50">LET'S BUILD SOMETHING GREAT</p>
      <h2 class="reveal reveal-delay-1 mt-4 text-display-md text-white text-balance">
        Ready to grow your business online?
      </h2>
      <p class="reveal reveal-delay-2 text-body-lg text-white/70 mt-4 mb-10">
        Book a free 20-minute strategy call. No sales pitch. Just honest advice about what will work for your business.
      </p>

      <div class="reveal reveal-delay-3 flex justify-center gap-4 flex-wrap">
        <a class="bg-white text-green rounded-full px-8 py-4 font-medium hover:bg-cream transition-colors" href="/contact/">
          Book a Free Strategy Call →
        </a>
        <a class="border-2 border-white/30 text-white rounded-full px-8 py-4 font-medium hover:bg-white/10 transition-colors" href={whatsappHref} target="_blank" rel="noreferrer">
          WhatsApp Us
        </a>
      </div>

      <p class="reveal reveal-delay-4 mt-8 text-white/50 text-caption">
        Reply within 2 hours on working days · No contracts, no lock-in
      </p>
    </div>
  </div>
</section>
