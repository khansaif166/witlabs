---
const testimonials = [
  {
    initials: 'AK',
    name: 'Founder',
    role: 'AL KHAIR INTERIORS',
    company: 'Interior Design',
    quote: 'WitLabs built us something we are genuinely proud to show clients. It looks professional, loads fast and the inquiries have improved since we launched.',
  },
  {
    initials: 'IP',
    name: 'Director',
    role: 'IMPACT PACKAGING',
    company: 'Manufacturing',
    quote: 'Professional, reliable and focused on actual outcomes. WitLabs understood our B2B requirements without us having to explain everything ten times. Great team to work with.',
  },
  {
    initials: 'KE',
    name: 'Founder',
    role: 'KOTA EXPERTS',
    company: 'Education',
    quote: 'Student inquiries from our website improved after WitLabs redesigned it and set up our Google presence. Best digital investment we have made for the institute.',
  },
];
---

<section class="bg-cream-dark py-24">
  <div class="container">
    <div class="mb-10">
      <p class="eyebrow reveal">Client Words</p>
      <h2 class="reveal delay-1 mt-3 font-serif text-[clamp(2.2rem,4.5vw,4rem)] italic leading-[1.05] text-ink">
        From the businesses<br />we've helped grow.
      </h2>
    </div>

    <div>
      {testimonials.map((item, index) => (
        <figure class:list={['reveal grid gap-8 border-b border-border py-10 md:grid-cols-[200px_1fr] md:gap-10', index > 0 && `delay-${index}`]}>
          <figcaption>
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-green-light font-semibold text-green">{item.initials}</div>
            <p class="mt-3 font-medium text-ink">{item.name}</p>
            <p class="mt-1 font-mono text-[11px] text-muted">{item.role}</p>
            <span class="mt-3 inline-flex rounded-full border border-border bg-cream px-3 py-1.5 font-mono text-[10px] text-ink">{item.company}</span>
          </figcaption>
          <blockquote>
            <span class="block font-serif text-7xl leading-none text-ink/[0.08]" aria-hidden="true">"</span>
            <p class="font-serif text-xl italic leading-[1.6] text-ink">{item.quote}</p>
            <p class="mt-6 text-sm text-green" aria-label="5 out of 5 stars">★★★★★</p>
          </blockquote>
        </figure>
      ))}
    </div>
  </div>
</section>
