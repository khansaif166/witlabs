---
const testimonials = [
  {
    company: 'Al Khair Interiors',
    avatar: 'AK',
    avatarClass: 'bg-green-light text-green',
    quote: 'WitLabs built us a website we are genuinely proud to show clients. It looks professional, loads fast and the inquiries have improved since launch. Exactly what our business needed.',
    name: '[Client Name]',
    role: 'Founder, Al Khair Interiors · Interior Design',
  },
  {
    company: 'Impact Packaging',
    avatar: 'IP',
    avatarClass: 'bg-warm-light text-warm',
    quote: 'Professional, reliable and focused on actual outcomes. WitLabs understood our B2B requirements without us having to explain everything ten times. Great team to work with.',
    name: '[Client Name]',
    role: 'Director, Impact Packaging · Manufacturing',
  },
  {
    company: 'Kota Experts',
    avatar: 'KE',
    avatarClass: 'bg-blue-100 text-blue-700',
    quote: 'Student inquiries from our website improved after WitLabs redesigned it and set up our Google presence. Best digital investment we have made for the institute.',
    name: '[Client Name]',
    role: 'Founder, Kota Experts · Education',
  },
];
---

<section class="py-section bg-cream">
  <div class="container">
    <div class="max-w-3xl">
      <p class="eyebrow reveal">WHAT OUR CLIENTS SAY</p>
      <h2 class="reveal reveal-delay-1 mt-3 text-display-md text-balance">Words from the businesses we've helped.</h2>
    </div>

    <div class="testimonial-slider reveal relative mt-12 overflow-hidden">
      <input id="testimonial-1" class="sr-only" type="radio" name="testimonial" checked />
      <input id="testimonial-2" class="sr-only" type="radio" name="testimonial" />
      <input id="testimonial-3" class="sr-only" type="radio" name="testimonial" />

      <div class="testimonial-track flex transition-transform duration-500">
        {testimonials.map((testimonial) => (
          <article class="min-w-full">
            <div class="relative bg-white rounded-3xl p-8 md:p-10 border border-border shadow-sm">
              <span class="absolute top-6 right-8 text-8xl leading-none text-green/20 font-serif" aria-hidden="true">"</span>
              <blockquote class="relative max-w-4xl text-body-lg text-ink-light leading-relaxed">
                {testimonial.quote}
              </blockquote>

              <div class="mt-8 flex items-center gap-4">
                <div class:list={['w-12 h-12 rounded-full flex items-center justify-center font-semibold', testimonial.avatarClass]}>
                  {testimonial.avatar}
                </div>
                <div>
                  <p class="font-semibold text-body-md text-ink">{testimonial.name}</p>
                  <p class="text-caption text-muted">{testimonial.role}</p>
                </div>
                <p class="ml-auto hidden text-muted/30 text-label md:block">{testimonial.company}</p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-8 flex justify-center gap-3">
        <label class="h-3 w-3 cursor-pointer rounded-full bg-border transition-colors" for="testimonial-1" aria-label="Show Al Khair Interiors testimonial"></label>
        <label class="h-3 w-3 cursor-pointer rounded-full bg-border transition-colors" for="testimonial-2" aria-label="Show Impact Packaging testimonial"></label>
        <label class="h-3 w-3 cursor-pointer rounded-full bg-border transition-colors" for="testimonial-3" aria-label="Show Kota Experts testimonial"></label>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonial-slider:has(#testimonial-1:checked) .testimonial-track {
    transform: translateX(0);
  }

  .testimonial-slider:has(#testimonial-2:checked) .testimonial-track {
    transform: translateX(-100%);
  }

  .testimonial-slider:has(#testimonial-3:checked) .testimonial-track {
    transform: translateX(-200%);
  }

  .testimonial-slider:has(#testimonial-1:checked) label[for='testimonial-1'],
  .testimonial-slider:has(#testimonial-2:checked) label[for='testimonial-2'],
  .testimonial-slider:has(#testimonial-3:checked) label[for='testimonial-3'] {
    background: #2d6a4f;
  }
</style>
