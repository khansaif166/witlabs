---
const services = [
  {
    name: 'Website Design',
    href: '/services/#website-design',
    tags: ['Websites', 'UX', 'Speed'],
    desc: 'Premium websites that help visitors understand, trust, and contact your business faster.',
    greatFor: 'Service businesses, local brands, consultants',
    stat: '3 sec',
    statLabel: 'clarity test',
  },
  {
    name: 'SEO Growth',
    href: '/services/#seo',
    tags: ['Local SEO', 'Content', 'Search'],
    desc: 'Search foundations, pages, and content systems built around what customers actually look for.',
    greatFor: 'Clinics, institutes, home services, B2B',
    stat: '90d',
    statLabel: 'growth sprints',
  },
  {
    name: 'Digital Marketing',
    href: '/services/#digital-marketing',
    tags: ['Funnels', 'Social', 'Email'],
    desc: 'Campaigns that make your business visible, memorable, and easier to choose.',
    greatFor: 'Founders who need consistent demand',
    stat: '1',
    statLabel: 'clear pipeline',
  },
  {
    name: 'Performance Ads',
    href: '/services/#performance',
    tags: ['Google', 'Meta', 'Tracking'],
    desc: 'Paid campaigns with cleaner landing pages, measurement, and conversion feedback loops.',
    greatFor: 'Lead generation and offer testing',
    stat: 'ROI',
    statLabel: 'first thinking',
  },
  {
    name: 'Apps & Systems',
    href: '/services/#app-development',
    tags: ['Apps', 'Dashboards', 'Tools'],
    desc: 'Useful digital products for teams that need less manual work and better customer experiences.',
    greatFor: 'Internal tools and customer portals',
    stat: '0',
    statLabel: 'busywork goal',
  },
  {
    name: 'Automation & AI',
    href: '/services/#automation',
    tags: ['AI', 'Chatbots', 'Workflow'],
    desc: 'Automation, chatbots, and AI workflows that capture leads and reduce repetitive operations.',
    greatFor: 'Lean teams and growing founders',
    stat: '24/7',
    statLabel: 'lead capture',
  },
];
---

<section id="what-we-build" class="section-shell bg-cream text-ink">
  <div class="mx-auto max-w-[1440px]">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
      <div>
        <p class="section-kicker reveal text-green">Grow Your Business</p>
        <h2 class="reveal reveal-delay-1 mt-4 display-tight text-[clamp(3.2rem,7vw,7.5rem)] font-semibold">
          Everything your business needs online.
        </h2>
      </div>
      <p class="reveal reveal-delay-2 max-w-xl text-lg leading-8 text-ink-light lg:justify-self-end">
        Squarespace sells the confidence of an all-in-one platform. WitLabs should do the same: show that your brand, website, traffic, leads, and systems can be handled as one connected growth engine.
      </p>
    </div>

    <div class="services-tabs reveal reveal-delay-3 mt-12" role="tablist" aria-label="WitLabs services">
      {services.map((service, index) => (
        <button
          class:list={['services-tab', index === 0 && 'is-active']}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`service-panel-${index}`}
          id={`service-tab-${index}`}
          data-service-tab={index}
        >
          {service.name}
        </button>
      ))}
    </div>

    <div class="services-stage mt-8">
      {services.map((service, index) => (
        <article
          id={`service-panel-${index}`}
          class:list={['service-panel', index === 0 && 'is-active']}
          role="tabpanel"
          aria-labelledby={`service-tab-${index}`}
          data-service-panel={index}
        >
          <div class="service-visual">
            <div class="service-browser" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="service-mock">
              <div class="service-mock__hero"></div>
              <div class="service-mock__grid">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="service-mock__line"></div>
              <div class="service-mock__line short"></div>
            </div>
          </div>

          <div class="service-content">
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-green">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="mt-4 text-[clamp(2.25rem,5vw,5rem)] font-semibold tracking-[-0.06em]">{service.name}</h3>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-ink-light">{service.desc}</p>

            <div class="mt-8 flex flex-wrap gap-2">
              {service.tags.map((tag) => <span class="service-tag">{tag}</span>)}
            </div>

            <div class="mt-10 grid gap-5 sm:grid-cols-[180px_1fr]">
              <div class="service-stat">
                <strong>{service.stat}</strong>
                <span>{service.statLabel}</span>
              </div>
              <div class="service-fit">
                <span>Great for</span>
                <strong>{service.greatFor}</strong>
              </div>
            </div>

            <a class="arrow-link mt-10 text-green" href={service.href}>Explore this service <span class="arrow">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const tabs = [...document.querySelectorAll('[data-service-tab]')];
    const panels = [...document.querySelectorAll('[data-service-panel]')];

    const setActive = (index) => {
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });

      panels.forEach((panel, panelIndex) => {
        panel.classList.toggle('is-active', panelIndex === index);
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => setActive(index));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const next = event.key === 'ArrowRight'
          ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;
        tabs[next]?.focus();
        setActive(next);
      });
    });
  })();
</script>

<style>
  .services-tabs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
  }

  .services-tabs::-webkit-scrollbar {
    display: none;
  }

  .services-tab {
    flex: 0 0 auto;
    border: 1px solid rgba(28, 25, 23, 0.12);
    border-radius: 999px;
    background: transparent;
    padding: 10px 16px;
    color: rgba(28, 25, 23, 0.62);
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.3s var(--ease-standard), color 0.3s var(--ease-standard), border-color 0.3s var(--ease-standard);
  }

  .services-tab:hover,
  .services-tab.is-active {
    border-color: #1C1917;
    background: #1C1917;
    color: #FFFFFF;
  }

  .services-stage {
    position: relative;
    min-height: 680px;
    overflow: hidden;
    border-radius: 8px;
    background: #FFFFFF;
    box-shadow: inset 0 0 0 1px rgba(28, 25, 23, 0.08);
  }

  .service-panel {
    pointer-events: none;
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 64px);
    opacity: 0;
    padding: clamp(24px, 5vw, 72px);
    transform: translateY(24px);
    transition: opacity 0.35s var(--ease-standard), transform 0.65s var(--ease-premium), visibility 0.35s step-end;
    visibility: hidden;
  }

  .service-panel.is-active {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.45s var(--ease-standard), transform 0.75s var(--ease-premium), visibility 0.35s step-start;
    visibility: visible;
  }

  .service-visual {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    border-radius: 8px;
    background:
      radial-gradient(circle at 25% 20%, rgba(74, 222, 128, 0.24), transparent 28%),
      linear-gradient(135deg, #101010, #2D6A4F);
  }

  .service-browser {
    position: absolute;
    top: 20px;
    left: 20px;
    display: flex;
    gap: 8px;
  }

  .service-browser span {
    height: 9px;
    width: 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.42);
  }

  .service-mock {
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: min(430px, 86%);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.94);
    padding: 18px;
    box-shadow: var(--shadow-lift);
    transform: rotate(-2deg);
  }

  .service-mock__hero {
    height: 160px;
    border-radius: 6px;
    background: linear-gradient(135deg, #0F0F0F, #52A67A);
  }

  .service-mock__grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .service-mock__grid span,
  .service-mock__line {
    display: block;
    border-radius: 5px;
    background: #EDE9E2;
  }

  .service-mock__grid span {
    height: 62px;
  }

  .service-mock__line {
    margin-top: 14px;
    height: 12px;
  }

  .service-mock__line.short {
    width: 62%;
  }

  .service-tag {
    border-radius: 999px;
    background: #EEF4F1;
    padding: 8px 12px;
    color: #2D6A4F;
    font-family: "DM Mono", monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .service-stat,
  .service-fit {
    border-top: 1px solid rgba(28, 25, 23, 0.1);
    padding-top: 16px;
  }

  .service-stat strong {
    display: block;
    font-size: 48px;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .service-stat span,
  .service-fit span {
    margin-top: 6px;
    display: block;
    color: #78716C;
    font-family: "DM Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .service-fit strong {
    margin-top: 8px;
    display: block;
    font-size: 18px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .services-stage {
      min-height: 920px;
    }

    .service-panel {
      grid-template-columns: 1fr;
      align-content: start;
    }

    .service-visual {
      min-height: 320px;
    }
  }

  @media (max-width: 520px) {
    .services-stage {
      min-height: 980px;
    }

    .service-panel {
      padding: 20px;
    }
  }
</style>
