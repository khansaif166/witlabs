---
const services = [
  {
    name: 'Website Design',
    href: '/services/#website-design',
    tags: ['Websites', 'UX', 'Speed'],
    desc: 'Clear sites that turn attention into trust.',
    greatFor: 'Service brands',
    stat: '3 sec',
    statLabel: 'clarity test',
    image: '/images/web-deign.png',
  },
  {
    name: 'SEO Growth',
    href: '/services/#seo',
    tags: ['Local SEO', 'Content', 'Search'],
    desc: 'Rank where buyers already search.',
    greatFor: 'Local and B2B teams',
    stat: '90d',
    statLabel: 'growth sprints',
    image: '/images/SEO-growth.png',
  },
  {
    name: 'Digital Marketing',
    href: '/services/#digital-marketing',
    tags: ['Content', 'Social', 'Launches'],
    desc: 'Make your brand easier to choose.',
    greatFor: 'Growing brands',
    image: '/images/Digital.png',
  },
  {
    name: 'Apps & Systems',
    href: '/services/#app-development',
    tags: ['Apps', 'Dashboards', 'Tools'],
    desc: 'Tools that remove daily friction.',
    greatFor: 'Internal tools',
    image: '/images/Apps.png',
  },
  {
    name: 'Automation & AI',
    href: '/services/#automation',
    tags: ['AI', 'Chatbots', 'Workflow'],
    desc: 'Automate leads, replies, and tasks.',
    greatFor: 'Lean teams',
    image: '/images/AI.png',
  },
];

const getServicePosition = (index: number) => {
  const offset = index % services.length;
  return offset > services.length / 2 ? offset - services.length : offset;
};
---

<section id="what-we-build" class="section-shell services-section bg-cream text-ink">
  <div class="mx-auto max-w-[1440px]">
    <div class="services-intro">
      <p class="section-kicker reveal text-green">What We Do</p>
      <h2 class="reveal reveal-delay-1 mt-4 display-tight font-semibold">
        Digital work that feels clear.
      </h2>
      <p class="reveal reveal-delay-2">
        Websites, growth, apps, and AI without the noise.
      </p>
    </div>

    <div class="services-tabs reveal reveal-delay-3 mt-12" role="tablist" aria-label="WitLabs services">
      <span class="services-tabs__indicator" aria-hidden="true"></span>
      {services.map((service, index) => (
        <button
          class:list={['services-tab', index === 0 && 'is-active']}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`service-panel-${index}`}
          id={`service-tab-${index}`}
          data-service-tab={index}
        >
          {service.name}
        </button>
      ))}
    </div>

    <div class="services-carousel mt-10" data-services-carousel>
      <div class="services-viewport" aria-live="polite">
        <div class="services-track" data-services-track>
          {services.map((service, index) => (
            <article
              id={`service-panel-${index}`}
              class:list={['service-card', index === 0 && 'is-active']}
              role="tabpanel"
              aria-labelledby={`service-tab-${index}`}
              tabindex={index === 0 ? '0' : '-1'}
              data-service-panel={index}
              data-service-card={index}
              data-service-position={getServicePosition(index)}
            >
              <img
                src={service.image}
                alt={`${service.name} service preview`}
                class="service-card__image"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="service-card__shade"></div>
              <div class="service-card__content">
                <p class="service-card__count">{String(index + 1).padStart(2, '0')}</p>
                <h3>{service.name}</h3>
                <p>{service.desc}</p>

                <div class="service-card__tags">
                  {service.tags.map((tag) => <span class="service-tag">{tag}</span>)}
                </div>

                <div class="service-card__meta">
                  <span>Great for: {service.greatFor}</span>
                  <a href={service.href} aria-label={`Explore ${service.name}`}>→</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const tabs = [...document.querySelectorAll('[data-service-tab]')];
    const panels = [...document.querySelectorAll('[data-service-panel]')];
    const carousel = document.querySelector('[data-services-carousel]');
    const tabsContainer = document.querySelector('.services-tabs');
    const indicator = document.querySelector('.services-tabs__indicator');
    const AUTO_ADVANCE_MS = 4000;
    let activeIndex = 0;
    let autoplay;
    let tabScrollFrame = 0;

    const moveIndicator = (tab) => {
      if (!(indicator instanceof HTMLElement) || !(tab instanceof HTMLElement)) return;
      indicator.style.width = `${tab.offsetWidth}px`;
      indicator.style.transform = `translate3d(${tab.offsetLeft}px, 0, 0)`;
    };

    const scrollActiveTabIntoView = (tab) => {
      if (!(tabsContainer instanceof HTMLElement) || !(tab instanceof HTMLElement)) return;
      const targetLeft = tab.offsetLeft - (tabsContainer.clientWidth - tab.offsetWidth) / 2;
      const startLeft = tabsContainer.scrollLeft;
      const maxLeft = tabsContainer.scrollWidth - tabsContainer.clientWidth;
      const endLeft = Math.min(Math.max(0, targetLeft), Math.max(0, maxLeft));
      const distance = endLeft - startLeft;

      window.cancelAnimationFrame(tabScrollFrame);
      if (Math.abs(distance) < 1) return;

      const duration = 900;
      const startTime = performance.now();
      const ease = (progress) => 1 - Math.pow(1 - progress, 3);

      const tick = (now) => {
        const progress = Math.min((now - startTime) / duration, 1);
        tabsContainer.scrollLeft = startLeft + distance * ease(progress);

        if (progress < 1) {
          tabScrollFrame = window.requestAnimationFrame(tick);
          return;
        }

        tabScrollFrame = 0;
      };

      tabScrollFrame = window.requestAnimationFrame(tick);
    };

    const setActive = (index) => {
      activeIndex = index;

      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.setAttribute('tabindex', active ? '0' : '-1');
      });

      panels.forEach((panel, panelIndex) => {
        const offset = (panelIndex - index + panels.length) % panels.length;
        const position = offset > panels.length / 2 ? offset - panels.length : offset;
        panel.classList.toggle('is-active', panelIndex === index);
        panel.setAttribute('data-service-position', String(position));
        panel.setAttribute('aria-hidden', String(panelIndex !== index));
        panel.setAttribute('tabindex', Math.abs(position) <= 1 ? '0' : '-1');
      });

      moveIndicator(tabs[index]);
      scrollActiveTabIntoView(tabs[index]);
    };

    const startAutoplay = () => {
      window.clearInterval(autoplay);
      autoplay = window.setInterval(() => {
        setActive((activeIndex + 1) % panels.length);
      }, AUTO_ADVANCE_MS);
    };

    const restartAutoplay = () => {
      window.clearInterval(autoplay);
      startAutoplay();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        setActive(index);
        restartAutoplay();
      });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const next = event.key === 'ArrowRight'
          ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;
        tabs[next]?.focus();
        setActive(next);
        restartAutoplay();
      });
    });

    panels.forEach((panel, index) => {
      panel.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) return;
        if (index === activeIndex) return;
        setActive(index);
        restartAutoplay();
      });

      panel.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        if (index === activeIndex) return;
        event.preventDefault();
        setActive(index);
        restartAutoplay();
      });
    });

    carousel?.addEventListener('focusin', () => window.clearInterval(autoplay));
    carousel?.addEventListener('focusout', startAutoplay);
    window.addEventListener('resize', () => moveIndicator(tabs[activeIndex]));

    setActive(0);
    startAutoplay();
  })();
</script>

<style>
  .services-section {
    overflow: hidden;
  }

  .services-intro {
    display: grid;
    justify-items: center;
    gap: 0;
    text-align: center;
  }

  .services-intro h2 {
    max-width: 760px;
    font-size: clamp(1.95rem, 3.2vw, 3.25rem);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .services-intro p:last-child {
    margin-top: 18px;
    max-width: 600px;
    color: rgba(28, 25, 23, 0.62);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.75;
  }

  .services-tabs {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 12px;
    overflow-x: auto;
    margin-inline: calc(50% - 50vw);
    padding: 0 max(18px, calc((100vw - 1440px) / 2)) 4px;
    scrollbar-width: none;
    scroll-behavior: auto;
  }

  .services-tabs__indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    height: calc(100% - 4px);
    border-radius: 999px;
    background: #1C1917;
    opacity: 0;
    transform: translate3d(0, 0, 0);
    transition:
      transform 0.9s var(--ease-premium),
      width 0.9s var(--ease-premium),
      opacity 0.25s var(--ease-standard);
    pointer-events: none;
    will-change: transform, width;
  }

  .services-tabs::-webkit-scrollbar {
    display: none;
  }

  .services-tab {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    border: 1px solid rgba(28, 25, 23, 0.12);
    border-radius: 999px;
    background: transparent;
    padding: 12px 20px;
    color: rgba(28, 25, 23, 0.62);
    font-size: clamp(0.9rem, 1.15vw, 1rem);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 0.45s var(--ease-premium),
      color 0.45s var(--ease-premium),
      border-color 0.3s var(--ease-standard),
      transform 0.45s var(--ease-premium);
  }

  .services-tabs:has(.services-tab.is-active) .services-tabs__indicator {
    opacity: 1;
  }

  .services-tab:hover {
    border-color: rgba(28, 25, 23, 0.38);
    color: #1C1917;
    transform: translateY(-1px);
  }

  .services-tab.is-active {
    border-color: #1C1917;
    background: transparent;
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .services-carousel {
    overflow: hidden;
  }

  .services-viewport {
    position: relative;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    padding: 0 0 12px;
  }

  .services-track {
    --card-width: min(64vw, 960px);
    --card-gap: clamp(18px, 2.2vw, 34px);
    position: relative;
    min-height: clamp(420px, 38vw, 560px);
  }

  .service-card {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--card-width);
    min-height: clamp(420px, 38vw, 560px);
    overflow: hidden;
    border-radius: 8px;
    background: #1C1917;
    box-shadow: 0 22px 64px rgba(28, 25, 23, 0.12);
    transform:
      translateX(calc(-50% + (var(--service-position, 0) * (var(--card-width) + var(--card-gap)))))
      scale(0.94);
    transition:
      transform 2s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 2s ease,
      filter 2s ease,
      box-shadow 0.35s var(--ease-standard);
    opacity: 0;
    filter: saturate(0.82);
    cursor: pointer;
    pointer-events: none;
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
  }

  .service-card[data-service-position='-2'],
  .service-card[data-service-position='2'] {
    opacity: 0;
    pointer-events: none;
  }

  .service-card[data-service-position='-1'],
  .service-card[data-service-position='1'] {
    opacity: 0.5;
    pointer-events: auto;
  }

  .service-card[data-service-position='-1'] {
    --service-position: -1;
  }

  .service-card[data-service-position='0'] {
    --service-position: 0;
    z-index: 4;
  }

  .service-card[data-service-position='1'] {
    --service-position: 1;
  }

  .service-card[data-service-position='-2'] {
    --service-position: -2;
  }

  .service-card[data-service-position='2'] {
    --service-position: 2;
  }

  .service-card.is-active {
    transform: translateX(-50%) scale(1);
    opacity: 1;
    filter: saturate(1);
    cursor: default;
    pointer-events: auto;
  }

  .service-card:not(.is-active):hover,
  .service-card:not(.is-active):focus-visible {
    opacity: 0.78;
    filter: saturate(0.94) brightness(1.04);
    box-shadow: 0 32px 96px rgba(28, 25, 23, 0.2);
    outline: none;
  }

  .service-card__image {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 2s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .service-card.is-active .service-card__image {
    transform: scale(1.015);
  }

  .service-card:not(.is-active):hover .service-card__image,
  .service-card:not(.is-active):focus-visible .service-card__image {
    transform: scale(1.01);
  }

  .service-card__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 11, 10, 0.72), rgba(12, 11, 10, 0.12) 58%, rgba(12, 11, 10, 0.46)),
      linear-gradient(0deg, rgba(12, 11, 10, 0.7), transparent 50%);
  }

  .service-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(22px, 3.4vw, 44px);
    color: #FFFFFF;
  }

  .service-card__count {
    font-family: "DM Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.76);
  }

  .service-card__content h3 {
    margin-top: clamp(140px, 16vw, 220px);
    max-width: 720px;
    font-size: clamp(2rem, 3.3vw, 3.35rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.92;
  }

  .service-card__content p:not(.service-card__count) {
    margin-top: 16px;
    max-width: 520px;
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.5;
  }

  .service-card__tags {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .service-card__meta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding-top: 22px;
  }

  .service-card__meta span {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.9rem, 1vw, 1rem);
    font-weight: 600;
  }

  .service-card__meta a {
    display: grid;
    flex: 0 0 auto;
    height: 42px;
    width: 42px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    color: #FFFFFF;
    font-size: 24px;
    line-height: 1;
    transition: background-color 0.3s var(--ease-standard), color 0.3s var(--ease-standard), transform 0.3s var(--ease-standard);
  }

  .service-card__meta a:hover {
    background: #FFFFFF;
    color: #1C1917;
    transform: translateX(3px);
  }

  .service-tag {
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    padding: 7px 10px;
    color: #FFFFFF;
    font-family: "DM Mono", monospace;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    backdrop-filter: blur(18px);
  }

  @media (max-width: 900px) {
    .services-tabs {
      justify-content: flex-start;
    }

    .services-track {
      --card-width: min(82vw, 680px);
    }

    .service-card {
      min-height: 520px;
    }

    .service-card__content h3 {
      margin-top: 190px;
    }
  }

  @media (max-width: 520px) {
    .services-intro {
      justify-items: start;
      text-align: left;
    }

    .services-intro h2 {
      font-size: clamp(1.85rem, 9vw, 2.65rem);
    }

    .services-track {
      --card-width: calc(100vw - 36px);
      --card-gap: 14px;
    }

    .service-card {
      min-height: 500px;
    }

    .service-card__content {
      padding: 22px;
    }

    .service-card__content h3 {
      margin-top: 170px;
      font-size: clamp(1.65rem, 7vw, 2.15rem);
    }

    .service-card__meta {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-track,
    .service-card,
    .service-card__image {
      transition: none;
    }
  }
</style>
