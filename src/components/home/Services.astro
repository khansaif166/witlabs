---
const services = [
  {
    name: 'Website Design',
    href: '/services/#website-design',
    tags: ['Websites', 'UX', 'Speed'],
    desc: 'Premium websites that help visitors understand, trust, and contact your business faster.',
    greatFor: 'Service businesses, local brands, consultants',
    stat: '3 sec',
    statLabel: 'clarity test',
    image: '/images/web-deign.png',
  },
  {
    name: 'SEO Growth',
    href: '/services/#seo',
    tags: ['Local SEO', 'Content', 'Search'],
    desc: 'Search foundations, pages, and content systems built around what customers actually look for.',
    greatFor: 'Clinics, institutes, home services, B2B',
    stat: '90d',
    statLabel: 'growth sprints',
    image: '/images/SEO-growth.png',
  },
  {
    name: 'Digital Marketing',
    href: '/services/#digital-marketing',
    tags: ['Content', 'Social', 'Launches'],
    desc: 'Simple campaign systems that make your business visible, memorable, and easier to choose.',
    greatFor: 'Brands that need consistent demand',
    image: '/images/Digital.png',
  },
  {
    name: 'Apps & Systems',
    href: '/services/#app-development',
    tags: ['Apps', 'Dashboards', 'Tools'],
    desc: 'Useful digital products for teams that need less manual work and better customer experiences.',
    greatFor: 'Internal tools and customer portals',
    image: '/images/Apps.png',
  },
  {
    name: 'Automation & AI',
    href: '/services/#automation',
    tags: ['AI', 'Chatbots', 'Workflow'],
    desc: 'Automation, chatbots, and AI workflows that capture leads and reduce repetitive operations.',
    greatFor: 'Lean teams and growing founders',
    image: '/images/AI.png',
  },
];
---

<section id="what-we-build" class="section-shell services-section bg-cream text-ink">
  <div class="mx-auto max-w-[1440px]">
    <div class="services-intro">
      <p class="section-kicker reveal text-green">What We Do</p>
      <h2 class="reveal reveal-delay-1 mt-4 display-tight font-semibold">
        One clean system for your website, growth, and operations.
      </h2>
      <p class="reveal reveal-delay-2">
        Pick the area you need help with. Each service is built to feel clear, polished, and useful from the first visit to the final enquiry.
      </p>
    </div>

    <div class="services-tabs reveal reveal-delay-3 mt-12" role="tablist" aria-label="WitLabs services">
      {services.map((service, index) => (
        <button
          class:list={['services-tab', index === 0 && 'is-active']}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`service-panel-${index}`}
          id={`service-tab-${index}`}
          data-service-tab={index}
        >
          {service.name}
        </button>
      ))}
    </div>

    <div class="services-carousel mt-10" data-services-carousel>
      <div class="services-viewport" aria-live="polite">
        <div class="services-track" data-services-track>
          {services.map((service, index) => (
            <article
              id={`service-panel-${index}`}
              class:list={['service-card', index === 0 && 'is-active']}
              role="tabpanel"
              aria-labelledby={`service-tab-${index}`}
              tabindex={index === 0 ? '0' : '-1'}
              data-service-panel={index}
              data-service-card={index}
            >
              <img
                src={service.image}
                alt={`${service.name} service preview`}
                class="service-card__image"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="service-card__shade"></div>
              <div class="service-card__content">
                <p class="service-card__count">{String(index + 1).padStart(2, '0')}</p>
                <h3>{service.name}</h3>
                <p>{service.desc}</p>

                <div class="service-card__tags">
                  {service.tags.map((tag) => <span class="service-tag">{tag}</span>)}
                </div>

                <div class="service-card__meta">
                  <span>Great for: {service.greatFor}</span>
                  <a href={service.href} aria-label={`Explore ${service.name}`}>→</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const tabs = [...document.querySelectorAll('[data-service-tab]')];
    const panels = [...document.querySelectorAll('[data-service-panel]')];
    const carousel = document.querySelector('[data-services-carousel]');
    const track = document.querySelector('[data-services-track]');
    const AUTO_ADVANCE_MS = 4000;
    let activeIndex = 0;
    let autoplay;

    const setActive = (index) => {
      activeIndex = index;

      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.setAttribute('tabindex', active ? '0' : '-1');
      });

      panels.forEach((panel, panelIndex) => {
        panel.classList.toggle('is-active', panelIndex === index);
        panel.setAttribute('aria-hidden', String(panelIndex !== index));
        panel.setAttribute('tabindex', panelIndex === index ? '0' : '-1');
      });

      track?.style.setProperty('--active-index', String(index));
      tabs[index]?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    };

    const startAutoplay = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      window.clearInterval(autoplay);
      autoplay = window.setInterval(() => {
        setActive((activeIndex + 1) % panels.length);
      }, AUTO_ADVANCE_MS);
    };

    const restartAutoplay = () => {
      window.clearInterval(autoplay);
      startAutoplay();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        setActive(index);
        restartAutoplay();
      });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const next = event.key === 'ArrowRight'
          ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;
        tabs[next]?.focus();
        setActive(next);
        restartAutoplay();
      });
    });

    panels.forEach((panel, index) => {
      panel.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) return;
        if (index === activeIndex) return;
        setActive(index);
        restartAutoplay();
      });

      panel.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        if (index === activeIndex) return;
        event.preventDefault();
        setActive(index);
        restartAutoplay();
      });
    });

    carousel?.addEventListener('mouseenter', () => window.clearInterval(autoplay));
    carousel?.addEventListener('mouseleave', startAutoplay);
    carousel?.addEventListener('focusin', () => window.clearInterval(autoplay));
    carousel?.addEventListener('focusout', startAutoplay);

    setActive(0);
    startAutoplay();
  })();
</script>

<style>
  .services-section {
    overflow: hidden;
  }

  .services-intro {
    display: grid;
    justify-items: center;
    gap: 0;
    text-align: center;
  }

  .services-intro h2 {
    max-width: 980px;
    font-size: clamp(2.8rem, 6vw, 6.4rem);
    letter-spacing: 0;
    line-height: 0.96;
  }

  .services-intro p:last-child {
    margin-top: 22px;
    max-width: 660px;
    color: rgba(28, 25, 23, 0.62);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.75;
  }

  .services-tabs {
    display: flex;
    justify-content: center;
    gap: 12px;
    overflow-x: auto;
    margin-inline: calc(50% - 50vw);
    padding: 0 max(18px, calc((100vw - 1440px) / 2)) 4px;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  .services-tabs::-webkit-scrollbar {
    display: none;
  }

  .services-tab {
    flex: 0 0 auto;
    border: 1px solid rgba(28, 25, 23, 0.12);
    border-radius: 999px;
    background: transparent;
    padding: 14px 22px;
    color: rgba(28, 25, 23, 0.62);
    font-size: clamp(0.9rem, 1.15vw, 1rem);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 0.3s var(--ease-standard),
      color 0.3s var(--ease-standard),
      border-color 0.3s var(--ease-standard),
      transform 0.3s var(--ease-standard);
  }

  .services-tab:hover,
  .services-tab.is-active {
    border-color: #1C1917;
    background: #1C1917;
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .services-carousel {
    overflow: hidden;
  }

  .services-viewport {
    position: relative;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    padding: 0 0 12px;
  }

  .services-track {
    --active-index: 0;
    --card-width: min(74vw, 1120px);
    --card-gap: clamp(18px, 2vw, 30px);
    display: flex;
    gap: var(--card-gap);
    padding-inline: calc((100vw - var(--card-width)) / 2);
    transform: translateX(calc(var(--active-index) * -1 * (var(--card-width) + var(--card-gap))));
    transition: transform 0.85s var(--ease-premium);
    will-change: transform;
  }

  .service-card {
    position: relative;
    flex: 0 0 var(--card-width);
    min-height: clamp(500px, 52vw, 680px);
    overflow: hidden;
    border-radius: 8px;
    background: #1C1917;
    box-shadow: 0 28px 80px rgba(28, 25, 23, 0.12);
    transform: scale(0.94);
    transition:
      transform 0.95s var(--ease-premium),
      opacity 0.5s var(--ease-standard),
      filter 0.5s var(--ease-standard),
      box-shadow 0.35s var(--ease-standard);
    opacity: 0.5;
    filter: saturate(0.82);
    cursor: pointer;
  }

  .service-card.is-active {
    transform: scale(1);
    opacity: 1;
    filter: saturate(1);
    cursor: default;
  }

  .service-card:not(.is-active):hover,
  .service-card:not(.is-active):focus-visible {
    opacity: 0.78;
    filter: saturate(0.94) brightness(1.04);
    transform: scale(0.965) translateY(-4px);
    box-shadow: 0 32px 96px rgba(28, 25, 23, 0.2);
    outline: none;
  }

  .service-card__image {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-premium);
  }

  .service-card.is-active .service-card__image {
    transform: scale(1.025);
  }

  .service-card:not(.is-active):hover .service-card__image,
  .service-card:not(.is-active):focus-visible .service-card__image {
    transform: scale(1.02);
  }

  .service-card__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 11, 10, 0.8), rgba(12, 11, 10, 0.18) 58%, rgba(12, 11, 10, 0.54)),
      linear-gradient(0deg, rgba(12, 11, 10, 0.78), transparent 48%);
  }

  .service-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(24px, 4vw, 52px);
    color: #FFFFFF;
  }

  .service-card__count {
    font-family: "DM Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.76);
  }

  .service-card__content h3 {
    margin-top: clamp(190px, 21vw, 270px);
    max-width: 820px;
    font-size: clamp(2.6rem, 4.6vw, 5rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.92;
  }

  .service-card__content p:not(.service-card__count) {
    margin-top: 20px;
    max-width: 620px;
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(1rem, 1.35vw, 1.35rem);
    line-height: 1.55;
  }

  .service-card__tags {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .service-card__meta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding-top: 30px;
  }

  .service-card__meta span {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    font-weight: 600;
  }

  .service-card__meta a {
    display: grid;
    flex: 0 0 auto;
    height: 48px;
    width: 48px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    color: #FFFFFF;
    font-size: 28px;
    line-height: 1;
    transition: background-color 0.3s var(--ease-standard), color 0.3s var(--ease-standard), transform 0.3s var(--ease-standard);
  }

  .service-card__meta a:hover {
    background: #FFFFFF;
    color: #1C1917;
    transform: translateX(3px);
  }

  .service-tag {
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    padding: 8px 12px;
    color: #FFFFFF;
    font-family: "DM Mono", monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    backdrop-filter: blur(18px);
  }

  @media (max-width: 900px) {
    .services-tabs {
      justify-content: flex-start;
    }

    .services-track {
      --card-width: min(84vw, 720px);
    }

    .service-card {
      min-height: 600px;
    }

    .service-card__content h3 {
      margin-top: 220px;
    }
  }

  @media (max-width: 520px) {
    .services-intro {
      justify-items: start;
      text-align: left;
    }

    .services-intro h2 {
      font-size: clamp(2.5rem, 15vw, 4.2rem);
    }

    .services-track {
      --card-width: calc(100vw - 36px);
      --card-gap: 14px;
    }

    .service-card {
      min-height: 560px;
    }

    .service-card__content {
      padding: 22px;
    }

    .service-card__content h3 {
      margin-top: 200px;
      font-size: clamp(2.35rem, 12vw, 3.2rem);
    }

    .service-card__meta {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-track,
    .service-card,
    .service-card__image {
      transition: none;
    }
  }
</style>
