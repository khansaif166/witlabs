---
const services = [
  { name: 'Website Design & Development', href: '/services/#website-design', tags: ['Web', 'Design'], desc: 'Websites built to convert visitors into inquiries' },
  { name: 'SEO & Organic Growth', href: '/services/#seo', tags: ['SEO', 'Growth'], desc: 'Rank above competitors on Google searches' },
  { name: 'Digital Marketing', href: '/services/#digital-marketing', tags: ['Marketing', 'Ads'], desc: 'Campaigns that build brand and generate leads' },
  { name: 'Performance Marketing', href: '/services/#performance', tags: ['Google Ads', 'Meta'], desc: 'ROI-focused Google & Meta ad management' },
  { name: 'App Development', href: '/services/#app-development', tags: ['iOS', 'Android'], desc: 'Custom mobile apps built for your business' },
  { name: 'Branding & Identity', href: '/services/#branding', tags: ['Brand', 'Logo'], desc: 'A brand that makes you instantly trustworthy' },
  { name: 'Automation', href: '/services/#automation', tags: ['Workflow', 'AI'], desc: 'Save 10+ hours a week with smart systems' },
  { name: 'AI Chatbots', href: '/services/#chatbots', tags: ['Chatbot', 'AI'], desc: "24/7 lead capture even when you're offline" },
];
---

<section class="bg-cream py-24">
  <div class="container">
    <div class="mb-16 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow reveal">What We Build</p>
        <h2 class="reveal delay-1 mt-3 font-serif text-[clamp(2.2rem,4.5vw,4rem)] italic leading-[1.05] text-ink">
          Everything your<br />business needs online.
        </h2>
      </div>
      <div class="reveal delay-2 font-mono text-[11px] text-muted md:text-right">
        8 services available
        <a class="ml-2 font-sans text-sm font-medium text-green hover:text-ink" href="/services/">View all →</a>
      </div>
    </div>

    <div class="hidden md:block">
      {services.map((service, index) => (
        <a class="service-row group reveal" href={service.href}>
          <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
          <span class="service-main">
            <span class="block text-xl font-medium text-ink">{service.name}</span>
            <span class="service-desc">{service.desc}</span>
          </span>
          <span class="flex flex-wrap justify-end gap-2">
            {service.tags.map((tag) => <span class="service-tag">{tag}</span>)}
          </span>
          <span class="service-plus">+</span>
        </a>
      ))}
    </div>

    <div class="grid gap-4 md:hidden">
      {services.map((service, index) => (
        <a class="rounded-2xl border border-border bg-white p-5 transition-colors active:border-green active:bg-green-light" href={service.href}>
          <div class="flex items-start gap-4">
            <span class="font-mono text-[12px] text-muted">{String(index + 1).padStart(2, '0')}</span>
            <div class="flex-1">
              <h3 class="text-xl font-medium text-ink">{service.name}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{service.desc}</p>
              <div class="mt-4 flex gap-2">
                {service.tags.map((tag) => <span class="rounded bg-cream-dark px-2 py-1 font-mono text-[10px] text-muted">{tag}</span>)}
              </div>
            </div>
            <span class="text-green">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll('.service-row').forEach((row) => {
      row.addEventListener('mouseenter', () => row.classList.add('expanded'));
      row.addEventListener('mouseleave', () => row.classList.remove('expanded'));
    });
  })();
</script>

<style>
  .service-row {
    display: grid;
    min-height: 72px;
    grid-template-columns: 48px 1fr 200px 48px;
    align-items: center;
    border-bottom: 1px solid rgba(28, 25, 23, 0.08);
    color: #1C1917;
    transition: min-height 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), background 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color 0.35s ease, padding 0.35s ease;
  }

  .service-row:first-child {
    border-top: 1px solid rgba(28, 25, 23, 0.08);
  }

  .service-row.expanded {
    min-height: 120px;
    border-color: rgba(45, 106, 79, 0.2);
    background: #EEF4F1;
    padding-bottom: 16px;
  }

  .service-number {
    font-family: "DM Mono", monospace;
    font-size: 12px;
    color: #78716C;
    transition: color 0.35s ease;
  }

  .service-row.expanded .service-number,
  .service-row.expanded .service-plus {
    color: #2D6A4F;
  }

  .service-main {
    align-self: center;
    transition: align-self 0.35s ease, padding-top 0.35s ease;
  }

  .service-row.expanded .service-main {
    align-self: start;
    padding-top: 28px;
  }

  .service-desc {
    display: block;
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    color: #44403C;
    font-size: 14px;
    transition: opacity 0.25s ease, max-height 0.35s ease, margin-top 0.35s ease;
  }

  .service-row.expanded .service-desc {
    margin-top: 8px;
    max-height: 28px;
    opacity: 1;
  }

  .service-tag {
    border-radius: 4px;
    background: #EDE9E2;
    padding: 0.25rem 0.5rem;
    color: #78716C;
    font-family: "DM Mono", monospace;
    font-size: 10px;
    transition: background 0.35s ease, color 0.35s ease;
  }

  .service-row.expanded .service-tag {
    background: rgba(45, 106, 79, 0.1);
    color: #2D6A4F;
  }

  .service-plus {
    justify-self: end;
    color: #78716C;
    font-size: 1.5rem;
    line-height: 1;
    transition: color 0.35s ease, transform 0.35s ease;
  }

  .service-row.expanded .service-plus {
    transform: rotate(45deg);
  }
</style>
