---
const projects = [
  {
    title: 'Impact Packaging Solutions',
    type: 'Business Website',
    url: 'https://impactpackagingsolutions.com',
    domain: 'impactpackagingsolutions.com',
    image: '/images/projects/impact-packaging.jpg',
    eyebrow: 'Packaging company presence',
    description: 'A business website shaped to make industrial capabilities easier to understand and easier to trust.',
    proof: [
      'What changed: clearer capability presentation for industrial buyers',
      'Scope: positioning, page structure, inquiry-focused presentation',
    ],
    tags: ['Industrial B2B', 'Custom Specs', 'Fast Quote'],
    theme: 'sand',
  },
  {
    title: 'The Daffodil Group',
    type: 'Corporate Website',
    url: 'https://thedaffodilgroup.com',
    domain: 'thedaffodilgroup.com',
    image: '/images/projects/the-daffodil-group.jpg',
    eyebrow: 'Editorial company website',
    description: 'A premium corporate presence for a multi-venture group that needed stronger structure and credibility.',
    proof: [
      'What changed: moved from generic company copy to sharper group-level storytelling',
      'Scope: information architecture, editorial tone, premium presentation',
    ],
    tags: ['Editorial Press', 'Brand Authority', 'Custom Layouts'],
    theme: 'ember',
  },
  {
    title: 'Dream NEET Academy',
    type: 'Full LMS Platform',
    url: 'https://dreamneetacademy.com',
    domain: 'dreamneetacademy.com',
    image: '/images/projects/dream-neet.jpg',
    eyebrow: 'Website plus LMS',
    description: 'A complete LMS-facing experience with public presentation, learning structure, and student-facing product depth.',
    proof: [
      'What changed: from brochure presence to a fuller product-style learning experience',
      'Scope: website plus learning flow structure and student UX',
    ],
    tags: ['Full LMS', 'Student Portal', 'High Concurrency'],
    theme: 'green',
  },
  {
    title: 'Aswad Global',
    type: 'Business Website',
    url: 'https://aswadglobal.com',
    domain: 'aswadglobal.com',
    image: '/images/projects/aswad-global.webp',
    eyebrow: 'Global business presence',
    description: 'A business-facing website designed to communicate credibility, intent, and a stronger international profile.',
    proof: [
      'What changed: stronger trust and clearer business presentation for serious prospects',
      'Scope: identity expression, offer clarity, responsive website build',
    ],
    tags: ['Global Trade', 'Multi-Region', 'B2B Presence'],
    theme: 'violet',
  },
  {
    title: 'Wasat Constructions',
    type: 'Turnkey Construction Platform',
    url: 'https://www.wasatconstructions.com',
    domain: 'wasatconstructions.com',
    image: '/images/projects/wasat-constructions.jpg',
    theme: 'sand',
    eyebrow: 'Turnkey builder presence',
    description: 'A transparent construction platform built to showcase turnkey residential projects, transparent package pricing, and structured site consultation bookings across Bangalore.',
    proof: [
      'What changed: shifted from offline contractor presence to transparent per-sq-ft cost breakdowns and neighbourhood case studies',
      'Scope: information architecture, transparent pricing guides, project portfolio, and WhatsApp lead flow',
    ],
    tags: ['17+ Years', 'ISO 9001', 'Turnkey Model'],
  },
  {
    title: 'WitLabs',
    type: 'Agency Website',
    url: 'https://witlabs.in',
    domain: 'witlabs.in',
    image: '/images/projects/witlabs.jpg',
    imagePosition: 'object-center',
    eyebrow: 'Our own digital presence',
    description: 'Our own website, used as a live example of tighter positioning, clearer service framing, and conversion-first structure.',
    proof: [
      'What changed: narrowed the message around websites, SEO, and lead systems',
      'Scope: positioning, proof hierarchy, and CTA architecture',
    ],
    tags: ['Websites', 'SEO Systems', 'Lead Engines'],
    theme: 'olive',
  },
  {
    title: 'Sustainly Green',
    type: 'B2B Marketplace & Directory',
    url: 'https://www.sustainlygreen.com',
    domain: 'sustainlygreen.com',
    image: '/images/projects/sustainly-green.jpg',
    theme: 'green',
    eyebrow: 'Sustainable procurement directory',
    description: 'A structured B2B sustainability directory and marketplace designed to connect Indian enterprises directly with verified eco-friendly suppliers and green manufacturers.',
    proof: [
      'What changed: organized fragmented green suppliers into a searchable category-based directory with zero-commission vendor inquiry paths',
      'Scope: B2B directory architecture, category filtering, supplier profile layouts, and direct lead capture',
    ],
    tags: ['ESG Verified', '0% Brokerage', 'Direct RFQ'],
  },
];
---

<section class="project-showcase" id="digitized-with-witlabs" aria-labelledby="digitized-with-witlabs-title">
  <div class="project-showcase__noise" aria-hidden="true"></div>
  <div class="project-showcase__shell">
    <div class="showcase-heading reveal">
      <p class="showcase-kicker">Selected work</p>
      <h2 class="showcase-title" id="digitized-with-witlabs-title">
        What changed after <span>WitLabs</span>
      </h2>
      <p class="showcase-intro">
        Real projects with clearer scope. Not just how they looked, but what the website needed to do better for the buyer journey.
      </p>
    </div>

    <div class="showcase-grid reveal reveal-delay-1" id="project-showcase-grid">
      {projects.map((project, index) => (
        <a
          class={`showcase-card showcase-card--${project.theme} group ${index >= 6 ? 'is-hidden' : ''}`}
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${project.title} project`}
          data-hidden={index >= 6 ? 'true' : 'false'}
        >
          {/* Browser Window Header */}
          <div class="showcase-card__header">
            <div class="browser-dots" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="browser-domain-pill">{project.domain}</div>
          </div>

          {/* Image Frame with 16:9 Aspect Ratio */}
          <div class="showcase-card__image-container">
            <img 
              src={project.image} 
              alt={`${project.title} project preview`} 
              loading="lazy"
              class={`w-full aspect-video object-cover ${project.imagePosition || 'object-left-top'} origin-top-left transition-transform duration-500 group-hover:scale-105`} 
            />
            <div class="showcase-card__image-overlay"></div>
          </div>

          {/* Card Content */}
          <div class="showcase-card__content">
            {/* Type and Title Row */}
            <div class="showcase-card__header-row">
              <span class="showcase-card__type">{project.type}</span>
            </div>
            <h3 class="showcase-card__title">
              {project.title}
              <span class="showcase-card__link-arrow" aria-hidden="true">↗</span>
            </h3>

            {/* Description */}
            <p class="showcase-card__description">{project.description}</p>

            {/* Impact/Proof Panel */}
            <div class="showcase-card__impact-panel">
              <div class="impact-point">
                <span class="impact-label">Shift:</span>
                <span class="impact-text">{project.proof[0]?.replace('What changed: ', '')}</span>
              </div>
              <div class="impact-point">
                <span class="impact-label">Scope:</span>
                <span class="impact-text">{project.proof[1]?.replace('Scope: ', '')}</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="showcase-toggle">
      <button
        id="toggle-projects"
        class="showcase-toggle__button"
        type="button"
        aria-expanded="false"
        aria-controls="project-showcase-grid"
      >
        View More Projects
      </button>
    </div>
  </div>
</section>

<style>
  .project-showcase {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at top center, rgba(255, 255, 255, 0.08), transparent 24%),
      linear-gradient(180deg, #161615 0%, #090909 22%, #050505 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    isolation: isolate;
  }

  .project-showcase::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.24), transparent 18%, transparent 80%, rgba(0, 0, 0, 0.45)),
      radial-gradient(circle at center, transparent 20%, rgba(0, 0, 0, 0.32) 66%, rgba(0, 0, 0, 0.72) 100%);
    z-index: 0;
  }

  .project-showcase__noise {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.05;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.22) 0.7px, transparent 0.7px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.1) 0.7px, transparent 0.7px);
    background-size: 4px 4px;
    mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.95), transparent 88%);
  }

  .project-showcase__shell {
    position: relative;
    z-index: 1;
    width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(4.75rem, 8vw, 6.75rem) 0 clamp(4rem, 6vw, 5.5rem);
  }

  .showcase-heading {
    max-width: 860px;
    margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
    text-align: center;
  }

  .showcase-kicker {
    margin: 0 0 0.8rem;
    color: rgba(255, 255, 255, 0.54);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .showcase-title {
    margin: 0;
    color: #fcfcfb;
    font-size: clamp(2.8rem, 7vw, 6rem);
    line-height: 0.93;
    letter-spacing: -0.075em;
    font-weight: 650;
    text-wrap: balance;
  }

  .showcase-title span {
    color: rgba(255, 255, 255, 0.28);
  }

  .showcase-intro {
    width: min(640px, 100%);
    margin: 1.25rem auto 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 1rem;
    line-height: 1.7;
    text-wrap: balance;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.9rem;
    align-items: start;
  }

  /* Card Layout */
  .showcase-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(14, 14, 14, 0.95);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.42);
    text-decoration: none;
    transition: transform 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
  }

  .showcase-card.is-hidden {
    display: none;
  }

  .showcase-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.5);
  }

  /* Browser Window Header */
  .showcase-card__header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(255, 255, 255, 0.02);
  }

  .browser-dots {
    display: flex;
    gap: 0.65rem;
  }

  .browser-dots span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
  }

  .browser-dots span:nth-child(1) {
    background: #ff6357;
  }

  .browser-dots span:nth-child(2) {
    background: #ffc13d;
  }

  .browser-dots span:nth-child(3) {
    background: #32d74b;
  }

  .browser-domain-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(10, 10, 10, 0.4);
    padding: 0.35rem 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    backdrop-filter: blur(12px);
  }

  /* Image Container - 16:9 Aspect Ratio */
  .showcase-card__image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-top: none;
  }

  .showcase-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 500ms ease;
  }

  .showcase-card:hover .showcase-card__image {
    transform: scale(1.05);
  }

  .showcase-card__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.3) 100%);
    pointer-events: none;
  }

  /* Content Section */
  .showcase-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1.35rem;
    flex: 1;
  }

  .showcase-card__header-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .showcase-card__type {
    display: inline-block;
    padding: 0.3rem 0.65rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .showcase-card__title {
    margin: 0;
    color: #fcfcfb;
    font-size: 1.35rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 650;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .showcase-card__link-arrow {
    font-size: 1.1rem;
    opacity: 0.6;
    transition: opacity 200ms ease;
  }

  .showcase-card:hover .showcase-card__link-arrow {
    opacity: 1;
  }

  .showcase-card__description {
    margin: 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.9rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Impact Panel */
  .showcase-card__impact-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 1.1rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(8px);
  }

  .impact-point {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .impact-label {
    color: rgba(255, 255, 255, 0.8);
    font-weight: 600;
    flex-shrink: 0;
  }

  .impact-text {
    color: rgba(255, 255, 255, 0.64);
  }

  .showcase-toggle {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .showcase-toggle__button {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.02);
    color: #f5f5f4;
    border-radius: 999px;
    padding: 0.9rem 1.55rem;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.03);
  }

  .showcase-toggle__button:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
  }

  .showcase-toggle__button:focus-visible {
    outline: 2px solid rgba(203, 255, 220, 0.8);
    outline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .project-showcase__shell {
      width: min(100% - 1.25rem, 42rem);
      padding: 4.25rem 0 4rem;
    }

    .showcase-heading {
      margin-bottom: 2rem;
      text-align: left;
    }

    .showcase-intro {
      margin-inline: 0;
      width: 100%;
      font-size: 0.96rem;
      text-wrap: pretty;
    }

    .showcase-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .showcase-card__header {
      padding: 0.9rem 1.1rem;
    }

    .browser-dots {
      gap: 0.45rem;
    }

    .browser-dots span {
      width: 0.65rem;
      height: 0.65rem;
    }

    .browser-domain-pill {
      font-size: 0.6rem;
      padding: 0.3rem 0.6rem;
    }

    .showcase-card__image-container {
      aspect-ratio: 16 / 9;
    }

    .showcase-card__content {
      padding: 1.2rem 1rem;
      gap: 0.6rem;
    }

    .showcase-card__title {
      font-size: 1.15rem;
    }

    .showcase-card__description {
      font-size: 0.85rem;
    }

    .showcase-card__impact-panel {
      padding: 0.9rem;
      gap: 0.6rem;
      margin-top: 0.5rem;
    }

    .impact-point {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  const toggleButton = document.querySelector('#toggle-projects');
  const hiddenCards = Array.from(document.querySelectorAll('.showcase-card.is-hidden'));

  if (toggleButton) {
    toggleButton.addEventListener('click', () => {
      const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
      toggleButton.setAttribute('aria-expanded', String(!isExpanded));

      hiddenCards.forEach((card) => {
        card.classList.toggle('is-hidden', isExpanded);
      });

      toggleButton.textContent = isExpanded ? 'View More Projects' : 'Show Less';
    });
  }
</script>
