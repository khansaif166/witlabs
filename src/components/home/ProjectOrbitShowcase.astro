---
const projects = [
  {
    title: 'Impact Packaging Solutions',
    type: 'Business Website',
    url: 'https://impactpackagingsolutions.com',
    domain: 'impactpackagingsolutions.com',
    image: '/images/Design-2.jpg',
    eyebrow: 'Packaging company presence',
    description: 'A business website built to present packaging capabilities clearly and turn first impressions into trust.',
    theme: 'sand',
  },
  {
    title: 'The Daffodil Group',
    type: 'Corporate Website',
    url: 'https://thedaffodilgroup.com',
    domain: 'thedaffodilgroup.com',
    image: '/images/card1.jpg',
    eyebrow: 'Editorial company website',
    description: 'A polished digital presence for a group brand, shaped to feel premium, structured, and credible.',
    theme: 'ember',
  },
  {
    title: 'Dream NEET Academy',
    type: 'Full LMS Platform',
    url: 'https://dreamneetacademy.com',
    domain: 'dreamneetacademy.com',
    image: '/images/mockup.png',
    eyebrow: 'Website plus LMS',
    description: 'Not just a website, but a complete LMS experience with learning flows, structure, and student-facing product depth.',
    theme: 'green',
  },
  {
    title: 'Aswad Global',
    type: 'Business Website',
    url: 'https://aswadglobal.com',
    domain: 'aswadglobal.com',
    image: '/images/Design-1.jpg',
    eyebrow: 'Global business presence',
    description: 'A brand-led website designed to communicate credibility, intent, and a sharper international-facing identity.',
    theme: 'violet',
  },
  {
    title: 'WitLabs',
    type: 'Agency Website',
    url: 'https://witlabs.in',
    domain: 'witlabs.in',
    image: '/images/Design-4.jpg',
    eyebrow: 'Our own digital presence',
    description: 'The WitLabs website itself, built to showcase positioning, service clarity, and conversion-focused storytelling.',
    theme: 'olive',
  },
];
---

<section class="project-showcase" id="digitized-with-witlabs" aria-labelledby="digitized-with-witlabs-title">
  <div class="project-showcase__noise" aria-hidden="true"></div>
  <div class="project-showcase__shell">
    <div class="showcase-heading reveal">
      <p class="showcase-kicker">Selected work</p>
      <h2 class="showcase-title" id="digitized-with-witlabs-title">
        Digitized with <span>WitLabs</span>
      </h2>
      <p class="showcase-intro">
        A selection of real work across business websites and one full LMS platform, designed to help brands look sharper, build trust faster, and perform better online.
      </p>
    </div>

    <div class="showcase-grid reveal reveal-delay-1">
      {projects.map((project) => (
        <a
          class={`showcase-card showcase-card--${project.theme}`}
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${project.title} project`}
        >
          <div class="showcase-card__frame">
            <div class="browser-dots" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="showcase-card__canvas">
              <div class="showcase-card__image-wrap">
                <img src={project.image} alt={`${project.title} project preview`} loading="lazy" />
              </div>

              <div class="showcase-card__mock">
                <span class="showcase-card__domain">{project.domain}</span>
                <p>{project.eyebrow}</p>
                <div class="showcase-card__blocks" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>
          </div>

          <div class="showcase-card__body">
            <span class="showcase-card__type">{project.type}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <strong>{project.domain} <span aria-hidden="true">↗</span></strong>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .project-showcase {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at top center, rgba(255, 255, 255, 0.08), transparent 24%),
      linear-gradient(180deg, #161615 0%, #090909 22%, #050505 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    isolation: isolate;
  }

  .project-showcase::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.24), transparent 18%, transparent 80%, rgba(0, 0, 0, 0.45)),
      radial-gradient(circle at center, transparent 20%, rgba(0, 0, 0, 0.32) 66%, rgba(0, 0, 0, 0.72) 100%);
    z-index: 0;
  }

  .project-showcase__noise {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.05;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.22) 0.7px, transparent 0.7px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.1) 0.7px, transparent 0.7px);
    background-size: 4px 4px;
    mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.95), transparent 88%);
  }

  .project-showcase__shell {
    position: relative;
    z-index: 1;
    width: min(1280px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(4.75rem, 8vw, 6.75rem) 0 clamp(4rem, 6vw, 5.5rem);
  }

  .showcase-heading {
    max-width: 860px;
    margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
    text-align: center;
  }

  .showcase-kicker {
    margin: 0 0 0.8rem;
    color: rgba(255, 255, 255, 0.54);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .showcase-title {
    margin: 0;
    color: #fcfcfb;
    font-size: clamp(2.8rem, 7vw, 6rem);
    line-height: 0.93;
    letter-spacing: -0.075em;
    font-weight: 650;
    text-wrap: balance;
  }

  .showcase-title span {
    color: rgba(255, 255, 255, 0.28);
  }

  .showcase-intro {
    width: min(640px, 100%);
    margin: 1.25rem auto 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 1rem;
    line-height: 1.7;
    text-wrap: balance;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.9rem;
    align-items: start;
  }

  .showcase-card {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 100%;
    overflow: hidden;
    border-radius: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(14, 14, 14, 0.9);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.42);
    text-decoration: none;
    transition: transform 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
    min-height: 34rem;
  }

  .showcase-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.5);
  }

  .showcase-card__frame {
    position: relative;
    padding: 1.35rem 1.35rem 0;
  }

  .showcase-card__canvas {
    position: relative;
    overflow: hidden;
    min-height: 100%;
    border-radius: 1.35rem 1.35rem 0 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0));
  }

  .browser-dots {
    position: absolute;
    left: 2rem;
    top: 1.9rem;
    z-index: 4;
    display: flex;
    gap: 0.65rem;
  }

  .browser-dots span {
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
  }

  .browser-dots span:nth-child(1) {
    background: #ff6357;
  }

  .browser-dots span:nth-child(2) {
    background: #ffc13d;
  }

  .browser-dots span:nth-child(3) {
    background: #32d74b;
  }

  .showcase-card__image-wrap {
    position: absolute;
    inset: 0;
    opacity: 0.18;
  }

  .showcase-card__image-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0.18), rgba(5, 5, 5, 0.82)),
      radial-gradient(circle at top, transparent 0%, rgba(5, 5, 5, 0.18) 35%, rgba(5, 5, 5, 0.7) 100%);
  }

  .showcase-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.78) contrast(1.05);
  }

  .showcase-card__mock {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: space-between;
    gap: 1.2rem;
    min-height: 100%;
    padding: 4.5rem 1.55rem 1.55rem;
  }

  .showcase-card__domain {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(10, 10, 10, 0.38);
    padding: 0.45rem 0.8rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    backdrop-filter: blur(12px);
  }

  .showcase-card__mock p {
    margin: 0;
    max-width: 14ch;
    color: #f5efe6;
    font-size: clamp(1.7rem, 2.6vw, 2.75rem);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.07em;
    text-wrap: balance;
  }

  .showcase-card--green .showcase-card__mock p {
    color: #dff5dd;
  }

  .showcase-card__blocks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: auto;
  }

  .showcase-card__blocks span {
    display: block;
    aspect-ratio: 1.2;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.06);
  }

  .showcase-card__body {
    padding: 1.55rem 1.45rem 1.65rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(16, 16, 16, 0.24), rgba(12, 12, 12, 0.88));
  }

  .showcase-card__type {
    display: inline-block;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  .showcase-card__body h3 {
    margin: 0.8rem 0 0;
    color: #fcfcfb;
    font-size: clamp(1.8rem, 2.5vw, 2.8rem);
    line-height: 1.02;
    letter-spacing: -0.07em;
    text-wrap: balance;
  }

  .showcase-card__body p {
    margin: 0.95rem 0 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .showcase-card__body strong {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    color: #ffffff;
    font-size: 0.93rem;
    font-weight: 600;
  }

  .showcase-card--sand {
    background: #12110d;
  }

  .showcase-card--sand .showcase-card__canvas {
    background: linear-gradient(180deg, rgba(53, 41, 19, 0.18), rgba(27, 21, 11, 0.02));
  }

  .showcase-card--sand .showcase-card__blocks span {
    background: rgba(117, 89, 42, 0.18);
  }

  .showcase-card--ember {
    background: #121010;
  }

  .showcase-card--ember .showcase-card__canvas {
    background: linear-gradient(180deg, rgba(86, 58, 26, 0.16), rgba(25, 18, 12, 0.02));
  }

  .showcase-card--green {
    background: #071008;
  }

  .showcase-card--violet {
    background: #101014;
  }

  .showcase-card--violet .showcase-card__canvas {
    background: linear-gradient(180deg, rgba(57, 48, 93, 0.18), rgba(18, 18, 31, 0.02));
  }

  .showcase-card--violet .showcase-card__mock p {
    color: #d7d2ff;
  }

  .showcase-card--olive {
    background: #0c1009;
  }

  .showcase-card--olive .showcase-card__canvas {
    background: linear-gradient(180deg, rgba(54, 80, 31, 0.16), rgba(18, 24, 14, 0.02));
  }

  .showcase-card--olive .showcase-card__mock p {
    color: #eef4e1;
  }

  @media (max-width: 1100px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .project-showcase__shell {
      width: min(100% - 1.25rem, 42rem);
      padding: 4.25rem 0 4rem;
    }

    .showcase-heading {
      margin-bottom: 2rem;
      text-align: left;
    }

    .showcase-intro {
      margin-inline: 0;
      width: 100%;
      font-size: 0.96rem;
      text-wrap: pretty;
    }

    .showcase-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .showcase-card,
    .showcase-card {
      min-height: auto;
    }

    .showcase-card__frame {
      padding: 1rem 1rem 0;
    }

    .browser-dots {
      left: 1.55rem;
      top: 1.45rem;
      gap: 0.45rem;
    }

    .browser-dots span {
      width: 0.82rem;
      height: 0.82rem;
    }

    .showcase-card__mock {
      min-height: 19rem;
      padding: 3.55rem 1.1rem 1.1rem;
    }

    .showcase-card__mock p {
      max-width: 13ch;
      font-size: clamp(1.65rem, 9vw, 2.45rem);
    }

    .showcase-card__body {
      padding: 1.15rem 1rem 1.2rem;
    }

    .showcase-card__body h3 {
      font-size: 1.9rem;
    }
  }
</style>
