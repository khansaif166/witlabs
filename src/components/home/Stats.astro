---
const stats = [
  { value: '50+', target: '50', suffix: '+', label: 'Projects Delivered' },
  { value: '3', target: '3', suffix: '', label: 'Clients Growing Now' },
  { value: '100%', target: '100', suffix: '%', label: 'On-Time Delivery' },
  { value: '4.9', target: '4.9', suffix: '', label: 'Client Satisfaction' },
];
---

<section id="home-stats" class="bg-green py-20 text-white">
  <div class="container">
    <div class="grid md:grid-cols-4">
      {stats.map((stat, index) => (
        <div class:list={['reveal py-8 text-center md:px-8', index < stats.length - 1 && 'border-b border-white/15 md:border-b-0 md:border-r']}>
          <p class="stat-number font-mono text-6xl font-bold text-white" data-target={stat.target} data-suffix={stat.suffix} data-value={stat.value}>0{stat.suffix}</p>
          <p class="mt-2 text-sm uppercase tracking-wider text-white/60">{stat.label}</p>
        </div>
      ))}
    </div>
    <p class="mt-12 border-t border-white/10 pt-8 text-center text-sm text-white/50">
      Every number above is a real business we helped grow.
    </p>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.getElementById('home-stats');
    const nums = [...(section?.querySelectorAll('.stat-number') ?? [])];
    let done = false;
    const easeOutQuart = (x) => 1 - Math.pow(1 - x, 4);
    const run = (el) => {
      const target = Number(el.dataset.target || 0);
      const suffix = el.dataset.suffix || '';
      const decimal = (el.dataset.target || '').includes('.');
      const start = performance.now();
      const duration = 1800;
      const tick = (now) => {
        const p = Math.min((now - start) / duration, 1);
        const v = target * easeOutQuart(p);
        el.textContent = `${decimal ? v.toFixed(1) : Math.round(v)}${suffix}`;
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = el.dataset.value || el.textContent;
      };
      requestAnimationFrame(tick);
    };

    if (!section || !('IntersectionObserver' in window)) {
      nums.forEach(run);
      return;
    }

    new IntersectionObserver((entries, obs) => {
      if (entries[0]?.isIntersecting && !done) {
        done = true;
        nums.forEach(run);
        obs.disconnect();
      }
    }, { threshold: 0.35 }).observe(section);
  })();
</script>
