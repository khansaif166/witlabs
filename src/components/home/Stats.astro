---
const stats = [
  { value: '2', target: '2', suffix: '', label: 'Projects Delivered', note: 'Impact Packaging Solutions and Aswad Global' },
  { value: '4', target: '4', suffix: '', label: 'Active Growth Clients', note: 'Aswad, Sustainly, Kota and Impact' },
  { value: '100%', target: '100', suffix: '%', label: 'On-Time Delivery', note: 'QA before launch' },
  { value: '10/10', target: '10', suffix: '/10', label: 'Client Satisfaction', note: 'Practical communication' },
];
---

<section id="home-stats" class="stats-band bg-cream text-ink">
  <div class="mx-auto max-w-[1440px] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="reveal mb-10 flex flex-col gap-4 border-b border-border pb-8 md:flex-row md:items-end md:justify-between">
      <h2 class="max-w-3xl text-[clamp(1.55rem,2.7vw,2.8rem)] font-semibold tracking-[-0.025em] leading-[1.08]">
        Real work. Visible progress.
      </h2>
      <p class="max-w-md text-sm leading-6 text-muted">
        Practical projects with clear outcomes.
      </p>
    </div>

    <div class="grid lg:grid-cols-4">
      {stats.map((stat, index) => (
        <div class:list={['stat-card reveal', index > 0 && `delay-${index}`]}>
          <p class="stat-number" data-target={stat.target} data-suffix={stat.suffix} data-value={stat.value}>0{stat.suffix}</p>
          <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.18em] text-green">{stat.label}</p>
          <p class="mt-2 text-sm text-muted">{stat.note}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.getElementById('home-stats');
    const nums = [...(section?.querySelectorAll('.stat-number') ?? [])];
    let done = false;
    const easeOutQuart = (x) => 1 - Math.pow(1 - x, 4);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const run = (el) => {
      if (reduced) {
        el.textContent = el.dataset.value || el.textContent;
        return;
      }

      const target = Number(el.dataset.target || 0);
      const suffix = el.dataset.suffix || '';
      const decimal = (el.dataset.target || '').includes('.');
      const start = performance.now();
      const duration = 1800;
      const tick = (now) => {
        const p = Math.min((now - start) / duration, 1);
        const v = target * easeOutQuart(p);
        el.textContent = `${decimal ? v.toFixed(1) : Math.round(v)}${suffix}`;
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = el.dataset.value || el.textContent;
      };
      requestAnimationFrame(tick);
    };

    if (!section || !('IntersectionObserver' in window)) {
      nums.forEach(run);
      return;
    }

    new IntersectionObserver((entries, obs) => {
      if (entries[0]?.isIntersecting && !done) {
        done = true;
        nums.forEach(run);
        obs.disconnect();
      }
    }, { threshold: 0.35 }).observe(section);
  })();
</script>

<style>
  .stats-band {
    border-bottom: 1px solid rgba(28, 25, 23, 0.08);
  }

  .stat-card {
    min-height: 210px;
    border-bottom: 1px solid rgba(28, 25, 23, 0.08);
    padding: 24px 0;
  }

  .stat-number {
    font-size: clamp(2.35rem, 4.3vw, 3.75rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  @media (min-width: 1024px) {
    .stat-card {
      border-bottom: 0;
      border-right: 1px solid rgba(28, 25, 23, 0.08);
      padding: 32px 32px;
    }

    .stat-card:first-child {
      padding-left: 0;
    }

    .stat-card:last-child {
      border-right: 0;
      padding-right: 0;
    }
  }
</style>
