---
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<section class="bg-cream-dark py-24">
  <div class="container">
    <div class="mb-16 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow reveal">Real Results</p>
        <h2 class="reveal delay-1 mt-3 font-serif text-[clamp(2.2rem,4.5vw,4rem)] italic leading-[1.05] text-ink">
          Work that actually<br />moved the needle.
        </h2>
      </div>
      <a class="reveal delay-2 text-sm font-medium text-green hover:text-ink" href="/case-studies/">View all case studies →</a>
    </div>

    <div class="grid gap-4 lg:grid-cols-[1.4fr_1fr_1fr]">
      {caseStudies.map((study, index) => (
        <a class="case-card reveal block overflow-hidden rounded-[20px] border border-border bg-white" href={`/case-studies/${study.slug}/`}>
          <div class:list={['relative overflow-hidden', index === 0 ? 'aspect-[4/3]' : 'aspect-video lg:aspect-[4/3]']}>
            <img class="h-full w-full object-cover" src={study.data.heroImage} alt={study.data.heroImageAlt} loading={index === 0 ? 'eager' : 'lazy'} />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/60 to-transparent to-50%"></div>
            <span class="absolute left-3 top-3 rounded-full border border-white/20 bg-white/15 px-3 py-1 font-mono text-[10px] text-white backdrop-blur">
              {study.data.industry}
            </span>
          </div>
          <div class="p-5">
            <h3 class="font-serif text-2xl italic text-ink">{study.data.client}</h3>
            <p class="mt-1 line-clamp-2 text-sm text-muted">{study.data.challenge}</p>
            <div class="mt-4 border-t border-border pt-4">
              <div class="flex gap-6">
                {study.data.results.slice(0, 2).map((result) => (
                  <div>
                    <p class="font-mono text-xl font-bold text-green">{result.value}</p>
                    <p class="mt-0.5 text-[11px] text-muted">{result.metric}</p>
                  </div>
                ))}
              </div>
              <div class="mt-4 flex items-center justify-between">
                <span class="text-sm font-medium text-ink">View Case Study</span>
                <span class="case-arrow flex h-8 w-8 items-center justify-center rounded-full border border-border text-ink">→</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
  <div id="cursor" aria-hidden="true">VIEW →</div>
</section>

<script is:inline>
  (() => {
    const cursor = document.getElementById('cursor');
    if (!cursor || matchMedia('(pointer: coarse)').matches) return;

    document.querySelectorAll('.case-card').forEach((card) => {
      card.addEventListener('mouseenter', () => cursor.classList.add('active'));
      card.addEventListener('mouseleave', () => cursor.classList.remove('active'));
      card.addEventListener('mousemove', (event) => {
        cursor.style.left = `${event.clientX - 28}px`;
        cursor.style.top = `${event.clientY - 28}px`;
      });
    });
  })();
</script>

<style>
  .case-card {
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .case-card img {
    transition: transform 0.5s ease;
  }

  .case-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(28, 25, 23, 0.1);
    cursor: none;
  }

  .case-card:hover img {
    transform: scale(1.04);
  }

  .case-card:hover .case-arrow {
    border-color: #2D6A4F;
    background: #2D6A4F;
    color: #FFFFFF;
  }

  #cursor {
    pointer-events: none;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 80;
    display: flex;
    height: 56px;
    width: 56px;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #1C1917;
    border-radius: 999px;
    color: #1C1917;
    font-family: "DM Mono", monospace;
    font-size: 10px;
    opacity: 0;
    transform: scale(0.5);
    transition: left 0.08s ease, top 0.08s ease, opacity 0.15s ease, transform 0.15s ease;
  }

  #cursor.active {
    opacity: 1;
    transform: scale(1);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
</style>
