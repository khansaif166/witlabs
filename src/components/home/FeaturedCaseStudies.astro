---
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);

const supportingImages: Record<string, string> = {
  'al-khair-interiors': '/images/case-studies/al-khair.jpg',
  'impact-packaging': '/images/case-studies/impact-packaging.jpg',
  'kota-experts': '/images/case-studies/kota-experts.jpg',
};

const wallSlots = [
  { row: -1, scale: 0.88 },
  { row: 0, scale: 1 },
  { row: 1, scale: 0.88 },
  { row: -1, scale: 0.9 },
  { row: 0, scale: 0.96 },
  { row: 1, scale: 0.86 },
  { row: -1, scale: 0.88 },
  { row: 0, scale: 1 },
  { row: 1, scale: 0.88 },
  { row: -1, scale: 0.86 },
  { row: 0, scale: 0.96 },
  { row: 1, scale: 0.88 },
  { row: -1, scale: 0.84 },
  { row: 0, scale: 0.94 },
  { row: 1, scale: 0.86 },
];

const wallItems = wallSlots.map((slot, index) => {
  const study = caseStudies[index % caseStudies.length];
  const useSupportingImage = index % 2 === 1 && supportingImages[study.slug];
  const displayLink = `www.${study.slug}.com`;

  return {
    study,
    image: useSupportingImage ? supportingImages[study.slug] : study.data.heroImage,
    displayLink,
    ...slot,
  };
});
---

<section id="selected-work" class="work-wall-section bg-black text-white">
  <div class="work-wall-header reveal">
    <div>
      <p class="work-wall-eyebrow">Websites made real</p>
      <h2>Made with WitLabs</h2>
    </div>
    <a class="work-wall-header__link" href="/case-studies/">
      View all case studies <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="work-wall reveal reveal-delay-1" data-work-wall tabindex="0" aria-label="Interactive wall of featured WitLabs projects">
    <div class="work-wall__shade work-wall__shade--top"></div>
    <div class="work-wall__shade work-wall__shade--bottom"></div>

    <div class="work-wall__stage">
      <div class="work-wall__ring" data-work-ring>
        {wallItems.map((item, index) => (
          <a
            class="work-wall-panel"
            data-wall-panel
            data-wall-row={item.row}
            href={`/case-studies/${item.study.slug}/`}
            aria-label={`View ${item.study.data.client} case study`}
            style={`--panel-scale: ${item.scale};`}
          >
            <img
              src={item.image}
              alt={item.study.data.heroImageAlt}
              loading={index < 4 ? 'eager' : 'lazy'}
            />
            <span class="work-wall-panel__veil"></span>
            <span class="work-wall-panel__content">
              <span class="work-wall-panel__meta">{item.study.data.industry}</span>
              <span class="work-wall-panel__title">{item.study.data.client}</span>
              <span class="work-wall-panel__link">{item.displayLink}</span>
              <span class="work-wall-panel__cta">View project <span aria-hidden="true">→</span></span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="work-wall__center" aria-hidden="true">
      <span>Made with</span>
      <strong>WitLabs</strong>
    </div>

    <div class="work-wall__hit-layer" aria-hidden="true">
      {wallItems.map((item) => (
        <a
          class="work-wall-hit"
          data-wall-hit
          href={`/case-studies/${item.study.slug}/`}
          aria-label={`View ${item.study.data.client} case study`}
          tabindex="-1"
        >
          <span class="work-wall-hit__badge">{item.displayLink}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const wall = document.querySelector('[data-work-wall]');
    const ring = document.querySelector('[data-work-ring]');
    if (!wall || !ring) return;

    const section = wall.closest('#selected-work');
    const header = document.getElementById('site-header');
    const panels = [...wall.querySelectorAll('[data-wall-panel]')];
    const hits = [...wall.querySelectorAll('[data-wall-hit]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dragThreshold = 8;
    const perspective = 1800;
    let wallOffset = 0;
    let velocity = reducedMotion ? 0 : -0.22;
    let suspendedVelocity = velocity;
    let isDragging = false;
    let dragStarted = false;
    let dragDistance = 0;
    let lastX = 0;
    let activePointerId = null;

    const pauseMotion = () => {
      suspendedVelocity = velocity;
      velocity = 0;
    };

    const resumeMotion = () => {
      if (!reducedMotion && !isDragging) {
        velocity = suspendedVelocity || -0.22;
      }
    };

    const startDrag = (event) => {
      if (event.button !== 0) return false;
      activePointerId = event.pointerId;
      dragStarted = false;
      dragDistance = 0;
      lastX = event.clientX;
      pauseMotion();
      return true;
    };

    const updatePanels = () => {
      const narrow = window.matchMedia('(max-width: 700px)').matches;
      const columnGap = narrow ? 245 : 330;
      const rowGap = narrow ? 138 : 176;
      const wrapWidth = panels.length * columnGap;
      const halfWidth = wrapWidth / 2;

      panels.forEach((panel, index) => {
        const row = Number(panel.dataset.wallRow || 0);
        const rawX = index * columnGap + wallOffset;
        const x = ((rawX + halfWidth) % wrapWidth + wrapWidth) % wrapWidth - halfWidth;
        const distance = Math.abs(x);
        const z = -Math.min(narrow ? 220 : 330, distance * 0.28);
        const rotateY = Math.max(-24, Math.min(24, x * -0.035));
        const edgeFade = Math.max(0.28, 1 - distance / halfWidth);
        const projection = perspective / (perspective - z);
        const hitScale = Number(panel.style.getPropertyValue('--panel-scale') || 1) * projection;
        const hit = hits[index];

        panel.style.setProperty('--panel-x', `${x}px`);
        panel.style.setProperty('--panel-y', `${row * rowGap}px`);
        panel.style.setProperty('--panel-z', `${z}px`);
        panel.style.setProperty('--panel-ry', `${rotateY}deg`);
        panel.style.setProperty('--panel-opacity', edgeFade.toFixed(2));
        panel.style.zIndex = String(1000 - Math.round(distance));
        panel.toggleAttribute('data-front', distance < columnGap * 0.8);

        if (hit) {
          hit.style.setProperty('--hit-x', `${x * projection}px`);
          hit.style.setProperty('--hit-y', `${row * rowGap * projection}px`);
          hit.style.setProperty('--hit-scale', String(hitScale));
          hit.style.zIndex = String(1000 - Math.round(distance));
          hit.toggleAttribute('data-front', distance < columnGap * 0.8);
        }
      });
    };

    const nudge = (amount) => {
      wallOffset += amount;
      velocity = reducedMotion ? 0 : amount * 0.035;
      updatePanels();
    };

    wall.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') nudge(-345);
      if (event.key === 'ArrowLeft') nudge(345);
    });

    wall.addEventListener('wheel', (event) => {
      const amount = (event.deltaX || event.deltaY) * -0.45;
      nudge(amount);
    }, { passive: true });

    wall.addEventListener('pointerdown', (event) => {
      const hitPanel = event.target instanceof Element ? event.target.closest('[data-wall-panel], [data-wall-hit]') : null;
      if (hitPanel) return;
      startDrag(event);
    });

    wall.addEventListener('pointermove', (event) => {
      if (activePointerId !== event.pointerId) return;
      const delta = event.clientX - lastX;
      const nextDistance = dragDistance + Math.abs(delta);

      if (!dragStarted && nextDistance < dragThreshold) {
        dragDistance = nextDistance;
        lastX = event.clientX;
        return;
      }

      if (!dragStarted) {
        dragStarted = true;
        isDragging = true;
        wall.classList.add('is-dragging');
        wall.setPointerCapture(event.pointerId);
      }

      lastX = event.clientX;
      dragDistance = nextDistance;
      wallOffset += delta;
      velocity = reducedMotion ? 0 : delta * 0.16;
      updatePanels();
    });

    const stopDrag = (event) => {
      if (activePointerId !== event.pointerId) return;

      activePointerId = null;
      if (dragStarted) {
        isDragging = false;
        wall.classList.remove('is-dragging');
      }
      dragStarted = false;
      dragDistance = 0;
      if (wall.hasPointerCapture(event.pointerId)) {
        wall.releasePointerCapture(event.pointerId);
      }

      resumeMotion();
    };

    wall.addEventListener('pointerup', stopDrag);
    wall.addEventListener('pointercancel', stopDrag);

    panels.forEach((panel, index) => {
      const hit = hits[index];

      panel.addEventListener('pointerenter', () => {
        pauseMotion();
        panel.setAttribute('data-selected', '');
      });

      panel.addEventListener('pointerleave', () => {
        resumeMotion();
        panel.removeAttribute('data-selected');
      });

      panel.addEventListener('pointerdown', (event) => {
        pauseMotion();
        event.stopPropagation();
      });

      if (!hit) return;

      const selectPanel = () => {
        pauseMotion();
        panel.setAttribute('data-selected', '');
        hit.setAttribute('data-selected', '');
      };

      const unselectPanel = () => {
        resumeMotion();
        panel.removeAttribute('data-selected');
        hit.removeAttribute('data-selected');
      };

      hit.addEventListener('pointerenter', selectPanel);
      hit.addEventListener('pointerleave', unselectPanel);
      hit.addEventListener('focus', selectPanel);
      hit.addEventListener('blur', unselectPanel);
    });

    if (section && header && 'IntersectionObserver' in window) {
      const headerObserver = new IntersectionObserver(
        ([entry]) => {
          header.classList.toggle('work-wall-active', entry.isIntersecting);
        },
        { threshold: 0.22, rootMargin: '-72px 0px -45% 0px' }
      );

      headerObserver.observe(section);
    }

    const animate = () => {
      if (!reducedMotion && !isDragging) {
        wallOffset += velocity;
        velocity *= 0.94;
        if (Math.abs(velocity) < 0.22) {
          velocity = velocity < 0 ? -0.22 : 0.22;
        }
        updatePanels();
      }

      window.requestAnimationFrame(animate);
    };

    updatePanels();
    animate();
  })();
</script>

<style>
  .work-wall-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: calc(var(--nav-height) * -1);
    padding-top: var(--nav-height);
    padding-bottom: clamp(64px, 8vw, 112px);
    background: #000000;
    min-height: 0;
  }

  .work-wall-header {
    position: absolute;
    left: 50%;
    top: 34px;
    z-index: 6;
    display: flex;
    width: min(1180px, calc(100% - 32px));
    transform: translateX(-50%);
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    pointer-events: none;
  }

  .work-wall-eyebrow {
    color: rgba(255, 255, 255, 0.52);
    font-family: "DM Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .work-wall-header h2 {
    margin-top: 10px;
    max-width: 560px;
    color: #ffffff;
    font-size: 48px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
  }

  .work-wall-header__link {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.38);
    color: rgba(255, 255, 255, 0.72);
    font-family: "DM Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    transition: border-color 0.25s var(--ease-standard), color 0.25s var(--ease-standard);
  }

  .work-wall-header__link:hover,
  .work-wall-header__link:focus-visible {
    border-color: #4ade80;
    color: #ffffff;
  }

  .work-wall {
    --panel-width: 300px;
    position: relative;
    height: clamp(620px, 72vh, 760px);
    cursor: grab;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 45%, rgba(74, 222, 128, 0.14), transparent 18%),
      radial-gradient(circle at 50% 52%, rgba(255, 255, 255, 0.12), transparent 24%),
      #000000;
    perspective: 1800px;
    perspective-origin: 50% 50%;
    touch-action: pan-y;
  }

  .work-wall:focus-visible {
    outline: 2px solid #4ade80;
    outline-offset: -6px;
  }

  .work-wall.is-dragging {
    cursor: grabbing;
  }

  .work-wall__stage {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .work-wall__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 100%;
    transform: translate3d(-50%, -50%, 0);
    transform-style: preserve-3d;
  }

  .work-wall-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    display: block;
    width: var(--panel-width);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #151515;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.42);
    color: #ffffff;
    cursor: pointer;
    pointer-events: auto;
    opacity: var(--panel-opacity, 0.6);
    transform:
      translate(-50%, -50%)
      translate3d(var(--panel-x, 0px), var(--panel-y, 0px), var(--panel-z, -260px))
      rotateY(var(--panel-ry, 0deg))
      scale(var(--panel-scale));
    transform-style: preserve-3d;
    backface-visibility: hidden;
    transition:
      border-color 0.3s var(--ease-standard),
      box-shadow 0.3s var(--ease-standard),
      opacity 0.3s var(--ease-standard);
    touch-action: manipulation;
    user-select: none;
    -webkit-user-drag: none;
  }

  .work-wall__hit-layer {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  .work-wall-hit {
    position: absolute;
    left: 50%;
    top: 50%;
    display: block;
    width: var(--panel-width);
    aspect-ratio: 16 / 10;
    transform:
      translate(-50%, -50%)
      translate3d(var(--hit-x, 0px), var(--hit-y, 0px), 0)
      scale(var(--hit-scale, 1));
    pointer-events: auto;
    cursor: pointer;
  }

  .work-wall-hit__badge {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(0, 0, 0, 0.72);
    color: #ffffff;
    font-family: "DM Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.1;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.25s var(--ease-standard), transform 0.25s var(--ease-standard), border-color 0.25s var(--ease-standard), background-color 0.25s var(--ease-standard);
    backdrop-filter: blur(14px);
  }

  .work-wall-panel[data-front] {
    opacity: 0.96;
  }

  .work-wall-panel:hover,
  .work-wall-panel:focus-visible,
  .work-wall-panel[data-selected] {
    border-color: rgba(74, 222, 128, 0.82);
    box-shadow: 0 46px 120px rgba(0, 0, 0, 0.62), 0 0 0 1px rgba(74, 222, 128, 0.34);
    opacity: 1;
    outline: none;
  }

  .work-wall-panel img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    filter: saturate(0.94) brightness(0.76);
    transition: filter 0.3s var(--ease-standard), transform 0.45s var(--ease-standard);
    -webkit-user-drag: none;
    backface-visibility: hidden;
  }

  .work-wall-panel:hover img,
  .work-wall-panel:focus-visible img,
  .work-wall-panel[data-selected] img {
    filter: saturate(1.05) brightness(0.5);
    transform: scale(1.04);
  }

  .work-wall-panel__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.78));
    opacity: 0;
    transition: opacity 0.3s var(--ease-standard);
  }

  .work-wall-panel:hover .work-wall-panel__veil,
  .work-wall-panel:focus-visible .work-wall-panel__veil,
  .work-wall-panel[data-selected] .work-wall-panel__veil {
    opacity: 1;
  }

  .work-wall-panel__content {
    position: absolute;
    inset: auto 18px 18px;
    display: grid;
    gap: 7px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.3s var(--ease-standard), transform 0.3s var(--ease-standard);
  }

  .work-wall-panel:hover .work-wall-panel__content,
  .work-wall-panel:focus-visible .work-wall-panel__content,
  .work-wall-panel[data-selected] .work-wall-panel__content {
    opacity: 1;
    transform: translateY(0);
  }

  .work-wall-panel__meta,
  .work-wall-panel__cta {
    color: rgba(255, 255, 255, 0.72);
    font-family: "DM Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .work-wall-panel__title {
    max-width: 18ch;
    color: #ffffff;
    font-size: 30px;
    font-weight: 700;
    line-height: 0.95;
  }

  .work-wall-panel__link {
    color: rgba(255, 255, 255, 0.82);
    font-family: "DM Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
  }

  .work-wall-panel__cta {
    color: #4ade80;
  }

  .work-wall-hit:hover .work-wall-hit__badge,
  .work-wall-hit:focus-visible .work-wall-hit__badge,
  .work-wall-hit[data-selected] .work-wall-hit__badge {
    opacity: 1;
    transform: translateY(0);
    border-color: rgba(74, 222, 128, 0.75);
    background: rgba(8, 10, 8, 0.82);
  }

  .work-wall__center {
    position: absolute;
    left: 50%;
    top: 52%;
    z-index: 4;
    display: grid;
    transform: translate(-50%, -50%);
    color: #ffffff;
    font-size: 54px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.9;
    text-align: center;
    text-shadow: 0 18px 50px rgba(0, 0, 0, 0.84);
    pointer-events: none;
  }

  .work-wall__center span {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 400;
  }

  .work-wall__center strong {
    font-weight: 600;
  }

  .work-wall__shade {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 5;
    height: 190px;
    pointer-events: none;
  }

  .work-wall__shade--top {
    top: 0;
    background: linear-gradient(180deg, #000000, transparent);
  }

  .work-wall__shade--bottom {
    bottom: 0;
    background: linear-gradient(0deg, #000000, transparent);
  }

  @media (max-width: 900px) {
    .work-wall {
      --panel-width: 250px;
      height: 680px;
    }

    .work-wall-header {
      top: 24px;
      display: grid;
    }

    .work-wall-header h2 {
      font-size: 38px;
    }

    .work-wall__stage {
      inset: 0 -28%;
    }

    .work-wall__center {
      top: 55%;
      font-size: 43px;
    }
  }

  @media (max-width: 560px) {
    .work-wall {
      --panel-width: 210px;
      height: 620px;
    }

    .work-wall-header h2 {
      font-size: 32px;
    }

    .work-wall-panel__title {
      font-size: 22px;
    }

    .work-wall__center {
      font-size: 36px;
    }
  }
</style>
