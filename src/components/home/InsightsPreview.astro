---
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const placeholders = [
  { category: 'COMING SOON', title: 'Website notes', readTime: 'Soon' },
  { category: 'COMING SOON', title: 'Local SEO lessons', readTime: 'Soon' },
  { category: 'COMING SOON', title: 'Automation ideas', readTime: 'Soon' },
];

const cards = posts.length > 0
  ? posts.map((post) => ({
    category: post.data.category,
    title: post.data.title,
    description: post.data.description,
    readTime: `${post.data.readTime} min`,
    date: post.data.publishDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }),
    href: `/insights/${post.slug}/`,
    image: post.data.ogImage,
    isPlaceholder: false,
  }))
  : placeholders.map((post) => ({ ...post, description: 'Fresh practical notes will appear here soon.', date: 'Publishing soon', href: '/insights/', image: undefined, isPlaceholder: true }));
---

<section class="section-shell bg-white text-ink">
  <div class="mx-auto max-w-[1440px]">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="section-kicker reveal text-green">Resources</p>
        <h2 class="reveal reveal-delay-1 mt-4 display-tight text-[clamp(1.95rem,3.2vw,3.25rem)] font-semibold">
          Useful growth notes.
        </h2>
      </div>
      <a class="arrow-link reveal reveal-delay-2 text-green" href="/insights/">View all <span class="arrow">→</span></a>
    </div>

    <div class="insights-grid mt-12">
      {cards.map((post, index) => (
        <article class:list={['insight-card reveal', index > 0 && `delay-${index}`]}>
          <div class="insight-card__media" aria-hidden="true">
            {post.image && <img src={post.image} alt={post.title} loading="lazy" />}
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="insight-card__body">
            <div class="flex items-center justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.14em] text-muted">
              <span class:list={[post.isPlaceholder && 'rounded-full bg-green-light px-3 py-1 text-green']}>{post.category}</span>
              <span>{post.readTime}</span>
            </div>
            <h3>{post.title}</h3>
            <p class="insight-card__description">{post.description}</p>
            <p class="insight-card__meta">{post.date}</p>
            <a class="arrow-link text-green" href={post.href}>
              {post.isPlaceholder ? 'Coming soon' : 'Read more'} <span class="arrow">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .insights-grid {
    display: grid;
    gap: 16px;
  }

  .insight-card {
    overflow: hidden;
    border: 1px solid rgba(28, 25, 23, 0.08);
    border-radius: 8px;
    background: #F6F3EE;
    transition: transform 0.35s var(--ease-premium), box-shadow 0.35s var(--ease-premium);
  }

  .insight-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .insight-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 20%, rgba(74, 222, 128, 0.28), transparent 28%),
      linear-gradient(135deg, #111111, #2D6A4F 58%, #EDE9E2);
  }

  .insight-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .insight-card__media span {
    position: absolute;
    bottom: -18px;
    right: 18px;
    color: rgba(255, 255, 255, 0.28);
    font-size: 86px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.8;
  }

  .insight-card__body {
    padding: 24px;
  }

  .insight-card h3 {
    margin-top: 28px;
    min-height: 96px;
    color: #1C1917;
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .insight-card__description {
    margin: 16px 0 0;
    color: #57534E;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .insight-card__meta {
    margin: 18px 0 24px;
    color: #78716C;
    font-family: "DM Mono", monospace;
    font-size: 11px;
  }

  @media (min-width: 900px) {
    .insights-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
