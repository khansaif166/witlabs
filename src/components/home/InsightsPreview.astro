---
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const placeholders = [
  { category: 'COMING SOON', title: 'Website growth notes for Indian businesses', readTime: 'Soon' },
  { category: 'COMING SOON', title: 'Local SEO lessons from real service companies', readTime: 'Soon' },
  { category: 'COMING SOON', title: 'Automation ideas that save founders real hours', readTime: 'Soon' },
];

const cards = posts.length > 0
  ? posts.map((post) => ({
    category: post.data.category,
    title: post.data.title,
    readTime: `${post.data.readTime} min`,
    date: post.data.publishDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }),
    href: `/insights/${post.slug}/`,
    isPlaceholder: false,
  }))
  : placeholders.map((post) => ({ ...post, date: 'Publishing soon', href: '/insights/', isPlaceholder: true }));
---

<section class="bg-cream py-24">
  <div class="container">
    <div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow reveal">From The Blog</p>
        <h2 class="reveal delay-1 mt-3 font-serif text-[clamp(2.2rem,4.5vw,4rem)] italic leading-[1.05] text-ink">
          Practical ideas for<br />growth-minded teams.
        </h2>
      </div>
      <a class="reveal delay-2 text-sm font-medium text-green hover:text-ink" href="/insights/">View all →</a>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {cards.map((post, index) => (
        <article class:list={['reveal overflow-hidden rounded-2xl border border-border bg-white', index > 0 && `delay-${index}`]}>
          <div class="flex items-center justify-between px-5 pt-5 font-mono text-[10px] uppercase tracking-[0.12em] text-muted">
            <span class:list={[post.isPlaceholder && 'rounded-full bg-green-light px-3 py-1 text-green']}>{post.category}</span>
            <span>{post.readTime}</span>
          </div>
          <div class="mx-5 mt-5 aspect-video bg-[linear-gradient(135deg,#EEF4F1_0%,#F6F3EE_55%,#EDE9E2_100%)]"></div>
          <div class="p-5">
            <h3 class="line-clamp-2 text-lg font-semibold text-ink">{post.title}</h3>
            <p class="mt-2 font-mono text-[11px] text-muted">{post.date}</p>
            <a class="mt-4 inline-flex text-sm font-medium text-green hover:text-ink" href={post.href}>
              {post.isPlaceholder ? 'Coming Soon →' : 'Read more →'}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
</style>
