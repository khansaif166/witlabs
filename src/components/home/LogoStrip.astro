---
const logos = ['Al Khair Interiors', 'Impact Packaging', 'Kota Experts', 'Local Founders', 'Growing Teams', 'Indian SMEs'];
const marqueeLogos = [...logos, ...logos];
---

<section class="overflow-hidden border-b border-border bg-cream py-10">
  <p class="mb-6 text-center font-mono text-[10px] uppercase tracking-[0.2em] text-muted">Trusted By</p>
  <div class="flex w-max animate-marquee items-center gap-16 px-6 hover:[animation-play-state:paused]">
    {marqueeLogos.map((logo) => (
      <span class="whitespace-nowrap text-lg font-medium text-ink/30 transition-colors hover:text-ink/70">
        {logo}
      </span>
    ))}
  </div>
</section>
