---
const logos = [
  { label: 'Impact Packaging Solutions', href: 'https://www.impactpackagingsolutions.com/' },
  { label: 'Aswad Global', href: 'https://www.aswadglobal.com/' },
  { label: 'Sustainly Green', href: 'https://www.sustainlygreen.com/' },
  { label: 'Kota Experts' },
  { label: 'Founders' },
  { label: 'Teams' },
  { label: 'SMEs' },
];
const marqueeLogos = [...logos, ...logos];
---

<section class="overflow-hidden border-b border-white/10 bg-ink py-10 text-white">
  <div class="mb-6 flex items-center justify-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-white/42">
    <span class="h-px w-8 bg-white/20"></span>
    <span>Trusted teams</span>
    <span class="h-px w-8 bg-white/20"></span>
  </div>
  <div class="flex w-max animate-marquee items-center gap-16 px-6 hover:[animation-play-state:paused]">
    {marqueeLogos.map((logo) => (
      logo.href ? (
        <a
          class="whitespace-nowrap text-base font-semibold tracking-[-0.02em] text-white/28 transition-colors hover:text-white/75"
          href={logo.href}
          target="_blank"
          rel="noreferrer"
        >
          {logo.label}
        </a>
      ) : (
        <span class="whitespace-nowrap text-base font-semibold tracking-[-0.02em] text-white/28 transition-colors hover:text-white/75">
          {logo.label}
        </span>
      )
    ))}
  </div>
</section>
