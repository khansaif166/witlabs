---
const logos = ['Al Khair Interiors', 'Impact Packaging', 'Kota Experts', 'Local Founders', 'Growing Teams', 'Indian SMEs'];
const marqueeLogos = [...logos, ...logos];
---

<section class="overflow-hidden border-b border-white/10 bg-ink py-10 text-white">
  <div class="mb-6 flex items-center justify-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-white/42">
    <span class="h-px w-8 bg-white/20"></span>
    <span>Trusted by practical teams</span>
    <span class="h-px w-8 bg-white/20"></span>
  </div>
  <div class="flex w-max animate-marquee items-center gap-16 px-6 hover:[animation-play-state:paused]">
    {marqueeLogos.map((logo) => (
      <span class="whitespace-nowrap text-lg font-semibold tracking-[-0.03em] text-white/28 transition-colors hover:text-white/75">
        {logo}
      </span>
    ))}
  </div>
</section>
