---
---

<section class="relative min-h-[100svh] overflow-hidden bg-ink px-4 pb-16 pt-28 text-cream sm:px-6 lg:px-8 lg:pt-32">
  <div class="container relative grid min-h-[calc(100svh-9rem)] items-center gap-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(360px,1fr)]">
    <div class="relative z-10">
      <div class="mb-12 flex items-center justify-between gap-6">
        <span class="font-mono text-[11px] uppercase tracking-[0.25em] text-green-bright">Digital Growth Agency</span>
        <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-cream/30">Est. 2024</span>
      </div>

      <h1 id="hero-heading" class="hero-heading font-serif italic text-[clamp(4.5rem,9vw,9rem)] leading-[0.92] text-cream">
        <span class="hero-line block">We Build</span>
        <span class="hero-line block">Digital</span>
        <span class="hero-line hero-outline block">Systems</span>
      </h1>

      <p class="mt-6 text-[clamp(1.1rem,2.5vw,1.5rem)] font-medium text-cream/60">
        That Help Businesses Grow.
      </p>

      <div class="mt-12 flex flex-col gap-4 sm:flex-row">
        <a class="inline-flex items-center justify-center rounded-full bg-green px-7 py-3.5 text-[15px] font-medium text-white transition-colors duration-200 hover:bg-green-mid" href="/contact/">
          Book a Free Strategy Call
        </a>
        <a class="inline-flex items-center justify-center rounded-full border border-cream/20 px-7 py-3.5 text-[15px] font-medium text-cream/70 transition-colors duration-200 hover:border-cream/50 hover:text-cream" href="/case-studies/">
          See Our Work ↓
        </a>
      </div>

      <div class="mt-16 flex flex-wrap gap-3 font-mono text-[11px] text-cream/35">
        <span>50+ Projects</span><span>/</span><span>3 Growing Clients</span><span>/</span><span>ROI Focused</span>
      </div>
    </div>

    <div class="relative hidden h-[620px] lg:block">
      <div class="pointer-events-none absolute right-[-20px] top-1/2 -translate-y-1/2 select-none font-serif text-[clamp(300px,55vw,600px)] italic leading-none text-white/[0.025]" aria-hidden="true">W</div>

      <div class="float-card float-one absolute left-0 top-14 w-[310px] rounded-[20px] border border-white/10 bg-white/[0.06] p-5 backdrop-blur-[10px]">
        <div class="flex items-center gap-2 font-mono text-[11px] text-cream/50">
          <span class="h-2 w-2 animate-pulse rounded-full bg-green-bright"></span>
          Active Project
        </div>
        <h2 class="mt-4 text-lg font-medium text-cream">Kota Experts</h2>
        <div class="mt-5 h-1 overflow-hidden rounded-full bg-cream/10">
          <span class="block h-full w-[73%] rounded-full bg-green"></span>
        </div>
        <p class="mt-3 font-mono text-[10px] text-cream/40">Website &amp; SEO — 73% complete</p>
      </div>

      <div class="float-card float-two absolute right-0 top-[245px] w-[280px] rounded-[20px] border border-white/10 bg-white/[0.06] p-5 backdrop-blur-[10px]">
        <p class="font-mono text-2xl font-bold text-green-bright">↑ 128%</p>
        <p class="mt-2 text-sm text-cream/50">Organic traffic growth</p>
        <p class="mt-1 font-mono text-[10px] text-cream/30">Al Khair Interiors · 3 months</p>
      </div>

      <div class="float-card float-three absolute bottom-16 left-8 w-[360px] rounded-[20px] border border-white/10 bg-white/[0.06] p-5 backdrop-blur-[10px]">
        <div class="grid grid-cols-3 gap-4">
          {[
            ['50+', 'Projects'],
            ['3', 'Clients'],
            ['100%', 'On Time'],
          ].map(([value, label]) => (
            <div>
              <p class="font-mono text-xl font-bold text-cream">{value}</p>
              <p class="mt-1 font-mono text-[10px] text-cream/40">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center md:flex" aria-hidden="true">
    <span class="relative h-10 w-px overflow-hidden bg-cream/20">
      <span class="scroll-dot absolute left-1/2 top-0 h-1.5 w-1.5 -translate-x-1/2 rounded-full bg-green-bright"></span>
    </span>
    <span class="mt-2 font-mono text-[9px] tracking-[0.3em] text-cream/30">SCROLL</span>
  </div>
</section>

<script is:inline>
  (() => {
    const heading = document.getElementById('hero-heading');
    if (!heading) return;
    const words = heading.querySelectorAll('.hero-line');
    words.forEach((word, index) => {
      word.style.transitionDelay = `${index * 0.08}s`;
      requestAnimationFrame(() => word.classList.add('is-visible'));
    });
  })();
</script>

<style>
  .hero-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px #F6F3EE;
  }

  .hero-line {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .hero-line.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes scrollDot {
    0% { transform: translate(-50%, 0); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translate(-50%, 34px); opacity: 0; }
  }

  .float-one { animation: float 4s ease-in-out infinite; }
  .float-two { animation: float 4s ease-in-out infinite 1.3s; }
  .float-three { animation: float 4s ease-in-out infinite 2.6s; }
  .scroll-dot { animation: scrollDot 1.7s ease-in-out infinite; }
</style>
