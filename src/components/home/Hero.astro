---
const heroFrames = [
  {
    src: '/images/Design-1.jpg',
    alt: 'WitLabs website design concept with editorial layout and product storytelling.',
    label: 'Brand website',
  },
  {
    src: '/images/Design-2.jpg',
    alt: 'WitLabs landing page concept with a clean conversion-focused structure.',
    label: 'B2B growth',
  },
  {
    src: '/images/Design-3.jpg',
    alt: 'WitLabs premium website interface design shown in a browser mockup.',
    label: 'Growth systems',
  },
  {
    src: '/images/Design-4.jpg',
    alt: 'WitLabs website mockup with layered imagery and bold typography.',
    label: 'Visual identity',
  },
  {
    src: '/images/Design-5.jpg',
    alt: 'WitLabs service business website concept built for digital growth.',
    label: 'Local SEO',
  },
  {
    src: '/images/Design-6.jpg',
    alt: 'WitLabs website design preview showing another polished digital growth concept.',
    label: 'Launch ready',
  },
];

const heroBackgroundVideos = [
  '/videos/8033501-uhd_3840_2160_25fps.mp4',
  '/videos/15439592_1920_1080_25fps.mp4',
  '/videos/7287767-uhd_3840_2160_25fps.mp4',
];

const getHeroPosition = (index: number) => {
  const offset = index % heroFrames.length;
  return offset > heroFrames.length / 2 ? offset - heroFrames.length : offset;
};
---

<section id="homepage-hero" class="homepage-hero relative min-h-[100svh] overflow-hidden bg-ink text-white md:min-h-[112svh] lg:min-h-[118svh]">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg__videos">
      {heroBackgroundVideos.map((src, index) => (
        <video
          class="hero-bg__video"
          data-video-index={index}
          autoplay
          muted
          loop
          playsinline
          preload={index === 0 ? 'auto' : 'metadata'}
        >
          <source src={src} type="video/mp4" />
        </video>
      ))}
    </div>
  </div>

  <div class="container relative z-10 flex min-h-[100svh] flex-col items-center pb-8 pt-[calc(var(--nav-height)+34px)] text-center md:min-h-[112svh] lg:min-h-[118svh] lg:pt-[calc(var(--nav-height)+38px)]">
    <div class="hero-copy reveal">
      <div class="hero-eyebrow mx-auto flex w-fit flex-wrap items-center justify-center gap-x-5 gap-y-2 font-mono text-[11px] uppercase tracking-[0.18em] text-white/70">
        <span>Digital Growth Agency</span>
        <span class="h-px w-8 bg-white/35" aria-hidden="true"></span>
        <span>India</span>
      </div>

      <h1 id="hero-heading" class="hero-heading mx-auto mt-5 max-w-4xl font-semibold text-white">
        <span class="hero-line block">Be Found.</span>
        <span class="hero-line block text-white/72">Be Chosen.</span>
      </h1>

      <div class="reveal reveal-delay-3 mt-6">
        <a class="premium-button premium-button-light" href="/contact/">Book a Free Strategy Call</a>
      </div>
    </div>

    <div class="hero-showcase reveal reveal-delay-2" aria-label="WitLabs website design previews">
      <div class="hero-showcase__track" data-hero-carousel>
        {heroFrames.map((frame, index) => (
          <article
            class="hero-preview-card"
            data-hero-card
            data-hero-index={index}
            data-position={getHeroPosition(index)}
            tabindex={index === 0 ? '0' : '-1'}
            aria-label={`Show ${frame.label} preview`}
          >
            <div class="hero-preview-card__top">
              <span>{frame.label}</span>
              <span>WitLabs / {String(index + 1).padStart(2, '0')}</span>
            </div>
            <img src={frame.src} alt={frame.alt} loading={index < 2 ? 'eager' : 'lazy'} />
          </article>
        ))}
      </div>
    </div>

    <div class="hero-bottom reveal reveal-delay-4">
      <div class="hero-frame-label">
        <span class="hero-frame-dot"></span>
        <span id="hero-frame-label">{heroFrames[0].label}</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const heading = document.getElementById('hero-heading');
    const lines = heading ? [...heading.querySelectorAll('.hero-line')] : [];
    const cards = [...document.querySelectorAll('[data-hero-card]')];
    const label = document.getElementById('hero-frame-label');
    const labels = ['Brand website', 'B2B growth', 'Growth systems', 'Visual identity', 'Local SEO', 'Launch ready'];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTO_ADVANCE_MS = 4000;
    let active = 0;
    let autoplay;

    lines.forEach((line, index) => {
      line.style.transitionDelay = `${index * 0.09 + 0.08}s`;
      requestAnimationFrame(() => line.classList.add('is-visible'));
    });

    const syncCards = () => {
      cards.forEach((card, index) => {
        const offset = (index - active + cards.length) % cards.length;
        const position = offset > cards.length / 2 ? offset - cards.length : offset;
        card.setAttribute('data-position', String(position));
        card.setAttribute('tabindex', Math.abs(position) <= 1 ? '0' : '-1');
        card.setAttribute('aria-current', position === 0 ? 'true' : 'false');
      });

      if (label) label.textContent = labels[active] || labels[0];
    };

    const setActive = (index) => {
      active = (index + cards.length) % cards.length;
      syncCards();
    };

    const startAutoplay = () => {
      if (reduced || cards.length < 2) return;
      window.clearInterval(autoplay);
      autoplay = window.setInterval(() => {
        setActive(active + 1);
      }, AUTO_ADVANCE_MS);
    };

    const restartAutoplay = () => {
      window.clearInterval(autoplay);
      autoplay = window.setInterval(() => {
        setActive(active + 1);
      }, AUTO_ADVANCE_MS + 1200);
    };

    cards.forEach((card, index) => {
      card.addEventListener('click', () => {
        if (index === active) return;
        setActive(index);
        restartAutoplay();
      });

      card.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          setActive(active + 1);
          restartAutoplay();
        }

        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          setActive(active - 1);
          restartAutoplay();
        }

        if (event.key !== 'Enter' && event.key !== ' ') return;
        if (index === active) return;
        event.preventDefault();
        setActive(index);
        restartAutoplay();
      });

      card.addEventListener('focus', () => window.clearInterval(autoplay));
      card.addEventListener('blur', startAutoplay);
    });

    syncCards();
    startAutoplay();
  })();
</script>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-bg__videos,
  .hero-bg__video {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
  }

  .hero-bg__video {
    object-fit: contain;
    object-position: center top;
    opacity: 0;
    animation: heroVideoCycle 24s linear infinite;
    height: 100%;
    width: 100%;
    filter: saturate(0.86) brightness(0.58);
    transform: none;
    background: #0b0f0d;
  }

  .hero-bg__video[data-video-index='1'] {
    animation-delay: 8s;
  }

  .hero-bg__video[data-video-index='2'] {
    animation-delay: 16s;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 36%, rgba(45, 106, 79, 0.2), transparent 42%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.46) 0%, rgba(0, 0, 0, 0.5) 46%, rgba(0, 0, 0, 0.84) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.64), rgba(0, 0, 0, 0.2) 48%, rgba(0, 0, 0, 0.64));
  }

  @keyframes heroVideoCycle {
    0% {
      opacity: 0;
    }

    4%,
    29% {
      opacity: 1;
    }

    33%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg__video {
      animation: none;
    }

    .hero-bg__video:first-child {
      opacity: 1;
    }
  }

  .homepage-hero .container {
    display: grid;
    align-content: center;
    justify-items: center;
    padding-bottom: clamp(21rem, 34vh, 26rem);
  }

  .hero-copy {
    position: relative;
    z-index: 5;
    width: 100%;
    transform: translateY(clamp(0px, 1vh, 16px));
  }

  .hero-heading {
    font-size: clamp(2.55rem, 4.2vw, 4.55rem);
    line-height: 1.04;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .hero-eyebrow {
    max-width: 100%;
  }

  .hero-line {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.75s var(--ease-premium), transform 0.95s var(--ease-premium);
  }

  .hero-line.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-showcase {
    position: absolute;
    left: 50%;
    bottom: clamp(3rem, 5.5vh, 5rem);
    z-index: 3;
    height: min(32vw, 430px);
    min-height: 330px;
    width: 100vw;
    flex: none;
    margin-top: 0;
    transform: translateX(-50%);
  }

  .hero-showcase__track {
    position: absolute;
    inset: 0;
    left: 50%;
    width: min(1520px, 100vw);
    transform: translateX(-50%);
  }

  .hero-preview-card {
    position: absolute;
    left: 50%;
    top: auto;
    bottom: 0;
    width: min(38vw, 650px);
    overflow: hidden;
    border-radius: 8px;
    background: #111;
    box-shadow: 0 34px 90px rgba(0, 0, 0, 0.48);
    opacity: 0;
    transform: translateX(-50%) scale(0.74);
    transition:
      transform 2s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 2s ease,
      filter 2s ease,
      box-shadow 0.35s var(--ease-standard);
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    cursor: pointer;
  }

  .hero-preview-card[data-position='0'] {
    z-index: 5;
    opacity: 1;
    filter: brightness(1);
    transform: translateX(-50%) translateY(0) rotate(0deg) scale(1);
    cursor: default;
  }

  .hero-preview-card:focus-visible {
    outline: 2px solid rgba(74, 222, 128, 0.9);
    outline-offset: 4px;
  }

  .hero-preview-card:not([data-position='0']):hover,
  .hero-preview-card:not([data-position='0']):focus-visible {
    opacity: 0.92;
    filter: brightness(0.92) saturate(1.05);
    box-shadow: 0 42px 110px rgba(0, 0, 0, 0.58), 0 0 0 1px rgba(74, 222, 128, 0.34);
  }

  .hero-preview-card[data-position='1'] {
    z-index: 4;
    opacity: 0.78;
    filter: brightness(0.78);
    transform: translateX(calc(-50% + min(46vw, 610px))) translateY(42px) rotate(3deg) scale(0.82);
  }

  .hero-preview-card[data-position='2'] {
    z-index: 2;
    opacity: 0;
    filter: brightness(0.62);
    transform: translateX(calc(-50% + min(82vw, 1080px))) translateY(118px) rotate(6deg) scale(0.68);
  }

  .hero-preview-card[data-position='3'] {
    z-index: 1;
    opacity: 0;
    filter: brightness(0.54);
    transform: translateX(calc(-50% + min(112vw, 1400px))) translateY(150px) rotate(8deg) scale(0.58);
  }

  .hero-preview-card[data-position='-1'] {
    z-index: 4;
    opacity: 0.72;
    filter: brightness(0.7);
    transform: translateX(calc(-50% - min(48vw, 650px))) translateY(62px) rotate(-8deg) scale(0.78);
  }

  .hero-preview-card[data-position='-2'] {
    z-index: 2;
    opacity: 0;
    filter: brightness(0.58);
    transform: translateX(calc(-50% - min(84vw, 1120px))) translateY(130px) rotate(-11deg) scale(0.64);
  }

  .hero-preview-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 36px;
    padding: 10px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero-preview-card img {
    display: block;
    aspect-ratio: 1586 / 992;
    width: 100%;
    object-fit: cover;
  }

  .hero-bottom {
    position: absolute;
    left: max(1rem, calc((100vw - min(1280px, calc(100vw - 2rem))) / 2));
    right: max(1rem, calc((100vw - min(1280px, calc(100vw - 2rem))) / 2));
    bottom: 22px;
    z-index: 6;
    display: flex;
    width: auto;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    border-top: 0;
    padding-top: 0;
  }

  .hero-frame-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: "DM Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.62);
  }

  .hero-frame-dot {
    height: 8px;
    width: 8px;
    border-radius: 999px;
    background: #4ade80;
    box-shadow: 0 0 0 6px rgba(74, 222, 128, 0.14);
  }

  @media (max-width: 1023px) {
    .homepage-hero .container {
      padding-bottom: clamp(18rem, 32vh, 21rem);
    }

    .hero-showcase {
      bottom: 2.75rem;
      height: 340px;
      min-height: 340px;
    }

    .hero-preview-card {
      width: min(62vw, 500px);
    }

    .hero-preview-card[data-position='1'] {
      transform: translateX(calc(-50% + min(54vw, 470px))) translateY(42px) rotate(4deg) scale(0.78);
    }

    .hero-preview-card[data-position='-1'] {
      transform: translateX(calc(-50% - min(55vw, 490px))) translateY(58px) rotate(-8deg) scale(0.76);
    }

  }

  @media (max-width: 767px) {
    .hero-bg__video {
      object-fit: cover;
      object-position: center top;
    }

    .homepage-hero .container {
      width: 100%;
      max-width: 100vw;
      padding-left: 16px;
      padding-right: 16px;
      padding-top: calc(var(--nav-height) + 22px);
      padding-bottom: 260px;
    }

    .hero-copy {
      transform: translateY(-18px);
    }

    .hero-eyebrow {
      gap: 8px 12px;
      width: min(100%, 330px);
      font-size: 9px;
      letter-spacing: 0.16em;
    }

    .hero-eyebrow .h-px {
      width: 22px;
    }

    .hero-heading {
      font-size: clamp(2.45rem, 11vw, 3.6rem);
      line-height: 1.04;
    }

    .homepage-hero p {
      max-width: calc(100vw - 32px);
      overflow-wrap: anywhere;
    }

    .hero-showcase {
      bottom: 26px;
      height: 250px;
      min-height: 250px;
    }

    .hero-preview-card {
      width: min(78vw, 320px);
    }

    .hero-preview-card[data-position='1'] {
      opacity: 0.72;
      transform: translateX(calc(-50% + 74vw)) translateY(34px) rotate(5deg) scale(0.78);
    }

    .hero-preview-card[data-position='2'] {
      opacity: 0;
      transform: translateX(calc(-50% + 118vw)) translateY(90px) rotate(8deg) scale(0.62);
    }

    .hero-preview-card[data-position='-1'] {
      opacity: 0.66;
      transform: translateX(calc(-50% - 76vw)) translateY(44px) rotate(-8deg) scale(0.76);
    }

    .hero-preview-card[data-position='-2'] {
      opacity: 0;
      transform: translateX(calc(-50% - 118vw)) translateY(96px) rotate(-10deg) scale(0.62);
    }

    .hero-preview-card__top {
      min-height: 30px;
      padding: 8px 11px;
      font-size: 8px;
      letter-spacing: 0.13em;
    }
  }
</style>
