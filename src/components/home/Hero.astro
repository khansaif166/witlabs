---
const heroFrames = [
  {
    src: '/images/case-studies/al-khair-hero.jpg',
    alt: 'Interior design website project by WitLabs',
    label: 'Brand website',
  },
  {
    src: '/images/case-studies/impact-packaging-hero.jpg',
    alt: 'Manufacturing website project by WitLabs',
    label: 'B2B growth',
  },
  {
    src: '/images/case-studies/kota-experts-hero.jpg',
    alt: 'Education website project by WitLabs',
    label: 'Local SEO',
  },
];
---

<section id="homepage-hero" class="homepage-hero relative min-h-[100svh] overflow-hidden bg-ink text-white">
  <div class="hero-media" aria-hidden="true">
    {heroFrames.map((frame, index) => (
      <div class:list={['hero-media__item', index === 0 && 'is-active']}>
        <img src={frame.src} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
    <div class="hero-media__shade"></div>
    <div class="hero-media__wash"></div>
  </div>

  <div class="container relative z-10 flex min-h-[100svh] flex-col justify-between pb-8 pt-[calc(var(--nav-height)+56px)] lg:pb-10 lg:pt-[calc(var(--nav-height)+96px)]">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,0.55fr)] lg:items-end">
      <div class="min-w-0">
        <div class="reveal flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[11px] uppercase tracking-[0.18em] text-white/58">
          <span>Digital Growth Agency</span>
          <span class="h-px w-8 bg-white/30" aria-hidden="true"></span>
          <span>India</span>
        </div>

        <h1 id="hero-heading" class="mt-8 max-w-[980px] display-tight text-[clamp(4.8rem,13vw,12.5rem)] font-semibold text-white">
          <span class="hero-line block">Build</span>
          <span class="hero-line block">systems</span>
          <span class="hero-line block text-white/45">that sell.</span>
        </h1>

        <div class="reveal reveal-delay-3 mt-8 w-full max-w-[calc(100vw-32px)] sm:max-w-2xl">
          <p class="text-[clamp(1.1rem,2.2vw,1.55rem)] leading-[1.35] text-white/72">
            WitLabs creates websites, SEO engines, marketing funnels, and automation systems for businesses that need more than a pretty homepage.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a class="premium-button premium-button-light" href="/contact/">Start a Project</a>
            <a class="premium-button premium-button-outline text-white" href="/case-studies/">See Our Work <span class="ml-2">→</span></a>
          </div>
        </div>
      </div>

      <aside class="hero-panel reveal reveal-delay-2 min-w-0 w-full max-w-[calc(100vw-32px)] lg:max-w-none">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/45">Live signal</p>
        <div class="mt-8 grid gap-6">
          <div>
            <p class="text-5xl font-semibold tracking-[-0.06em]">50+</p>
            <p class="mt-2 text-sm text-white/55">projects delivered across websites, campaigns, and systems.</p>
          </div>
          <div class="h-px bg-white/15"></div>
          <div>
            <p class="text-5xl font-semibold tracking-[-0.06em]">100%</p>
            <p class="mt-2 text-sm text-white/55">launch discipline, with QA and client approval before release.</p>
          </div>
        </div>
      </aside>
    </div>

    <div class="hero-bottom reveal reveal-delay-4">
      <div class="hero-frame-label">
        <span class="hero-frame-dot"></span>
        <span id="hero-frame-label">{heroFrames[0].label}</span>
      </div>
      <div class="hidden items-center gap-3 text-white/45 md:flex" aria-hidden="true">
        <span class="hero-scroll-line"><span></span></span>
        <span class="font-mono text-[10px] uppercase tracking-[0.26em]">Scroll</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const heading = document.getElementById('hero-heading');
    const lines = heading ? [...heading.querySelectorAll('.hero-line')] : [];
    const mediaItems = [...document.querySelectorAll('.hero-media__item')];
    const label = document.getElementById('hero-frame-label');
    const labels = ['Brand website', 'B2B growth', 'Local SEO'];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;

    lines.forEach((line, index) => {
      line.style.transitionDelay = `${index * 0.09 + 0.08}s`;
      requestAnimationFrame(() => line.classList.add('is-visible'));
    });

    if (reduced || mediaItems.length < 2) return;

    window.setInterval(() => {
      current = (current + 1) % mediaItems.length;
      mediaItems.forEach((item, index) => item.classList.toggle('is-active', index === current));
      if (label) label.textContent = labels[current] || labels[0];
    }, 4200);
  })();
</script>

<style>
  .hero-media,
  .hero-media__item,
  .hero-media__shade,
  .hero-media__wash {
    position: absolute;
    inset: 0;
  }

  .hero-media {
    overflow: hidden;
  }

  .hero-media__item {
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }

  .hero-media__item.is-active {
    opacity: 1;
  }

  .hero-media__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.04);
    transform: scale(1.04);
  }

  .hero-media__shade {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.52) 48%, rgba(0, 0, 0, 0.28) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0) 36%);
    z-index: 1;
  }

  .hero-media__wash {
    z-index: 2;
    background: radial-gradient(circle at 85% 18%, rgba(74, 222, 128, 0.18), transparent 34%);
  }

  .hero-line {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.75s var(--ease-premium), transform 0.95s var(--ease-premium);
  }

  .hero-line.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-panel {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background: rgba(10, 10, 10, 0.48);
    padding: 28px;
    backdrop-filter: blur(18px);
  }

  .hero-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding-top: 20px;
  }

  .hero-frame-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: "DM Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.55);
  }

  .hero-frame-dot {
    height: 8px;
    width: 8px;
    border-radius: 999px;
    background: #4ADE80;
    box-shadow: 0 0 0 6px rgba(74, 222, 128, 0.14);
  }

  .hero-scroll-line {
    position: relative;
    display: block;
    height: 44px;
    width: 1px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.18);
  }

  .hero-scroll-line span {
    position: absolute;
    left: 0;
    top: 0;
    height: 12px;
    width: 1px;
    background: #4ADE80;
    animation: heroScroll 1.8s var(--ease-standard) infinite;
  }

  @keyframes heroScroll {
    0% {
      transform: translateY(-12px);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: translateY(44px);
      opacity: 0;
    }
  }

  @media (max-width: 767px) {
    .homepage-hero .container {
      width: 100%;
      max-width: 100vw;
    }

    .homepage-hero h1,
    .homepage-hero p,
    .hero-panel {
      max-width: calc(100vw - 32px);
    }

    .homepage-hero h1 {
      font-size: clamp(4rem, 18vw, 5.1rem);
    }

    .homepage-hero p,
    .hero-panel p {
      overflow-wrap: anywhere;
    }

    .hero-panel {
      width: 100%;
      padding: 22px;
    }
  }
</style>
