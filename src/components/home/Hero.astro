---
const heroFrames = [
  {
    src: '/images/Design-1.png',
    alt: 'WitLabs website design concept with editorial layout and product storytelling.',
    label: 'Brand website',
  },
  {
    src: '/images/Design-2.png',
    alt: 'WitLabs landing page concept with a clean conversion-focused structure.',
    label: 'B2B growth',
  },
  {
    src: '/images/Design-3.png',
    alt: 'WitLabs premium website interface design shown in a browser mockup.',
    label: 'Growth systems',
  },
  {
    src: '/images/Design-4.png',
    alt: 'WitLabs website mockup with layered imagery and bold typography.',
    label: 'Visual identity',
  },
  {
    src: '/images/Design-5.png',
    alt: 'WitLabs service business website concept built for digital growth.',
    label: 'Local SEO',
  },
  {
    src: '/images/Design-6.png',
    alt: 'WitLabs website design preview showing another polished digital growth concept.',
    label: 'Launch ready',
  },
];

const getHeroPosition = (index: number) => {
  const offset = index % heroFrames.length;
  return offset > heroFrames.length / 2 ? offset - heroFrames.length : offset;
};
---

<section id="homepage-hero" class="homepage-hero relative min-h-[100svh] overflow-hidden bg-ink text-white">
  <div class="hero-bg" aria-hidden="true">
    <img src="/images/Design-3.png" alt="" loading="eager" />
  </div>

  <div class="container relative z-10 flex min-h-[100svh] flex-col items-center pb-8 pt-[calc(var(--nav-height)+34px)] text-center lg:pt-[calc(var(--nav-height)+38px)]">
    <div class="hero-copy reveal">
      <div class="mx-auto flex w-fit flex-wrap items-center justify-center gap-x-5 gap-y-2 font-mono text-[11px] uppercase tracking-[0.18em] text-white/70">
        <span>Digital Growth Agency</span>
        <span class="h-px w-8 bg-white/35" aria-hidden="true"></span>
        <span>India</span>
      </div>

      <h1 id="hero-heading" class="mx-auto mt-5 max-w-3xl display-tight text-[clamp(2.55rem,4.5vw,4.9rem)] font-semibold text-white">
        <span class="hero-line block">Build less.</span>
        <span class="hero-line block text-white/72">Sell more.</span>
      </h1>

      <div class="reveal reveal-delay-3 mt-6">
        <a class="premium-button premium-button-light" href="/contact/">Start a Project</a>
        <p class="mx-auto mt-4 max-w-xl text-[clamp(0.95rem,1.15vw,1.05rem)] leading-[1.5] text-white/76">
          Clear websites, sharper growth, smarter systems.
        </p>
      </div>
    </div>

    <div class="hero-showcase reveal reveal-delay-2" aria-label="WitLabs website design previews">
      <div class="hero-showcase__track" data-hero-carousel>
        {heroFrames.map((frame, index) => (
          <article
            class="hero-preview-card"
            data-hero-card
            data-hero-index={index}
            data-position={getHeroPosition(index)}
            tabindex={index === 0 ? '0' : '-1'}
            aria-label={`Show ${frame.label} preview`}
          >
            <div class="hero-preview-card__top">
              <span>{frame.label}</span>
              <span>WitLabs / {String(index + 1).padStart(2, '0')}</span>
            </div>
            <img src={frame.src} alt={frame.alt} loading={index < 2 ? 'eager' : 'lazy'} />
          </article>
        ))}
      </div>
    </div>

    <div class="hero-bottom reveal reveal-delay-4">
      <div class="hero-frame-label">
        <span class="hero-frame-dot"></span>
        <span id="hero-frame-label">{heroFrames[0].label}</span>
      </div>
      <a class="hidden font-mono text-[10px] uppercase tracking-[0.22em] text-white/55 transition-colors hover:text-white md:inline-flex" href="/case-studies/">
        See our work <span class="ml-2">→</span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const heading = document.getElementById('hero-heading');
    const lines = heading ? [...heading.querySelectorAll('.hero-line')] : [];
    const cards = [...document.querySelectorAll('[data-hero-card]')];
    const label = document.getElementById('hero-frame-label');
    const labels = ['Brand website', 'B2B growth', 'Growth systems', 'Visual identity', 'Local SEO', 'Launch ready'];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTO_ADVANCE_MS = 4000;
    let active = 0;
    let autoplay;

    lines.forEach((line, index) => {
      line.style.transitionDelay = `${index * 0.09 + 0.08}s`;
      requestAnimationFrame(() => line.classList.add('is-visible'));
    });

    const syncCards = () => {
      cards.forEach((card, index) => {
        const offset = (index - active + cards.length) % cards.length;
        const position = offset > cards.length / 2 ? offset - cards.length : offset;
        card.setAttribute('data-position', String(position));
        card.setAttribute('tabindex', Math.abs(position) <= 1 ? '0' : '-1');
        card.setAttribute('aria-current', position === 0 ? 'true' : 'false');
      });

      if (label) label.textContent = labels[active] || labels[0];
    };

    const setActive = (index) => {
      active = (index + cards.length) % cards.length;
      syncCards();
    };

    const startAutoplay = () => {
      if (reduced || cards.length < 2) return;
      window.clearInterval(autoplay);
      autoplay = window.setInterval(() => {
        setActive(active + 1);
      }, AUTO_ADVANCE_MS);
    };

    const restartAutoplay = () => {
      window.clearInterval(autoplay);
      autoplay = window.setInterval(() => {
        setActive(active + 1);
      }, AUTO_ADVANCE_MS + 1200);
    };

    cards.forEach((card, index) => {
      card.addEventListener('click', () => {
        if (index === active) return;
        setActive(index);
        restartAutoplay();
      });

      card.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          setActive(active + 1);
          restartAutoplay();
        }

        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          setActive(active - 1);
          restartAutoplay();
        }

        if (event.key !== 'Enter' && event.key !== ' ') return;
        if (index === active) return;
        event.preventDefault();
        setActive(index);
        restartAutoplay();
      });

      card.addEventListener('focus', () => window.clearInterval(autoplay));
      card.addEventListener('blur', startAutoplay);
    });

    syncCards();
    startAutoplay();
  })();
</script>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-bg img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    filter: blur(18px) saturate(0.8) brightness(0.7);
    transform: scale(1.1);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0.52) 34%, #000 85%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.56), rgba(0, 0, 0, 0.08) 48%, rgba(0, 0, 0, 0.56));
  }

  .hero-copy {
    position: relative;
    z-index: 5;
    width: 100%;
  }

  .hero-line {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.75s var(--ease-premium), transform 0.95s var(--ease-premium);
  }

  .hero-line.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-showcase {
    position: relative;
    z-index: 3;
    margin-top: clamp(1.4rem, 3vh, 3rem);
    min-height: min(45vw, 510px);
    width: 100vw;
    flex: 1 1 auto;
  }

  .hero-showcase__track {
    position: absolute;
    inset: 0;
    left: 50%;
    width: min(1520px, 100vw);
    transform: translateX(-50%);
  }

  .hero-preview-card {
    position: absolute;
    left: 50%;
    top: 0;
    width: min(46vw, 760px);
    overflow: hidden;
    border-radius: 8px;
    background: #111;
    box-shadow: 0 34px 90px rgba(0, 0, 0, 0.48);
    opacity: 0;
    transform: translateX(-50%) scale(0.74);
    transition:
      transform 2s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 2s ease,
      filter 2s ease,
      box-shadow 0.35s var(--ease-standard);
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    cursor: pointer;
  }

  .hero-preview-card[data-position='0'] {
    z-index: 5;
    opacity: 1;
    filter: brightness(1);
    transform: translateX(-50%) translateY(0) rotate(0deg) scale(1);
    cursor: default;
  }

  .hero-preview-card:focus-visible {
    outline: 2px solid rgba(74, 222, 128, 0.9);
    outline-offset: 4px;
  }

  .hero-preview-card:not([data-position='0']):hover,
  .hero-preview-card:not([data-position='0']):focus-visible {
    opacity: 0.92;
    filter: brightness(0.92) saturate(1.05);
    box-shadow: 0 42px 110px rgba(0, 0, 0, 0.58), 0 0 0 1px rgba(74, 222, 128, 0.34);
  }

  .hero-preview-card[data-position='1'] {
    z-index: 4;
    opacity: 0.78;
    filter: brightness(0.78);
    transform: translateX(calc(-50% + min(46vw, 610px))) translateY(42px) rotate(3deg) scale(0.82);
  }

  .hero-preview-card[data-position='2'] {
    z-index: 2;
    opacity: 0;
    filter: brightness(0.62);
    transform: translateX(calc(-50% + min(82vw, 1080px))) translateY(118px) rotate(6deg) scale(0.68);
  }

  .hero-preview-card[data-position='3'] {
    z-index: 1;
    opacity: 0;
    filter: brightness(0.54);
    transform: translateX(calc(-50% + min(112vw, 1400px))) translateY(150px) rotate(8deg) scale(0.58);
  }

  .hero-preview-card[data-position='-1'] {
    z-index: 4;
    opacity: 0.72;
    filter: brightness(0.7);
    transform: translateX(calc(-50% - min(48vw, 650px))) translateY(62px) rotate(-8deg) scale(0.78);
  }

  .hero-preview-card[data-position='-2'] {
    z-index: 2;
    opacity: 0;
    filter: brightness(0.58);
    transform: translateX(calc(-50% - min(84vw, 1120px))) translateY(130px) rotate(-11deg) scale(0.64);
  }

  .hero-preview-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 36px;
    padding: 10px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: "DM Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero-preview-card img {
    display: block;
    aspect-ratio: 1586 / 992;
    width: 100%;
    object-fit: cover;
  }

  .hero-bottom {
    position: relative;
    z-index: 6;
    display: flex;
    width: 100%;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding-top: 18px;
  }

  .hero-frame-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: "DM Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.62);
  }

  .hero-frame-dot {
    height: 8px;
    width: 8px;
    border-radius: 999px;
    background: #4ade80;
    box-shadow: 0 0 0 6px rgba(74, 222, 128, 0.14);
  }

  @media (max-width: 1023px) {
    .hero-showcase {
      min-height: 430px;
    }

    .hero-preview-card {
      width: min(68vw, 560px);
    }

    .hero-preview-card[data-position='1'] {
      transform: translateX(calc(-50% + min(54vw, 470px))) translateY(42px) rotate(4deg) scale(0.78);
    }

    .hero-preview-card[data-position='-1'] {
      transform: translateX(calc(-50% - min(55vw, 490px))) translateY(58px) rotate(-8deg) scale(0.76);
    }

  }

  @media (max-width: 767px) {
    .homepage-hero .container {
      width: 100%;
      max-width: 100vw;
      padding-left: 16px;
      padding-right: 16px;
      padding-top: calc(var(--nav-height) + 22px);
    }

    .homepage-hero h1 {
      font-size: clamp(2.65rem, 12vw, 3.7rem);
    }

    .homepage-hero p {
      max-width: calc(100vw - 32px);
      overflow-wrap: anywhere;
    }

    .hero-showcase {
      margin-top: 1.5rem;
      min-height: 360px;
    }

    .hero-preview-card {
      top: 0;
      width: min(84vw, 340px);
    }

    .hero-preview-card[data-position='1'] {
      opacity: 0.72;
      transform: translateX(calc(-50% + 74vw)) translateY(34px) rotate(5deg) scale(0.78);
    }

    .hero-preview-card[data-position='2'] {
      opacity: 0;
      transform: translateX(calc(-50% + 118vw)) translateY(90px) rotate(8deg) scale(0.62);
    }

    .hero-preview-card[data-position='-1'] {
      opacity: 0.66;
      transform: translateX(calc(-50% - 76vw)) translateY(44px) rotate(-8deg) scale(0.76);
    }

    .hero-preview-card[data-position='-2'] {
      opacity: 0;
      transform: translateX(calc(-50% - 118vw)) translateY(96px) rotate(-10deg) scale(0.62);
    }

    .hero-preview-card__top {
      min-height: 30px;
      padding: 8px 11px;
      font-size: 8px;
      letter-spacing: 0.13em;
    }
  }
</style>
