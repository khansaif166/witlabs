---
interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const pathname = Astro.url.pathname;

interface NavLink {
  label: string;
  href: string;
  menu?: 'services' | 'pricing';
}

const navLinks: NavLink[] = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/', menu: 'services' },
  { label: 'Pricing', href: '/pricing/', menu: 'pricing' },
  { label: 'About', href: '/about/' },
  { label: 'Insights', href: '/insights/' },
  { label: 'Contact', href: '/contact/' },
];

const serviceLinks = [
  { label: 'Website Design', href: '/services/#website-design', desc: 'Conversion-first sites for service brands' },
  { label: 'SEO & Organic Growth', href: '/services/#seo', desc: 'Rank where your customers search' },
  { label: 'Digital Marketing', href: '/services/#digital-marketing', desc: 'Campaigns that create demand' },
  { label: 'App Development', href: '/services/#app-development', desc: 'Mobile tools for real workflows' },
  { label: 'Automation & AI', href: '/services/#automation', desc: 'Systems that save founder hours' },
];

const pricingLinks = [
  { label: 'Website Pricing', href: '/pricing/#website-pricing', desc: 'Starter, Standard, and Premium website plans' },
  { label: 'Digital Marketing Plans', href: '/pricing/#marketing-pricing', desc: 'Ad management plans for leads and visibility' },
  { label: 'App Development Pricing', href: '/pricing/#app-pricing', desc: 'Dashboards, CRM, booking systems, and LMS builds' },
  { label: 'Digital Launch Package', href: '/pricing/#launch-package', desc: 'Website, setup, SEO, and marketing launch path' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  const normalizedHref = href.endsWith('/') ? href : `${href}/`;
  const normalizedPath = pathname.endsWith('/') ? pathname : `${pathname}/`;
  return normalizedPath.startsWith(normalizedHref);
}
---

<header
  id="site-header"
  class:list={[
    'fixed inset-x-0 top-0 z-50 text-cream',
    transparent ? 'is-transparent' : 'is-solid',
  ]}
  aria-label="Site header"
>
  <nav class="site-nav mx-auto flex h-[var(--nav-height)] max-w-[1440px] items-center justify-between px-4 sm:px-6 lg:px-10" aria-label="Main navigation">
    <a href="/" aria-label="WitLabs - Home" class="brand-mark group inline-flex items-center">
      <img class="brand-logo" src="/images/logo.png" alt="WitLabs" width="958" height="411" loading="eager" decoding="async" />
    </a>

    <ul class="hidden h-full items-center gap-8 lg:flex" role="list">
      {navLinks.map((link) => (
        <li class="h-full">
          <a
            href={link.href}
            class:list={[
              'nav-link flex h-full items-center gap-1.5 font-mono text-[11px] font-semibold uppercase tracking-[0.16em]',
              isActive(link.href) ? 'is-active' : '',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
            {...(link.menu ? { 'data-menu': link.menu } : {})}
          >
            {link.label}
            {link.menu && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="nav-caret" aria-hidden="true">
                <path d="M2.5 4L6 7.5L9.5 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden items-center gap-5 lg:flex">
      <a href="tel:+917984301015" class="link-underline font-mono text-[11px] uppercase tracking-[0.12em] text-current/65 hover:text-current">
        +91 79843 01015
      </a>
      <a href="/contact/" class="premium-button premium-button-light px-5 py-3 text-[12px]">
        Start a Project
      </a>
    </div>

    <button
      id="menu-toggle"
      class="menu-toggle lg:hidden"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
    </button>
  </nav>

  <div id="desktop-mega" class="desktop-mega hidden lg:flex" aria-hidden="true">
    <div class="mega-panel" data-panel="services">
      <div class="mega-links">
        <p class="mega-eyebrow">What We Build</p>
        <div class="mega-grid">
          {serviceLinks.map((service) => (
            <a href={service.href} class="mega-link">
              <span>
                <strong>{service.label}</strong>
                <small>{service.desc}</small>
              </span>
              <span class="mega-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
      <div class="mega-divider"></div>
      <a href="/services/" class="mega-spotlight">
        <span class="mega-eyebrow">Platform Style Delivery</span>
        <strong>Websites, growth systems, automation, and AI tools handled under one roof.</strong>
        <span class="arrow-link">Explore services <span class="arrow">→</span></span>
      </a>
    </div>

    <div class="mega-panel" data-panel="pricing">
      <div class="mega-links">
        <p class="mega-eyebrow">Transparent Packages</p>
        <div class="mega-grid">
          {pricingLinks.map((pricing) => (
            <a href={pricing.href} class="mega-link">
              <span>
                <strong>{pricing.label}</strong>
                <small>{pricing.desc}</small>
              </span>
              <span class="mega-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
      <div class="mega-divider"></div>
      <a href="/pricing/" class="mega-spotlight">
        <span class="mega-eyebrow">Plan With Clarity</span>
        <strong>Compare website, marketing, app, and launch packages before we scope the work.</strong>
        <span class="arrow-link">View pricing <span class="arrow">→</span></span>
      </a>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu lg:hidden" aria-hidden="true">
  <nav class="flex flex-1 flex-col justify-between" aria-label="Mobile navigation">
    <ul class="mobile-list" role="list">
      {navLinks.map((link, index) => (
        <li style={`--item-index:${index}`}>
          <a href={link.href} class="mobile-link">
            <span>{link.label}</span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mobile-contact">
      <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/40">Get in touch</p>
      <a href="tel:+917984301015" class="mt-3 block text-2xl font-semibold text-white">+91 79843 01015</a>
      <a href="/contact/" class="premium-button premium-button-light mt-6 w-full">Book a Strategy Call</a>
    </div>
  </nav>
</div>

<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    const mega = document.getElementById('desktop-mega');
    const navItems = [...document.querySelectorAll('.nav-link')];
    const menuLinks = [...document.querySelectorAll('[data-menu]')].filter((link) => link.dataset.menu);
    const panels = [...document.querySelectorAll('.mega-panel')];
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    let closeTimer;
    let isOpen = false;

    const setHeaderScrolled = () => {
      const scrollThreshold = header?.classList.contains('is-transparent') ? 96 : 24;
      header?.classList.toggle('scrolled', window.scrollY > scrollThreshold || isOpen);
    };

    const openMega = (name) => {
      window.clearTimeout(closeTimer);
      mega?.classList.add('is-active');
      mega?.setAttribute('aria-hidden', 'false');
      header?.classList.add('mega-open');
      menuLinks.forEach((link) => link.classList.toggle('is-menu-active', link.dataset.menu === name));
      panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.panel === name));
    };

    const closeMega = () => {
      menuLinks.forEach((link) => link.classList.remove('is-menu-active'));
      panels.forEach((panel) => panel.classList.remove('is-active'));
      mega?.classList.remove('is-active');
      mega?.setAttribute('aria-hidden', 'true');
      header?.classList.remove('mega-open');
    };

    menuLinks.forEach((link) => {
      link.addEventListener('mouseenter', () => openMega(link.dataset.menu));
      link.addEventListener('focus', () => openMega(link.dataset.menu));
    });

    navItems
      .filter((link) => !link.dataset.menu)
      .forEach((link) => {
        link.addEventListener('mouseenter', closeMega);
        link.addEventListener('focus', closeMega);
      });

    header?.addEventListener('mouseleave', () => {
      closeTimer = window.setTimeout(closeMega, 120);
    });

    header?.addEventListener('focusout', (event) => {
      const nextTarget = event.relatedTarget;
      if (!(nextTarget instanceof Node) || (!header.contains(nextTarget) && !mega?.contains(nextTarget))) {
        closeMega();
      }
    });

    panels.forEach((panel) => {
      panel.addEventListener('mouseenter', () => window.clearTimeout(closeTimer));
      panel.addEventListener('mouseleave', closeMega);
    });

    const setMobile = (open) => {
      isOpen = open;
      toggle?.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      mobileMenu?.classList.toggle('is-open', open);
      mobileMenu?.setAttribute('aria-hidden', String(!open));
      document.body.style.overflow = open ? 'hidden' : '';
      setHeaderScrolled();
    };

    toggle?.addEventListener('click', () => setMobile(!isOpen));
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMobile(false)));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMega();
        if (isOpen) setMobile(false);
      }
    });

    window.addEventListener('scroll', setHeaderScrolled, { passive: true });
    setHeaderScrolled();
  })();
</script>

<style>
  #site-header {
    transition: background-color 0.5s var(--ease-premium), color 0.5s var(--ease-premium), border-color 0.5s var(--ease-premium);
  }

  #site-header.is-transparent:not(.scrolled):not(.mega-open) {
    background: transparent;
    border-bottom: 1px solid transparent;
    color: #FFFFFF;
    backdrop-filter: none;
  }

  #site-header.is-solid {
    background: rgba(0, 0, 0, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    backdrop-filter: blur(18px);
  }

  #site-header.is-transparent.scrolled,
  #site-header.is-transparent.mega-open {
    background: rgba(0, 0, 0, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    backdrop-filter: blur(18px);
  }

  .brand-logo {
    display: block;
    height: 76px;
    width: auto;
    transition: filter 0.5s var(--ease-premium), opacity 0.3s var(--ease-standard);
  }

  .brand-mark:hover .brand-logo {
    opacity: 0.82;
  }

  #site-header.is-solid.scrolled .brand-logo,
  #site-header.is-solid.mega-open .brand-logo,
  #site-header.is-transparent .brand-logo {
    filter: none;
  }

  @media (max-width: 767px) {
    .brand-logo {
      height: 62px;
    }
  }

  .nav-link {
    position: relative;
    color: currentColor;
    opacity: 0.68;
    transition: opacity 0.3s var(--ease-standard), color 0.3s var(--ease-standard);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 22px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-standard);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.is-active,
  .nav-link.is-menu-active {
    opacity: 1;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.is-active::after,
  .nav-link.is-menu-active::after {
    transform: scaleX(1);
  }

  .nav-caret {
    transition: transform 0.5s var(--ease-premium);
  }

  .nav-link.is-menu-active .nav-caret {
    transform: rotateX(180deg);
  }

  .menu-toggle {
    position: relative;
    display: grid;
    height: 40px;
    width: 40px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
  }

  .menu-toggle span {
    position: absolute;
    height: 1.5px;
    width: 18px;
    background: currentColor;
    transition: rotate 0.25s var(--ease-premium), translate 0.25s var(--ease-premium), background-color 0.5s var(--ease-premium);
  }

  .menu-toggle span:first-child {
    translate: 0 -4px;
  }

  .menu-toggle span:last-child {
    translate: 0 4px;
  }

  .menu-toggle.is-open span:first-child {
    rotate: 45deg;
    translate: 0;
  }

  .menu-toggle.is-open span:last-child {
    rotate: -45deg;
    translate: 0;
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
  }

  .desktop-mega {
    pointer-events: none;
    position: absolute;
    top: var(--nav-height);
    left: 0;
    width: 100%;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease-standard), visibility 0.3s step-end;
  }

  .desktop-mega.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s var(--ease-standard), visibility 0.3s step-start;
  }

  .mega-panel {
    pointer-events: none;
    display: none;
    width: min(840px, calc(100vw - 80px));
    min-height: 312px;
    overflow: hidden;
    border-radius: 8px;
    background: #0F0F0F;
    color: #FFFFFF;
    box-shadow: 0 134px 80px rgba(0, 0, 0, 0.05), 0 60px 60px rgba(0, 0, 0, 0.09), 0 15px 33px rgba(0, 0, 0, 0.1);
    transform: translateY(16px) scale(0.98);
    transition: transform 0.6s var(--ease-premium);
  }

  .mega-panel.is-active {
    pointer-events: auto;
    display: grid;
    grid-template-columns: 1.5fr 1px 0.9fr;
    transform: translateY(0) scale(1);
  }

  .mega-links,
  .mega-spotlight {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.5s var(--ease-premium) 0.12s, transform 0.75s var(--ease-premium) 0.12s;
  }

  .mega-panel.is-active .mega-links,
  .mega-panel.is-active .mega-spotlight {
    opacity: 1;
    transform: translateY(0);
  }

  .mega-links {
    padding: 32px;
  }

  .mega-eyebrow {
    margin-bottom: 20px;
    color: rgba(255, 255, 255, 0.45);
    font-family: "DM Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .mega-grid {
    display: grid;
    gap: 8px;
  }

  .mega-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-radius: 6px;
    padding: 12px;
    transition: background-color 0.3s var(--ease-standard), color 0.3s var(--ease-standard);
  }

  .mega-link strong,
  .mega-spotlight strong {
    display: block;
    font-size: 15px;
    font-weight: 600;
  }

  .mega-link small {
    margin-top: 3px;
    display: block;
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    line-height: 1.4;
  }

  .mega-arrow {
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s var(--ease-standard), transform 0.3s var(--ease-standard);
  }

  .mega-link:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .mega-link:hover .mega-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .mega-divider {
    align-self: stretch;
    background: rgba(255, 255, 255, 0.14);
    transform: scaleY(0.8);
    transform-origin: top;
    transition: transform 0.75s var(--ease-premium) 0.22s;
  }

  .mega-panel.is-active .mega-divider {
    transform: scaleY(1);
  }

  .mega-spotlight {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px;
    background:
      linear-gradient(135deg, rgba(45, 106, 79, 0.42), rgba(74, 222, 128, 0.08)),
      #181818;
  }

  .mobile-menu {
    pointer-events: none;
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    background: #0F0F0F;
    padding: calc(var(--nav-height) + 32px) 24px 28px;
    color: #FFFFFF;
    visibility: hidden;
    animation: clipMenuOut 0.6s var(--ease-premium) forwards;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
    visibility: visible;
    animation: clipMenuIn 0.6s var(--ease-premium) forwards;
  }

  .mobile-list {
    display: grid;
    gap: 0;
  }

  .mobile-list li {
    opacity: 0;
    transform: translateX(24px);
    transition: opacity 0.55s var(--ease-premium), transform 0.65s var(--ease-premium);
    transition-delay: calc(0.08s * var(--item-index));
  }

  .mobile-menu.is-open .mobile-list li {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding: 18px 0;
    font-size: clamp(1.65rem, 8vw, 3rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .mobile-contact {
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding-top: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .desktop-mega,
    .mega-panel,
    .mega-links,
    .mega-spotlight,
    .mega-divider,
    .mobile-menu,
    .mobile-list li {
      animation: none;
      transform: none;
      transition: none;
    }
  }
</style>
