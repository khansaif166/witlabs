---
const services = [
  { label: 'Website Design', href: '/services/#website-design' },
  { label: 'App Development', href: '/services/#app-development' },
  { label: 'SEO & Growth', href: '/services/#seo' },
  { label: 'Digital Marketing', href: '/services/#digital-marketing' },
  { label: 'Branding & Identity', href: '/services/#branding' },
  { label: 'Automation', href: '/services/#automation' },
  { label: 'AI Chatbots', href: '/services/#chatbots' },
];

const companyLinks = [
  { label: 'About Us', href: '/about/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Case Studies', href: '/case-studies/' },
  { label: 'Insights', href: '/insights/' },
  { label: 'Contact', href: '/contact/' },
];

const socialLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/witlabs' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/witlabs' },
  { label: 'X', href: 'https://twitter.com/witlabs' },
];
---

<footer id="footer" class="footer bg-[#0F0F0F] px-4 pt-20 text-white sm:px-6 lg:px-8 lg:pt-28">
  <div class="mx-auto max-w-[1440px]">
    <div class="footer-top">
      <div>
        <a class="inline-flex items-center" href="/" aria-label="WitLabs home">
          <img class="footer-logo" src="/images/logo.png" alt="WitLabs" width="1916" height="821" loading="lazy" decoding="async" />
        </a>
      </div>

      <div class="footer-contact">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/42">Let's Talk</p>
        <a class="mt-5 block text-2xl font-semibold text-white" href="mailto:hello@witlabs.in">hello@witlabs.in</a>
        <a class="mt-2 block text-white/58 hover:text-white" href="tel:+917984301015">+91 79843 01015</a>
        <a
          class="premium-button premium-button-light mt-8 w-full"
          href="https://wa.me/917984301015?text=Hi%20WitLabs%2C%20I%20visited%20your%20website%20and%20I%27d%20like%20to%20discuss%20a%20project."
          target="_blank"
          rel="noreferrer"
        >
          Message on WhatsApp
        </a>
      </div>
    </div>

    <div class="footer-links">
      <div class="footer-group">
        <button class="footer-group__button" type="button" aria-expanded="true">
          <span>Services</span>
          <span aria-hidden="true">↓</span>
        </button>
        <ul class="footer-group__list">
          {services.map((service) => <li><a href={service.href}>{service.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-group">
        <button class="footer-group__button" type="button" aria-expanded="true">
          <span>Company</span>
          <span aria-hidden="true">↓</span>
        </button>
        <ul class="footer-group__list">
          {companyLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-group">
        <button class="footer-group__button" type="button" aria-expanded="true">
          <span>Follow</span>
          <span aria-hidden="true">↓</span>
        </button>
        <ul class="footer-group__list">
          {socialLinks.map((social) => (
            <li><a href={social.href} target="_blank" rel="noreferrer">{social.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>Built in India / WitLabs 2024</p>
      <div>
        <a href="/privacy-policy/">Privacy Policy</a>
        <span aria-hidden="true">/</span>
        <a href="/terms-and-conditions/">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const groups = [...document.querySelectorAll('.footer-group')];
    const isDesktop = () => window.matchMedia('(min-width: 900px)').matches;

    groups.forEach((group) => {
      const button = group.querySelector('.footer-group__button');
      button?.addEventListener('click', () => {
        if (isDesktop()) return;
        const open = !group.classList.contains('is-open');
        group.classList.toggle('is-open', open);
        button.setAttribute('aria-expanded', String(open));
      });
      group.classList.add('is-open');
    });
  })();
</script>

<style>
  .footer-top {
    display: grid;
    gap: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding-bottom: 52px;
  }

  .footer-logo {
    display: block;
    height: 104px;
    width: auto;
  }

  @media (max-width: 767px) {
    .footer-logo {
      height: 72px;
    }
  }

  .footer-contact {
    align-self: end;
  }

  .footer-links {
    display: grid;
    gap: 0;
    padding: 24px 0;
  }

  .footer-group {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .footer-group__button {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    color: #FFFFFF;
    font-family: "DM Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .footer-group__button span:last-child {
    transition: transform 0.3s var(--ease-standard);
  }

  .footer-group.is-open .footer-group__button span:last-child {
    transform: rotate(180deg);
  }

  .footer-group__list {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s var(--ease-premium), padding-bottom 0.35s var(--ease-premium);
  }

  .footer-group.is-open .footer-group__list {
    max-height: 420px;
    padding-bottom: 18px;
  }

  .footer-group__list a {
    display: inline-block;
    padding: 6px 0;
    color: rgba(255, 255, 255, 0.52);
    font-size: 14px;
    transition: color 0.3s var(--ease-standard);
  }

  .footer-group__list a:hover {
    color: #FFFFFF;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 0 32px;
    color: rgba(255, 255, 255, 0.42);
    font-size: 13px;
  }

  .footer-bottom div {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .footer-bottom a:hover {
    color: #FFFFFF;
  }

  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.45fr);
      padding-bottom: 72px;
    }

    .footer-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
      padding: 48px 0;
    }

    .footer-group {
      border-bottom: 0;
    }

    .footer-group__button {
      pointer-events: none;
      padding-top: 0;
    }

    .footer-group__button span:last-child {
      display: none;
    }

    .footer-group__list,
    .footer-group.is-open .footer-group__list {
      display: block;
      max-height: none;
      overflow: visible;
      padding-bottom: 0;
    }

    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
